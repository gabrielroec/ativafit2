<script>
  (function() {
    class ProductPromo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.tabs = this.querySelectorAll('.ai-product-promo-tab-{{ ai_gen_id }}');
        this.tabContents = this.querySelectorAll('.ai-product-promo-tab-content-{{ ai_gen_id }}');
        this.carousels = this.querySelectorAll('.ai-product-promo-carousel-track-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupTabs();
        this.setupProgressBars();
      }

      setupTabs() {
        this.tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const targetTab = tab.getAttribute('data-tab');
            
            this.tabs.forEach(t => t.classList.remove('active'));
            this.tabContents.forEach(content => content.classList.remove('active'));
            
            tab.classList.add('active');
            const targetContent = this.querySelector(`[data-content="${targetTab}"]`);
            if (targetContent) {
              targetContent.classList.add('active');
            }
          });
        });
      }

      setupProgressBars() {
        this.carousels.forEach(carousel => {
          const carouselId = carousel.getAttribute('data-carousel');
          const progressFill = this.querySelector(`[data-progress="${carouselId}"]`);
          
          if (progressFill) {
            const updateProgress = () => {
              const scrollLeft = carousel.scrollLeft;
              const scrollWidth = carousel.scrollWidth;
              const clientWidth = carousel.clientWidth;
              const maxScroll = scrollWidth - clientWidth;
              
              if (maxScroll > 0) {
                const progress = (scrollLeft / maxScroll) * 100;
                progressFill.style.width = progress + '%';
              } else {
                progressFill.style.width = '100%';
              }
            };

            carousel.addEventListener('scroll', updateProgress);
            updateProgress();
          }
        });
      }
    }

    customElements.define('product-promo-{{ ai_gen_id }}', ProductPromo{{ ai_gen_id }});
  })();
</script>

