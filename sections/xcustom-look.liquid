{% liquid
  assign look_id = 'XCustomLook-' | append: section.id

  assign desktop_room_image = section.settings.image
  if desktop_room_image == blank and section.settings.mobile_image != blank
    assign desktop_room_image = section.settings.mobile_image
  endif

  assign room_image = desktop_room_image

  assign room_alt = room_image.alt
  if room_alt == blank
    assign room_alt = section.settings.heading | strip_html
  endif

  assign mobile_room_alt = section.settings.mobile_image.alt
  if mobile_room_alt == blank
    assign mobile_room_alt = room_alt
  endif

  assign width_class = 'xcustom-look--contained'
  if section.settings.full_width
    assign width_class = 'xcustom-look--full'
  endif

  assign scene_image_size_mode = section.settings.scene_image_size_mode | default: 'adapt'
  assign product_image_size_mode = section.settings.product_image_size_mode | default: 'adapt'
%}

<section
  id="{{ look_id }}"
  class="xcustom-look {{ width_class }} xcustom-look--scene-{{ scene_image_size_mode }} xcustom-look--product-image-{{ product_image_size_mode }}{% if section.settings.mobile_image != blank %} xcustom-look--has-mobile-image{% endif %}"
>
  <div class="xcustom-look__container">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <header class="xcustom-look__header">

        {% if section.settings.heading != blank %}
          <{{ section.settings.heading_tag }} class="xcustom-look__heading">
            {{ section.settings.heading }}
          </{{ section.settings.heading_tag }}>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="xcustom-look__description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </header>
    {% endif %}

    <div class="xcustom-look__layout">
      <div class="xcustom-look__scene">
        <div class="xcustom-look__scene-media">
          {% if room_image != blank %}
            {{
              room_image
              | image_url: width: 2200
              | image_tag:
                widths: '550, 750, 960, 1200, 1500, 1800, 2200',
                sizes: '(min-width: 990px) 68vw, 100vw',
                class: 'xcustom-look__scene-image xcustom-look__scene-image--desktop',
                loading: 'lazy',
                alt: room_alt
            }}

            {% if section.settings.mobile_image != blank %}
              {{
                section.settings.mobile_image
                | image_url: width: 1200
                | image_tag:
                  widths: '375, 550, 750, 900, 1200',
                  sizes: '100vw',
                  class: 'xcustom-look__scene-image xcustom-look__scene-image--mobile',
                  loading: 'lazy',
                  alt: mobile_room_alt
              }}
            {% endif %}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'xcustom-look__scene-placeholder' }}
          {% endif %}

          {% if section.settings.scene_label != blank %}
            <div class="xcustom-look__scene-label">
              {{ section.settings.scene_label | escape }}
            </div>
          {% endif %}

          {% for block in section.blocks %}
            {% liquid
              assign hotspot_product = block.settings.product
              assign hotspot_title = block.settings.custom_title | strip

              if hotspot_title == blank and hotspot_product != blank
                assign hotspot_title = hotspot_product.title
              endif

              if hotspot_title == blank
                assign hotspot_title = 'Product ' | append: forloop.index
              endif
            %}

            <button
              type="button"
              class="xcustom-look__marker{% if forloop.first %} is-active{% endif %}"
              style="
                --marker-x: {{ block.settings.x_position }}%;
                --marker-y: {{ block.settings.y_position }}%;
                --marker-mobile-x: {{ block.settings.mobile_x_position }}%;
                --marker-mobile-y: {{ block.settings.mobile_y_position }}%;
              "
              data-look-marker
              data-look-target="{{ block.id }}"
              aria-label="Show {{ hotspot_title | escape }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="xcustom-look__marker-ring">
                <span class="xcustom-look__marker-plus" aria-hidden="true"></span>

                <svg
                  class="xcustom-look__marker-check"
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M3.5 8.2 6.6 11l5.9-6.2"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </button>
          {% endfor %}
        </div>
      </div>

      <aside class="xcustom-look__panel">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% liquid
              assign card_product = block.settings.product
              assign card_variant = blank
              assign card_title = block.settings.custom_title | strip
              assign card_description = block.settings.description
              assign card_image = block.settings.custom_image

              if card_product != blank
                assign card_variant = card_product.selected_or_first_available_variant

                if card_title == blank
                  assign card_title = card_product.title
                endif

                if card_description == blank
                  assign card_description = card_product.description | strip_html | truncate: 180
                endif

                if card_image == blank
                  assign card_image = card_variant.image | default: card_product.featured_image
                endif
              endif

              if card_title == blank
                assign card_title = 'Select a product'
              endif

              assign card_alt = card_image.alt
              if card_alt == blank
                assign card_alt = card_title
              endif
            %}

            <div
              class="xcustom-look__product-card{% if forloop.first %} is-active{% endif %}"
              data-look-card="{{ block.id }}"
              {% unless forloop.first %}hidden{% endunless %}
            >
              <div class="xcustom-look__product-top">
                {% if section.settings.panel_eyebrow != blank %}
                  <div class="xcustom-look__panel-eyebrow">
                    {{ section.settings.panel_eyebrow | escape }}
                  </div>
                {% endif %}

                {% if block.settings.badge != blank %}
                  <div class="xcustom-look__product-badge">
                    {{ block.settings.badge | escape }}
                  </div>
                {% endif %}
              </div>

              {% if card_image != blank %}
                <div class="xcustom-look__product-media">
                  {{
                    card_image
                    | image_url: width: 900
                    | image_tag:
                      widths: '300, 450, 600, 750, 900',
                      sizes: '(min-width: 990px) 380px, 100vw',
                      class: 'xcustom-look__product-image',
                      loading: 'lazy',
                      alt: card_alt
                  }}
                </div>
              {% endif %}

              <div class="xcustom-look__product-content">
                <h3 class="xcustom-look__product-title">
                  {{ card_title | escape }}
                </h3>

                {% if card_description != blank %}
                  <div class="xcustom-look__product-description">
                    {{ card_description }}
                  </div>
                {% endif %}

                {% if card_variant != blank %}
                  <div class="xcustom-look__product-pricing">
                    <div class="xcustom-look__product-price-group">
                      {% if card_variant.compare_at_price > card_variant.price %}
                        <span class="xcustom-look__product-compare">
                          {{ card_variant.compare_at_price | money }}
                        </span>
                      {% endif %}

                      <span class="xcustom-look__product-price">
                        {{ card_variant.price | money }}
                      </span>
                    </div>

                    {% if card_variant.compare_at_price > card_variant.price %}
                      {% assign saving_amount = card_variant.compare_at_price | minus: card_variant.price %}

                      <span class="xcustom-look__product-saving">
                        Save {{ saving_amount | money }}
                      </span>
                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.note != blank %}
                  <div class="xcustom-look__product-note">
                    {{ block.settings.note | escape }}
                  </div>
                {% endif %}
              </div>

              <div class="xcustom-look__product-footer">
                <div class="xcustom-look__product-actions">
                  {% if card_product != blank %}
                    <a
                      class="xcustom-look__product-button xcustom-look__product-button--view"
                      href="{{ card_product.url }}"
                    >
                      {{ block.settings.button_label | default: section.settings.default_button_label | escape }}
                    </a>

                    {% if card_variant != blank and card_variant.available %}
                      <button
                        type="button"
                        class="xcustom-look__product-button xcustom-look__product-button--add"
                        data-look-add-to-cart
                        data-variant-id="{{ card_variant.id }}"
                        data-default-label="{{ block.settings.add_button_label | default: section.settings.default_add_button_label | escape }}"
                        data-loading-label="{{ section.settings.adding_button_label | escape }}"
                        data-success-label="{{ section.settings.added_button_label | escape }}"
                        data-error-label="{{ section.settings.add_error_label | escape }}"
                      >
                        <span data-look-add-text>
                          {{ block.settings.add_button_label | default: section.settings.default_add_button_label | escape }}
                        </span>
                      </button>
                    {% else %}
                      <button
                        type="button"
                        class="xcustom-look__product-button xcustom-look__product-button--add xcustom-look__product-button--disabled"
                        disabled
                        aria-disabled="true"
                      >
                        {{ section.settings.sold_out_button_label | escape }}
                      </button>
                    {% endif %}
                  {% else %}
                    <span
                      class="xcustom-look__product-button xcustom-look__product-button--view xcustom-look__product-button--disabled"
                      aria-disabled="true"
                    >
                      {{ block.settings.button_label | default: section.settings.default_button_label | escape }}
                    </span>

                    <span
                      class="xcustom-look__product-button xcustom-look__product-button--add xcustom-look__product-button--disabled"
                      aria-disabled="true"
                    >
                      {{ section.settings.default_add_button_label | escape }}
                    </span>
                  {% endif %}
                </div>

                <div
                  class="xcustom-look__product-message"
                  data-look-add-message
                  role="status"
                  aria-live="polite"
                ></div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="xcustom-look__empty">
            Add hotspot blocks and select products to build this section.
          </div>
        {% endif %}
      </aside>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  #{{ look_id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding:
      {{ section.settings.padding_top }}px
      0
      {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  #{{ look_id }},
  #{{ look_id }} *,
  #{{ look_id }} *::before,
  #{{ look_id }} *::after {
    box-sizing: border-box;
  }

  #{{ look_id }} .xcustom-look__container {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    padding-right: {{ section.settings.side_padding }}px;
    padding-left: {{ section.settings.side_padding }}px;
  }

  #{{ look_id }}.xcustom-look--contained .xcustom-look__container {
    max-width: {{ section.settings.content_max_width }}px;
  }

  #{{ look_id }}.xcustom-look--full .xcustom-look__container {
    max-width: none;
  }

  #{{ look_id }} .xcustom-look__header {
    width: 100%;
    max-width: {{ section.settings.header_max_width }}px;
    margin-right: auto;
    margin-left: auto;
    text-align: {{ section.settings.header_alignment }};
  }

  #{{ look_id }} .xcustom-look__heading {
    width: 100%;
    margin: 0;
    padding: 0;
    color: {{ section.settings.heading_color }};
    font-family: inherit;
    font-size: {{ section.settings.heading_size }}px!important;
    font-weight: 900;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
  }

  #{{ look_id }} .xcustom-look__description {
    width: 100%;
    margin-top: {{ section.settings.description_gap }}px;
    color: {{ section.settings.description_color }};
  }

  #{{ look_id }} .xcustom-look__description,
  #{{ look_id }} .xcustom-look__description p,
  #{{ look_id }} .xcustom-look__description span,
  #{{ look_id }} .xcustom-look__description a {
    color: inherit;
    font-family: inherit;
    font-size: {{ section.settings.description_size }}px;
    line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
  }

  #{{ look_id }} .xcustom-look__description > *:first-child {
    margin-top: 0;
  }

  #{{ look_id }} .xcustom-look__description > *:last-child {
    margin-bottom: 0;
  }

  #{{ look_id }} .xcustom-look__layout {
    display: grid;
    grid-template-columns:
      minmax(0, {{ section.settings.scene_width }}fr)
      minmax(320px, {{ section.settings.panel_width }}fr);
    align-items: start;
    gap: {{ section.settings.column_gap }}px;
    width: 100%;
    margin-top: {{ section.settings.content_top_gap }}px;
  }

  #{{ look_id }} .xcustom-look__scene {
    min-width: 0;
    height: auto;
  }

  #{{ look_id }} .xcustom-look__scene-media {
    position: relative;
    width: 100%;
    height: auto;
    min-height: 0;
    overflow: hidden;
    border-radius: {{ section.settings.scene_radius }}px;
    background-color: #eeeeee;
    line-height: 0;
  }

  #{{ look_id }} .xcustom-look__scene-image,
  #{{ look_id }} .xcustom-look__scene-placeholder {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    min-height: 0;
  }

  #{{ look_id }} .xcustom-look__scene-image {
    object-fit: contain;
  }

  #{{ look_id }} .xcustom-look__scene-image--mobile {
    display: none;
  }

  #{{ look_id }}.xcustom-look--scene-cover .xcustom-look__layout {
    align-items: stretch;
  }

  #{{ look_id }}.xcustom-look--scene-cover .xcustom-look__scene {
    height: 100%;
  }

  #{{ look_id }}.xcustom-look--scene-cover .xcustom-look__scene-media {
    height: 100%;
    min-height: {{ section.settings.scene_min_height }}px;
  }

  #{{ look_id }}.xcustom-look--scene-cover .xcustom-look__scene-image,
  #{{ look_id }}.xcustom-look--scene-cover .xcustom-look__scene-placeholder {
    height: 100%;
    min-height: inherit;
    object-fit: cover;
  }

  #{{ look_id }} .xcustom-look__scene-placeholder {
    background-color: #eeeeee;
  }

  #{{ look_id }} .xcustom-look__scene-label {
    position: absolute;
    top: {{ section.settings.scene_label_offset }}px;
    left: {{ section.settings.scene_label_offset }}px;
    z-index: 3;
    max-width: calc(100% - 40px);
    padding: 10px 16px;
    border-radius: 999px;
    color: {{ section.settings.scene_label_text }};
    background-color: {{ section.settings.scene_label_background }};
    font-size: {{ section.settings.scene_label_size }}px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  #{{ look_id }} .xcustom-look__marker {
    position: absolute;
    top: var(--marker-y);
    left: var(--marker-x);
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.marker_click_area }}px;
    height: {{ section.settings.marker_click_area }}px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    transform: translate(-50%, -50%);
  }

  #{{ look_id }} .xcustom-look__marker-ring {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.marker_size }}px;
    height: {{ section.settings.marker_size }}px;
    border: {{ section.settings.marker_border_width }}px solid {{ section.settings.accent_color }};
    border-radius: 50%;
    color: {{ section.settings.marker_plus_color }};
    background-color: {{ section.settings.marker_background }};
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  #{{ look_id }} .xcustom-look__marker:hover .xcustom-look__marker-ring {
    transform: scale(1.08);
  }

  #{{ look_id }} .xcustom-look__marker:focus-visible {
    outline: none;
  }

  #{{ look_id }} .xcustom-look__marker:focus-visible .xcustom-look__marker-ring {
    outline: 3px solid {{ section.settings.marker_background }};
    outline-offset: 3px;
  }

  #{{ look_id }} .xcustom-look__marker-plus {
    position: relative;
    display: block;
    width: 14px;
    height: 14px;
  }

  #{{ look_id }} .xcustom-look__marker-plus::before,
  #{{ look_id }} .xcustom-look__marker-plus::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 2px;
    background-color: currentColor;
    transform: translate(-50%, -50%);
  }

  #{{ look_id }} .xcustom-look__marker-plus::before {
    width: 14px;
    height: 2px;
  }

  #{{ look_id }} .xcustom-look__marker-plus::after {
    width: 2px;
    height: 14px;
  }

  #{{ look_id }} .xcustom-look__marker-check {
    display: none;
  }

  #{{ look_id }} .xcustom-look__marker.is-active .xcustom-look__marker-ring {
    color: {{ section.settings.active_marker_icon }};
    background-color: {{ section.settings.accent_color }};
    border-color: {{ section.settings.marker_background }};
  }

  #{{ look_id }} .xcustom-look__marker.is-active .xcustom-look__marker-plus {
    display: none;
  }

  #{{ look_id }} .xcustom-look__marker.is-active .xcustom-look__marker-check {
    display: block;
  }

  #{{ look_id }} .xcustom-look__panel {
    display: flex;
    min-width: 0;
    height: auto;
    overflow: hidden;
    border-radius: {{ section.settings.panel_radius }}px;
    color: {{ section.settings.panel_text_color }};
    background-color: {{ section.settings.panel_background }};
  }

  #{{ look_id }} .xcustom-look__product-card {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    width: 100%;
    height: auto;
    min-height: 0;
    padding:
      {{ section.settings.panel_padding_top }}px
      {{ section.settings.panel_padding_horizontal }}px
      {{ section.settings.panel_padding_bottom }}px;
  }

  #{{ look_id }}.xcustom-look--scene-cover .xcustom-look__panel {
    height: 100%;
  }

  #{{ look_id }}.xcustom-look--scene-cover .xcustom-look__product-card {
    height: 100%;
    min-height: 100%;
  }

  #{{ look_id }} .xcustom-look__product-card[hidden] {
    display: none;
  }

  #{{ look_id }} .xcustom-look__product-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  #{{ look_id }} .xcustom-look__panel-eyebrow {
    color: {{ section.settings.accent_color }};
    font-size: {{ section.settings.panel_eyebrow_size }}px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ look_id }} .xcustom-look__product-badge {
    padding: 5px 10px;
    border-radius: 999px;
    color: {{ section.settings.badge_text_color }};
    background-color: {{ section.settings.badge_background }};
    font-size: 10px;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }

  #{{ look_id }} .xcustom-look__product-media {
    width: 100%;
    margin-top: 24px;
    overflow: hidden;
    border-radius: {{ section.settings.product_image_radius }}px;
    background-color: {{ section.settings.product_image_background }};
  }

  #{{ look_id }} .xcustom-look__product-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  #{{ look_id }}.xcustom-look--product-image-ratio .xcustom-look__product-media {
    aspect-ratio: {{ section.settings.product_image_ratio }};
  }

  #{{ look_id }}.xcustom-look--product-image-ratio .xcustom-look__product-image {
    height: 100%;
  }

  #{{ look_id }} .xcustom-look__product-content {
    width: 100%;
    margin-top: 24px;
  }

  #{{ look_id }} .xcustom-look__product-title {
    width: 100%;
    margin: 0;
    color: {{ section.settings.panel_heading_color }};
    font-family: inherit;
    font-size: {{ section.settings.product_title_size }}px;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    overflow-wrap: break-word;
  }

  #{{ look_id }} .xcustom-look__product-description {
    margin-top: 14px;
    color: {{ section.settings.panel_text_color }};
    font-family: inherit;
    font-size: {{ section.settings.product_description_size }}px;
    line-height: 1.5;
  }

  #{{ look_id }} .xcustom-look__product-description p {
    margin: 0;
    color: inherit;
    font: inherit;
  }

  #{{ look_id }} .xcustom-look__product-pricing {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid {{ section.settings.panel_divider_color }};
  }

  #{{ look_id }} .xcustom-look__product-price-group {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 9px;
  }

  #{{ look_id }} .xcustom-look__product-compare {
    color: {{ section.settings.panel_muted_color }};
    font-size: 13px;
    line-height: 1.2;
    text-decoration: line-through;
  }

  #{{ look_id }} .xcustom-look__product-price {
    color: {{ section.settings.panel_heading_color }};
    font-size: {{ section.settings.product_price_size }}px;
    font-weight: 700;
    line-height: 1;
  }

  #{{ look_id }} .xcustom-look__product-saving {
    color: {{ section.settings.accent_color }};
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
  }

  #{{ look_id }} .xcustom-look__product-note {
    margin-top: 12px;
    color: {{ section.settings.panel_muted_color }};
    font-size: 12px;
    line-height: 1.4;
  }

  #{{ look_id }} .xcustom-look__product-footer {
    width: 100%;
    margin-top: auto;
    padding-top: 28px;
  }

  #{{ look_id }} .xcustom-look__product-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
  }

  #{{ look_id }} .xcustom-look__product-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: {{ section.settings.button_height }}px;
    padding: 10px 16px;
    border: 1px solid {{ section.settings.accent_color }};
    border-radius: {{ section.settings.button_radius }}px;
    font-family: inherit;
    font-size: {{ section.settings.button_text_size }}px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    appearance: none;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
  }

  #{{ look_id }} .xcustom-look__product-button--view {
    color: {{ section.settings.accent_color }};
    background-color: transparent;
  }

  #{{ look_id }} .xcustom-look__product-button--add {
