      "step": 1,
      "label": "Product panel width ratio",
      "default": 2
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Desktop column gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "min": 8,
      "max": 40,
      "step": 2,
