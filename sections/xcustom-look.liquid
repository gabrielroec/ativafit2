<script>
  (() => {
    const sectionId = {{ section.id | json }};
    const rootId = 'XCustomLook-' + sectionId;

    function getRootPath() {
      return window.Shopify?.routes?.root || '/';
    }

    function getCartApi() {
      if (window.AfitCartApi) {
        return window.AfitCartApi;
      }

      return {
        invalidate() {},
        async fetchCart() {
          const response = await fetch(`${getRootPath()}cart.js`, {
            method: 'GET',
            headers: { Accept: 'application/json' },
            credentials: 'same-origin',
            cache: 'no-store'
          });

          if (!response.ok) {
            throw new Error('Cart fetch failed');
          }

          return response.json();
        }
      };
    }

    async function fetchCart() {
      const cartApi = getCartApi();

      if (typeof cartApi.fetchCart === 'function') {
        try {
          return await cartApi.fetchCart({ force: true });
        } catch (error) {
          console.warn('[XCustom Look] AfitCartApi fetch failed, falling back to /cart.js:', error);
        }
      }

      const response = await fetch(`${getRootPath()}cart.js`, {
        method: 'GET',
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
        cache: 'no-store'
      });

      if (!response.ok) {
        return null;
      }

      return response.json();
    }

    function formatMoney(cents) {
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        return window.Shopify.formatMoney(cents);
      }

      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: {{ cart.currency.iso_code | default: shop.currency | json }}
      }).format((Number(cents) || 0) / 100);
    }

    function updateCartCount(itemCount) {
      if (!Number.isFinite(itemCount)) {
        return;
      }

      const countElements = document.querySelectorAll(
        '.cart-count, [data-cart-count], .header__cart-count, .cart-count-bubble span[aria-hidden="true"], .cart-count-bubble span:not(.visually-hidden)'
      );

      countElements.forEach((element) => {
        element.textContent = itemCount;
        element.hidden = false;
        element.removeAttribute('hidden');
        element.classList.toggle('hidden', itemCount === 0);
      });
    }

    function updateCartSubtotal(cart) {
      if (!cart || !Number.isFinite(cart.total_price)) {
        return;
      }

      const subtotalElements = document.querySelectorAll('[data-cart-subtotal]');
      subtotalElements.forEach((element) => {
        element.textContent = formatMoney(cart.total_price);
      });
    }

    function getCartDrawerSectionId() {
      const cartDrawerItems = document.getElementById('CartDrawer-Items');
      return cartDrawerItems?.dataset.id || 'cart-drawer';
    }

    function getCartDrawerSectionHtml(sections, preferredSectionId) {
      if (!sections || typeof sections !== 'object') {
        return '';
      }

      const fallbackIds = [
        preferredSectionId,
        getCartDrawerSectionId(),
        'cart-drawer'
      ].filter(Boolean);

      for (const id of fallbackIds) {
        if (sections[id]) {
          return sections[id];
        }
      }

      const firstSection = Object.values(sections).find((value) => typeof value === 'string' && value.trim() !== '');
      return firstSection || '';
    }

    function rebindCartDrawerCloseButtons() {
      const cartDrawer = document.querySelector('cart-drawer');
      if (!cartDrawer) {
        return;
      }

      cartDrawer.querySelectorAll('[data-close-drawer]').forEach((button) => {
        if (button.dataset.xcustomLookCloseBound === 'true') {
          return;
        }

        button.dataset.xcustomLookCloseBound = 'true';
        button.addEventListener('click', () => {
          if (typeof cartDrawer.close === 'function') {
            cartDrawer.close();
          } else {
            cartDrawer.classList.remove('is-open');
            document.body.classList.remove('cart-drawer-open');
          }
        });
      });
    }

    function replaceDrawerHtml(sectionContent) {
      if (!sectionContent) {
        return false;
      }

      const parser = new DOMParser();
      const doc = parser.parseFromString(sectionContent, 'text/html');

      const currentDrawer = document.querySelector('cart-drawer');
      const newDrawer = doc.querySelector('cart-drawer');

      if (currentDrawer && newDrawer) {
        currentDrawer.classList.toggle('is-empty', newDrawer.classList.contains('is-empty'));
      }

      const currentPanel = document.querySelector('cart-drawer #CartDrawer, #CartDrawer');
      const newPanel = doc.querySelector('cart-drawer #CartDrawer, #CartDrawer');

      const currentItems = document.getElementById('CartDrawer-Items');
      const newItems = doc.querySelector('#CartDrawer-Items');

      let didReplace = false;

      if (currentItems && newItems) {
        currentItems.innerHTML = newItems.innerHTML;
        didReplace = true;
      } else if (currentPanel && newPanel) {
        currentPanel.innerHTML = newPanel.innerHTML;
        rebindCartDrawerCloseButtons();
        return true;
      }

      const currentRecommendations = document.getElementById('CartDrawer-Recommendations');
      const newRecommendations = doc.querySelector('#CartDrawer-Recommendations');

      if (currentRecommendations && newRecommendations) {
        currentRecommendations.innerHTML = newRecommendations.innerHTML;
        didReplace = true;
      } else if (currentRecommendations && !newRecommendations) {
        currentRecommendations.remove();
        didReplace = true;
      } else if (!currentRecommendations && newRecommendations) {
        const currentFooter = document.querySelector('.cart-drawer__footer');
        if (currentFooter && currentFooter.parentElement) {
          currentFooter.parentElement.insertBefore(newRecommendations, currentFooter);
          didReplace = true;
        } else if (currentPanel) {
          currentPanel.appendChild(newRecommendations);
          didReplace = true;
        }
      }

      const currentFooter = document.querySelector('.cart-drawer__footer');
      const newFooter = doc.querySelector('.cart-drawer__footer');
      if (currentFooter && newFooter) {
        currentFooter.innerHTML = newFooter.innerHTML;
        didReplace = true;
      }

      rebindCartDrawerCloseButtons();
      return didReplace;
    }

    async function refreshCartDrawer(preferredSectionId, prefetchedSections) {
      const sectionId = preferredSectionId || getCartDrawerSectionId();

      const prefetchedHtml = getCartDrawerSectionHtml(prefetchedSections, sectionId);
      if (replaceDrawerHtml(prefetchedHtml)) {
        return true;
      }

      try {
        const url = `${getRootPath()}cart?sections=${encodeURIComponent(sectionId)}&sections_url=${encodeURIComponent(window.location.pathname)}&_=${Date.now()}`;
        const response = await fetch(url, {
          method: 'GET',
          headers: {
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          credentials: 'same-origin',
          cache: 'no-store'
        });

        if (!response.ok) {
          return false;
        }

        const sections = await response.json();
        return replaceDrawerHtml(getCartDrawerSectionHtml(sections, sectionId));
      } catch (error) {
        console.warn('[XCustom Look] Cart drawer section refresh failed:', error);
        return false;
      }
    }

    function wait(ms) {
      return new Promise((resolve) => window.setTimeout(resolve, ms));
    }

    function setAddButtonLabel(button, label) {
      const textElement = button.querySelector('[data-look-add-text]');

      if (textElement) {
        textElement.textContent = label;
      } else {
        button.textContent = label;
      }
    }

    function setAddMessage(button, text, isError = false) {
      const card = button.closest('[data-look-card]');
      const message = card?.querySelector('[data-look-add-message]');

      if (!message) {
        return;
      }

      message.textContent = text;
      message.classList.toggle('is-error', isError);
    }

    function showCartNotification(type, title, message) {
      if (!window.CartNotification) {
        return;
      }

      const payload = { title, message, type };

      try {
        if (type === 'success' && typeof window.CartNotification.success === 'function') {
          window.CartNotification.success(payload);
          return;
        }

        if (type === 'error' && typeof window.CartNotification.error === 'function') {
          window.CartNotification.error(payload);
          return;
        }
      } catch (error) {
        try {
          if (type === 'error' && typeof window.CartNotification.error === 'function') {
            window.CartNotification.error(message, title);
          }
        } catch (nestedError) {
          console.warn('[XCustom Look] Cart notification failed:', nestedError);
        }
      }
    }

    function openCartDrawer(cart) {
      const cartDrawer = document.querySelector('cart-drawer');

      if (!cartDrawer) {
        return;
      }

      if (cart && Number.isFinite(cart.item_count)) {
        cartDrawer.classList.toggle('is-empty', cart.item_count === 0);
      } else {
        cartDrawer.classList.remove('is-empty');
      }

      if (typeof cartDrawer.open === 'function') {
        cartDrawer.open();
      } else {
        cartDrawer.classList.add('is-open');
        const drawerPanel = cartDrawer.querySelector('#CartDrawer');
        if (drawerPanel) {
          drawerPanel.setAttribute('aria-hidden', 'false');
          drawerPanel.focus?.();
        }
        document.body.classList.add('cart-drawer-open');
      }
    }

    function dispatchCartEvents(cart) {
      const detail = cart ? { cart } : {};

      document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail }));
      document.dispatchEvent(new CustomEvent('cart:change', { bubbles: true, detail }));
      document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true, detail }));
      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail }));
      document.dispatchEvent(new CustomEvent('product:added', { bubbles: true, detail }));
    }

    async function addProductToCart(button) {
      if (
        button.disabled ||
        button.classList.contains('is-loading') ||
        button.dataset.processing === 'true'
      ) {
        return;
      }

      const variantId = Number(button.dataset.variantId);

      if (!Number.isInteger(variantId) || variantId <= 0) {
        return;
      }

      const defaultLabel =
        button.dataset.defaultLabel ||
        {{ 'ADD TO CART' | json }} ||
        'ADD TO CART';

      const loadingLabel =
        button.dataset.loadingLabel ||
        {{ 'ADDING...' | json }} ||
        'ADDING...';

      const successLabel =
        button.dataset.successLabel ||
        {{ 'ADDED' | json }} ||
        'ADDED';

      const errorLabel =
        button.dataset.errorLabel ||
        {{ 'Unable to add. Please try again.' | json }} ||
        'Unable to add. Please try again.';

      const drawerSectionId = getCartDrawerSectionId();

      button.dataset.processing = 'true';
      button.classList.add('is-loading');
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      setAddButtonLabel(button, loadingLabel);
      setAddMessage(button, '');

      try {
        const response = await fetch(`${getRootPath()}cart/add.js`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          credentials: 'same-origin',
          body: JSON.stringify({
            items: [
              {
                id: variantId,
                quantity: 1
              }
            ],
            sections: drawerSectionId,
            sections_url: window.location.pathname
          })
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(
            result.description ||
            result.message ||
            errorLabel
          );
        }

        getCartApi().invalidate?.();

        let drawerUpdated = await refreshCartDrawer(drawerSectionId, result.sections);

        if (!drawerUpdated) {
          await wait(120);
          drawerUpdated = await refreshCartDrawer(drawerSectionId);
        }

        const cart = await fetchCart();

        if (cart) {
          updateCartCount(cart.item_count);
          updateCartSubtotal(cart);

          const cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer) {
            cartDrawer.classList.toggle('is-empty', cart.item_count === 0);
          }
        }

        if (!drawerUpdated) {
          await wait(180);
          await refreshCartDrawer(drawerSectionId);
        }

        dispatchCartEvents(cart);

        showCartNotification(
          'success',
          'Product Added!',
          'Join <a href="https://www.ativafit.com/pages/ativapeople-rewards-program" target="_blank" style="color: #eb701f; text-decoration: underline; font-weight: bold;">AtivaPeople</a> & get extra discount.'
        );

        window.setTimeout(() => {
          openCartDrawer(cart);
        }, 220);

        button.classList.remove('is-loading');
        button.removeAttribute('aria-busy');
        setAddButtonLabel(button, successLabel);
        setAddMessage(button, {{ 'Added to cart.' | json }} || 'Added to cart.');

        window.setTimeout(() => {
          button.disabled = false;
          button.dataset.processing = 'false';
          setAddButtonLabel(button, defaultLabel);
          setAddMessage(button, '');
        }, 1800);
      } catch (error) {
        button.classList.remove('is-loading');
        button.removeAttribute('aria-busy');
        button.disabled = false;
        button.dataset.processing = 'false';
        setAddButtonLabel(button, defaultLabel);
        setAddMessage(button, error.message || errorLabel, true);

        showCartNotification(
          'error',
          'Error!',
          error.message || errorLabel
        );

        console.error('[XCustom Look] Add to cart failed:', error);
      }
    }

    function initXCustomLook() {
      const root = document.getElementById(rootId);

      if (!root || root.dataset.xcustomLookInitialized === 'true') {
        return;
      }

      root.dataset.xcustomLookInitialized = 'true';

      const markers = Array.from(root.querySelectorAll('[data-look-marker]'));
      const cards = Array.from(root.querySelectorAll('[data-look-card]'));
      const sceneMedia = root.querySelector('.xcustom-look__scene-media');
      const desktopQuery = window.matchMedia('(min-width: 750px)');

      function syncPanelHeight() {
        if (!sceneMedia || !root.classList.contains('xcustom-look--balanced-desktop')) {
          root.style.removeProperty('--xcustom-look-scene-height');
          return;
        }

        if (!desktopQuery.matches) {
          root.style.removeProperty('--xcustom-look-scene-height');
          return;
        }

        window.requestAnimationFrame(() => {
          const sceneHeight = Math.round(sceneMedia.getBoundingClientRect().height);

          if (sceneHeight > 0) {
            root.style.setProperty('--xcustom-look-scene-height', sceneHeight + 'px');
          }
        });
      }

      function activateProduct(blockId) {
        markers.forEach((marker) => {
          const isActive = marker.dataset.lookTarget === blockId;

          marker.classList.toggle('is-active', isActive);
          marker.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        cards.forEach((card) => {
          const isActive = card.dataset.lookCard === blockId;

          card.classList.toggle('is-active', isActive);
          card.hidden = !isActive;
        });

        syncPanelHeight();
      }

      root.addEventListener('click', (event) => {
        const addButton = event.target.closest('[data-look-add-to-cart]');

        if (addButton) {
          event.preventDefault();
          event.stopPropagation();
          addProductToCart(addButton);
          return;
        }

        const marker = event.target.closest('[data-look-marker]');

        if (marker) {
          activateProduct(marker.dataset.lookTarget);
        }
      });

      if (markers.length && cards.length) {
        const initialMarker =
          markers.find((marker) => marker.classList.contains('is-active')) ||
          markers[0];

        if (initialMarker) {
          activateProduct(initialMarker.dataset.lookTarget);
        }
      }

      syncPanelHeight();

      root.querySelectorAll('.xcustom-look__scene-image').forEach((image) => {
        if (image.complete) {
          syncPanelHeight();
          return;
        }

        image.addEventListener('load', syncPanelHeight, { once: true });
      });

      window.addEventListener('resize', syncPanelHeight);

      if (typeof desktopQuery.addEventListener === 'function') {
        desktopQuery.addEventListener('change', syncPanelHeight);
      } else if (typeof desktopQuery.addListener === 'function') {
        desktopQuery.addListener(syncPanelHeight);
      }
    }

    initXCustomLook();

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', (event) => {
        if (event.detail.sectionId === String(sectionId)) {
          const root = document.getElementById(rootId);
          if (root) {
            delete root.dataset.xcustomLookInitialized;
          }
          initXCustomLook();
        }
      });

      document.addEventListener('shopify:block:select', (event) => {
        if (event.detail.sectionId !== String(sectionId)) {
          return;
        }

        const root = document.getElementById(rootId);

        if (!root) {
          return;
        }

        const marker = root.querySelector(
          '[data-look-target="' + event.detail.blockId + '"]'
        );

        if (marker) {
          marker.click();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "XCustom Shop Look",
  "tag": "section",
  "class": "section-xcustom-look",
  "max_blocks": 12,
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Core layout"
    },
