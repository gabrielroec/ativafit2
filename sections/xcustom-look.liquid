      "default": 1400
    },
    {
      "type": "range",
      "id": "header_max_width",
      "min": 500,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Header maximum width",
      "default": 900
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
