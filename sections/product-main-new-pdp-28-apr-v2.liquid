{% comment %}
  Product Main Section — New PDP v2 (2026-05-08)
  Variant of `product-main-new-pdp-28-apr` where the right-top column renders
  the legacy buy box (`product-info` + `product-add-to-cart` snippets) instead
  of `np-pdp-28-primary`. Bento + right-bottom (description, accordions, pairs)
  remain identical to v1.

  Pulls CSS from BOTH the new PDP and the legacy PDP because the inner buy box
  uses legacy classes (`.product-info-wrapper_new`, `.add-to-cart-btn_new`, ...).
  The legacy variant/cart/ativapeople JS lives in `np-pdp-28-apr-v2-scripts`.
{% endcomment %}

{{ 'product-main-new-pdp-28-apr.css' | asset_url | stylesheet_tag }}
{{ 'product-main-section.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  v2 buy-box overrides — the legacy `.product-info-wrapper_new` forces 50% width
  because in the old PDP it lived in a flex row beside the gallery. In the v2
  layout the gallery is in a separate grid column, so the buy box must fill its
  column (100%). Keep these overrides scoped to `.np-pdp--v2` so the legacy PDP
  is untouched.
{%- endcomment -%}
<style>
  .np-pdp--v2 .product-info-wrapper_new {
    width: 100% !important;
  }

  /* v2-only: Buy It Now uses the dark variant. `global.css` ships a low-contrast
     transparent style (border #ddd, color #aaa) that hurts conversion on this
     template — override with black bg + white text. !important defeats the
     existing !important declarations in global.css. */
  .np-pdp--v2 .buy-it-now-btn_new,
  .np-pdp--v2 .buy-it-now-btn_new:hover,
  .np-pdp--v2 .buy-it-now-btn_new:focus {
    background-color: #000 !important;
    color: #fff !important;
    border-color: #000 !important;
  }
</style>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  assign bento_blocks = section.blocks | where: 'type', 'bento_item'
  assign accordion_blocks = section.blocks | where: 'type', 'accordion'
  assign pairs_block = section.blocks | where: 'type', 'pairs_well_with' | first

  assign mf_desc = product.metafields.custom.pdp_description_body
  assign description_html = blank
  if mf_desc != blank and mf_desc.value != blank
    assign description_html = mf_desc.value
  elsif section.settings.description_fallback != blank
    assign description_html = section.settings.description_fallback
  endif

  assign description_title = product.metafields.custom.pdp_description_title.value | default: section.settings.description_title

  assign benefit_items = product.metafields.custom.product_benefits.value
  assign use_benefits_metaobject = false
  if benefit_items != blank and benefit_items.size > 0
    assign use_benefits_metaobject = true
  else
    assign benefit_items = bento_blocks
  endif

  assign key_features_items = product.metafields.custom.pdp_key_features.value
  assign use_tips_items = product.metafields.custom.pdp_use_tips.value
  assign tech_specs_items = product.metafields.custom.pdp_tech_specs.value
-%}

{%- capture icon_chevron -%}<svg class="np-pdp__icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>{%- endcapture -%}
{%- capture icon_chevron_left -%}<svg class="np-pdp__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/></svg>{%- endcapture -%}
{%- capture icon_chevron_right -%}<svg class="np-pdp__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture icon_play -%}<svg class="np-pdp__icon" width="32" height="32" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" fill="rgba(0,0,0,0.55)"/><path fill="#fff" d="M10 8.5l5 3.5-5 3.5z"/></svg>{%- endcapture -%}
{%- capture icon_arrow_right -%}<svg class="np-pdp__icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}

{%- comment -%}
  Stacked "Pairs Well With" — uses the new-PDP card style (image left, info right)
  but renders one card per `pairs_well_with_product` block instead of the legacy
  carousel. Captured once and emitted below `np-pdp-28-secondary` in both grid
  branches so it sits below the accordions.
{%- endcomment -%}
{%- assign pwp_blocks = section.blocks | where: 'type', 'pairs_well_with_product' -%}
{%- capture pairs_stack -%}
  {%- if section.settings.show_pairs_well_with and pwp_blocks.size > 0 -%}
    <section class="np-pdp__pairs np-pdp__pairs--stack">
      {%- if section.settings.pairs_well_with_title != blank -%}
        <header class="np-pdp__pairs-header">
          <h2 class="np-pdp__pairs-title">{{ section.settings.pairs_well_with_title }}</h2>
        </header>
      {%- endif -%}
      {%- for b in pwp_blocks -%}
        {%- if b.settings.product != blank -%}
          {%- assign p = all_products[b.settings.product] -%}
          {%- if p != blank -%}
            <a class="np-pdp__pairs-card" href="{{ p.url }}" {{ b.shopify_attributes }}>
              <div class="np-pdp__pairs-image">
                {%- if p.featured_image -%}
                  <img src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" loading="lazy" width="200" height="200">
                {%- endif -%}
              </div>
              <div class="np-pdp__pairs-info">
                <h3 class="np-pdp__pairs-name">{{ p.title }}</h3>
                <p class="np-pdp__pairs-price">{{ p.price | money }}</p>
                <span class="np-pdp__pairs-cta">{{ section.settings.pairs_well_with_add_to_cart_text | default: 'Add to cart' }}</span>
              </div>
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </section>
  {%- endif -%}
{%- endcapture -%}

<section
  class="np-pdp np-pdp--v2"
  data-section-id="{{ section.id }}"
  data-section-type="product-main-new-pdp-28-apr-v2"
  data-product-handle="{{ product.handle }}">
  <div class="np-pdp__container">

    {%- if section.settings.show_breadcrumbs -%}
      <nav class="np-pdp__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        {%- if collection -%}
          <a href="{{ collection.url }}">{{ collection.title }}</a>
          <span aria-hidden="true">/</span>
        {%- endif -%}
        <span class="np-pdp__breadcrumbs-current">{{ product.title }}</span>
      </nav>
    {%- endif -%}

    <div class="np-pdp__grid{% if benefit_items.size > 0 %} np-pdp__grid--has-bento{% endif %}">

      {%- comment -%} ================ LEFT COLUMN ================ {%- endcomment -%}
      <div class="np-pdp__col np-pdp__col--left">

      {%- comment -%} Gallery (sticky on desktop) {%- endcomment -%}
      <div class="np-pdp__left">
        <div class="np-pdp__gallery" data-np-gallery>
          {%- if product.media.size > 0 -%}
            <div class="np-pdp__gallery-main" data-np-gallery-main>
              {%- for media in product.media -%}
                <div
                  class="np-pdp__gallery-slide{% if forloop.first %} is-active{% endif %}"
                  data-np-slide="{{ forloop.index0 }}">
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      <img
                        src="{{ media | image_url: width: 1200 }}"
                        alt="{{ media.alt | escape }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        width="1200"
                        height="1200">
                    {%- when 'video', 'external_video' -%}
                      {{ media | media_tag: image_size: '1200x', autoplay: false, loop: false, controls: true, preload: 'metadata' }}
                    {%- else -%}
                      {{ media | media_tag }}
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            </div>

            {%- if product.media.size > 1 -%}
              <div class="np-pdp__gallery-thumbs-wrap">
                <button
                  type="button"
                  class="np-pdp__gallery-nav np-pdp__gallery-nav--prev"
                  data-np-thumbs-nav="-1"
                  aria-label="Previous thumbnails">{{ icon_chevron_left }}</button>
                <div class="np-pdp__gallery-thumbs" data-np-gallery-thumbs>
                  {%- for media in product.media -%}
                    <button
                      type="button"
                      class="np-pdp__gallery-thumb{% if forloop.first %} is-active{% endif %}"
                      data-np-thumb="{{ forloop.index0 }}"
                      aria-label="View media {{ forloop.index }}">
                      <img
                        src="{{ media.preview_image | image_url: width: 200 }}"
                        alt=""
                        loading="lazy"
                        width="200"
                        height="200">
                      {%- if media.media_type != 'image' -%}
                        <span class="np-pdp__gallery-thumb-icon">{{ icon_play }}</span>
                      {%- endif -%}
                    </button>
                  {%- endfor -%}
                </div>
                <button
                  type="button"
                  class="np-pdp__gallery-nav np-pdp__gallery-nav--next"
                  data-np-thumbs-nav="1"
                  aria-label="Next thumbnails">{{ icon_chevron_right }}</button>
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="np-pdp__gallery-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Left benefits — visible on desktop, hidden on mobile (CSS-controlled) {%- endcomment -%}
      {% render 'np-pdp-bento',
        bento_blocks: benefit_items,
        use_metaobject: use_benefits_metaobject,
        bento_title: section.settings.bento_title,
        variant_class: 'np-pdp__bento--left'
      %}
    </div>

    {%- comment -%} ================ RIGHT COLUMN ================ {%- endcomment -%}
    <div class="np-pdp__col np-pdp__col--right">
      <div class="np-pdp__right-top">
        {%- comment -%} v2: legacy buy box replaces np-pdp-28-primary {%- endcomment -%}
        <div class="product-info-wrapper_new np-pdp__right-top--legacy">
          {% render 'product-info', product: product, section: section %}
          {% render 'product-add-to-cart', product: product, section: section %}
          {%- if section.settings.trust_line != blank -%}
            <p class="np-pdp__trust">{{ section.settings.trust_line }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Right benefits — hidden on desktop, visible on mobile (CSS-controlled) {%- endcomment -%}
      {% render 'np-pdp-bento',
        bento_blocks: benefit_items,
        use_metaobject: use_benefits_metaobject,
        bento_title: section.settings.bento_title,
        variant_class: 'np-pdp__bento--right'
      %}

      <div class="np-pdp__right-bottom">
        {% render 'np-pdp-28-secondary',
          section: section,
          product: product,
          description_html: description_html,
          description_title: description_title,
          accordion_blocks: accordion_blocks,
          key_features_items: key_features_items,
          use_tips_items: use_tips_items,
          tech_specs_items: tech_specs_items,
          pairs_block: pairs_block,
          icon_chevron: icon_chevron,
          icon_arrow_right: icon_arrow_right
        %}
        {{ pairs_stack }}
      </div>
    </div>
  </div>
  </div>

  <script type="application/json" data-np-variants-data>
    {{ product.variants | json }}
  </script>
</section>

{%- comment -%} New PDP gallery JS — drives the np-pdp__gallery-* DOM (left column). {%- endcomment -%}
<script>
  (function () {
    var section = document.querySelector('[data-section-type="product-main-new-pdp-28-apr-v2"][data-section-id="{{ section.id }}"]');
    if (!section) return;

    var thumbs = section.querySelectorAll('[data-np-thumb]');
    var slides = section.querySelectorAll('[data-np-slide]');
    var thumbsTrack = section.querySelector('[data-np-gallery-thumbs]');

    function showSlide(idx) {
      slides.forEach(function (s) { s.classList.toggle('is-active', s.dataset.npSlide == idx); });
      thumbs.forEach(function (t) { t.classList.toggle('is-active', t.dataset.npThumb == idx); });
    }
    thumbs.forEach(function (t) {
      t.addEventListener('click', function () { showSlide(t.dataset.npThumb); });
    });

    section.querySelectorAll('[data-np-thumbs-nav]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!thumbsTrack) return;
        var dir = parseInt(btn.dataset.npThumbsNav, 10);
        var firstThumb = thumbsTrack.querySelector('.np-pdp__gallery-thumb');
        var step = firstThumb ? (firstThumb.offsetWidth + 12) * 3 : 240;
        thumbsTrack.scrollBy({ left: step * dir, behavior: 'smooth' });
      });
    });

    function updateThumbsNav() {
      if (!thumbsTrack) return;
      var prev = section.querySelector('[data-np-thumbs-nav="-1"]');
      var next = section.querySelector('[data-np-thumbs-nav="1"]');
      var atStart = thumbsTrack.scrollLeft <= 1;
      var atEnd = thumbsTrack.scrollLeft + thumbsTrack.clientWidth >= thumbsTrack.scrollWidth - 1;
      if (prev) prev.disabled = atStart;
      if (next) next.disabled = atEnd;
    }
    if (thumbsTrack) {
      thumbsTrack.addEventListener('scroll', updateThumbsNav, { passive: true });
      window.addEventListener('resize', updateThumbsNav);
      updateThumbsNav();
    }
  })();
</script>

{%- comment -%}
