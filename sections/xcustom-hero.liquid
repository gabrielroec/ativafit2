
{% liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign active_mobile_image = mobile_image | default: desktop_image

  assign image_alt = desktop_image.alt

  if image_alt == blank and active_mobile_image != blank
    assign image_alt = active_mobile_image.alt
  endif

  if image_alt == blank
    assign image_alt = section.settings.heading | strip_html
  endif

  assign image_focal_point = 'center center'
  assign image_style = ''
  assign mobile_image_focal_point = image_focal_point

  assign image_aspect_ratio = 1.77777778
  assign mobile_image_aspect_ratio = image_aspect_ratio

  if desktop_image != blank
    assign image_focal_point = desktop_image.presentation.focal_point | default: 'center center'
    assign image_style = 'object-position: ' | append: image_focal_point | append: ';'

    if desktop_image.aspect_ratio != blank
      assign image_aspect_ratio = desktop_image.aspect_ratio
      assign mobile_image_aspect_ratio = desktop_image.aspect_ratio
    endif
  endif

  if active_mobile_image != blank
    assign mobile_image_focal_point = active_mobile_image.presentation.focal_point | default: image_focal_point

    if active_mobile_image.aspect_ratio != blank
      assign mobile_image_aspect_ratio = active_mobile_image.aspect_ratio
    endif
  endif

  assign width_class = 'xcustom-gym--contained'
  if section.settings.full_width
    assign width_class = 'xcustom-gym--full'
  endif

  assign button_count = 0
  if section.settings.primary_button_label != blank
    assign button_count = button_count | plus: 1
  endif
  if section.settings.secondary_button_label != blank
    assign button_count = button_count | plus: 1
  endif

  assign button_alignment = 'flex-start'
  if section.settings.text_alignment == 'center'
    assign button_alignment = 'center'
  elsif section.settings.text_alignment == 'right'
    assign button_alignment = 'flex-end'
  endif

  assign primary_button_target = section.settings.primary_button_target_id | strip | remove: '#'
  assign secondary_button_target = section.settings.secondary_button_target_id | strip | remove: '#'

  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'
  if section.settings.eager_load
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif
%}

<section
  id="XCustomGym-{{ section.id }}"
  class="xcustom-gym {{ width_class }} xcustom-gym--height-{{ section.settings.image_height_mode }} xcustom-gym--image-{{ section.settings.image_position }}{% if section.settings.mobile_image_first %} xcustom-gym--mobile-image-first{% endif %}"
>
  <div class="xcustom-gym__shell">
    <div class="xcustom-gym__hero">
      <div class="xcustom-gym__media">
        {% if desktop_image != blank or mobile_image != blank %}
          <picture class="xcustom-gym__picture">
            {% if mobile_image != blank %}
              <source
                media="(max-width: 767px)"
                srcset="
                  {{ mobile_image | image_url: width: 375 }} 375w,
                  {{ mobile_image | image_url: width: 550 }} 550w,
                  {{ mobile_image | image_url: width: 750 }} 750w,
                  {{ mobile_image | image_url: width: 960 }} 960w,
                  {{ mobile_image | image_url: width: 1200 }} 1200w,
                  {{ mobile_image | image_url: width: 1500 }} 1500w
                "
                sizes="100vw"
              >
            {% endif %}

            {% if desktop_image != blank %}
              {{
                desktop_image
                | image_url: width: 3000
                | image_tag:
                  widths: '375, 550, 750, 960, 1200, 1500, 1800, 2200, 2600, 3000',
                  sizes: '100vw',
                  class: 'xcustom-gym__image',
                  loading: image_loading,
                  fetchpriority: image_fetchpriority,
                  style: image_style,
                  alt: image_alt
              }}
            {% else %}
              {{
                mobile_image
                | image_url: width: 1500
                | image_tag:
                  widths: '375, 550, 750, 960, 1200, 1500',
                  sizes: '100vw',
                  class: 'xcustom-gym__image',
                  loading: image_loading,
                  fetchpriority: image_fetchpriority,
                  style: image_style,
                  alt: image_alt
              }}
            {% endif %}
          </picture>
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'xcustom-gym__placeholder' }}
        {% endif %}
      </div>

      <div class="xcustom-gym__overlay" aria-hidden="true"></div>
      <div class="xcustom-gym__left-gradient" aria-hidden="true"></div>

      <div class="xcustom-gym__content">
        <div class="xcustom-gym__copy">
          {% if section.settings.heading != blank %}
            <{{ section.settings.heading_tag }} class="xcustom-gym__heading">
              {{ section.settings.heading | escape | newline_to_br }}
            </{{ section.settings.heading_tag }}>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="xcustom-gym__description rte">
              {{ section.settings.description }}
            </div>
          {% endif %}

          {% if button_count > 0 %}
            <div class="xcustom-gym__buttons xcustom-gym__buttons--{{ button_count }}">
              {% if section.settings.primary_button_label != blank %}
                {% if primary_button_target != blank %}
                  <a
                    class="xcustom-gym__button xcustom-gym__button--primary"
                    href="#{{ primary_button_target | escape }}"
                    data-xcustom-scroll-target="{{ primary_button_target | escape }}"
                    data-xcustom-scroll-offset="{{ section.settings.scroll_offset | default: 204 }}"
                  >
                    <span>{{ section.settings.primary_button_label | escape }}</span>
                  </a>
                {% else %}
                  <span
                    class="xcustom-gym__button xcustom-gym__button--primary xcustom-gym__button--disabled"
                    aria-disabled="true"
                  >
                    <span>{{ section.settings.primary_button_label | escape }}</span>
                  </span>
                {% endif %}
              {% endif %}

              {% if section.settings.secondary_button_label != blank %}
                {% if secondary_button_target != blank %}
                  <a
                    class="xcustom-gym__button xcustom-gym__button--secondary"
                    href="#{{ secondary_button_target | escape }}"
                    data-xcustom-scroll-target="{{ secondary_button_target | escape }}"
                    data-xcustom-scroll-offset="{{ section.settings.scroll_offset | default: 204 }}"
                  >
                    <span>{{ section.settings.secondary_button_label | escape }}</span>
                  </a>
                {% else %}
                  <span
                    class="xcustom-gym__button xcustom-gym__button--secondary xcustom-gym__button--disabled"
                    aria-disabled="true"
                  >
                    <span>{{ section.settings.secondary_button_label | escape }}</span>
                  </span>
                {% endif %}
              {% endif %}
            </div>
          {% endif %}

          {% if button_count > 0 and section.settings.button_note != blank %}
            <div class="xcustom-gym__button-note">
              {{ section.settings.button_note | escape }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
  {% unless section.settings.heading_use_theme_font %}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {% endunless %}

  {% unless section.settings.body_use_theme_font %}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {% endunless %}

  #XCustomGym-{{ section.id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding:
      {{ section.settings.padding_top }}px
      0
      {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  #XCustomGym-{{ section.id }}.xcustom-gym--full {
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  #XCustomGym-{{ section.id }},
  #XCustomGym-{{ section.id }} *,
  #XCustomGym-{{ section.id }} *::before,
  #XCustomGym-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__shell {
    width: 100%;
    margin: 0 auto;
    overflow: visible;
  }

  #XCustomGym-{{ section.id }}.xcustom-gym--contained .xcustom-gym__shell {
    max-width: 1750px;
    padding-left: {{ section.settings.desktop_side_padding }}px;
    padding-right: {{ section.settings.desktop_side_padding }}px;
  }

  #XCustomGym-{{ section.id }}.xcustom-gym--full .xcustom-gym__shell {
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__hero {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.hero_min_height }}px;
    aspect-ratio: {{ image_aspect_ratio }};
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    background: #eeeeee;
    isolation: isolate;
  }

  #XCustomGym-{{ section.id }}.xcustom-gym--height-custom .xcustom-gym__hero {
    aspect-ratio: auto;
    height: {{ section.settings.hero_height }}px;
    min-height: {{ section.settings.hero_height }}px;
  }

  #XCustomGym-{{ section.id }}.xcustom-gym--full .xcustom-gym__hero {
    border-radius: 0;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__media,
  #XCustomGym-{{ section.id }} .xcustom-gym__picture,
  #XCustomGym-{{ section.id }} .xcustom-gym__overlay,
  #XCustomGym-{{ section.id }} .xcustom-gym__left-gradient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__media {
    z-index: 0;
    line-height: 0;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__picture {
    display: block;
    border-radius: inherit;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__image,
  #XCustomGym-{{ section.id }} .xcustom-gym__placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    max-width: none;
    height: 100%;
    min-height: 100%;
    margin: 0;
    border-radius: inherit;
    object-fit: cover;
    filter: brightness({{ section.settings.image_brightness | divided_by: 100.0 }}) contrast({{ section.settings.image_contrast | divided_by: 100.0 }});
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__placeholder {
    background-color: #eeeeee;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__overlay {
    z-index: 1;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__left-gradient {
    z-index: 1;
    pointer-events: none;
    {% if section.settings.enable_left_gradient %}
      background:
        linear-gradient(
          90deg,
          rgba(0, 0, 0, {{ section.settings.left_gradient_opacity | divided_by: 100.0 }}) 0%,
          rgba(0, 0, 0, {{ section.settings.left_gradient_opacity | times: 0.72 | divided_by: 100.0 }}) 26%,
          rgba(0, 0, 0, 0.16) {{ section.settings.left_gradient_width | minus: 10 }}%,
          rgba(0, 0, 0, 0) {{ section.settings.left_gradient_width }}%
        );
    {% else %}
      display: none;
    {% endif %}
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__content {
    position: absolute;
    z-index: 2;
    top: {{ section.settings.text_top }}%;
    left: {{ section.settings.text_left }}%;
    width: {{ section.settings.content_width }}%;
    min-width: 0;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__copy {
    width: 100%;
    max-width: {{ section.settings.copy_max_width }}px;
    min-width: 0;
    padding:
      {{ section.settings.copy_padding_top }}px
      {{ section.settings.copy_padding_right_percent }}%
      {{ section.settings.copy_padding_bottom }}px
      {{ section.settings.copy_padding_left_percent }}%;
    text-align: {{ section.settings.text_alignment }};
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__heading {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size }}px !important;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }} !important;
    letter-spacing: normal;
    text-transform: none;
    overflow-wrap: break-word;
    text-shadow: 0 2px 20px rgba(0, 0, 0, {{ section.settings.text_shadow_opacity | divided_by: 100.0 }});
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__heading br {
    line-height: inherit;
  }

  {% unless section.settings.heading_use_theme_font %}
    #XCustomGym-{{ section.id }} .xcustom-gym__heading {
      font-family:
        {{ section.settings.heading_font.family }},
        {{ section.settings.heading_font.fallback_families }};
      font-style: {{ section.settings.heading_font.style }};
      font-weight: {{ section.settings.heading_font.weight }};
    }
  {% endunless %}

  #XCustomGym-{{ section.id }} .xcustom-gym__description {
    width: 100%;
    max-width: 100%;
    margin-top: {{ section.settings.text_gap }}px;
    color: {{ section.settings.text_color }}!important;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__description,
  #XCustomGym-{{ section.id }} .xcustom-gym__description p,
  #XCustomGym-{{ section.id }} .xcustom-gym__description span,
  #XCustomGym-{{ section.id }} .xcustom-gym__description strong,
  #XCustomGym-{{ section.id }} .xcustom-gym__description em,
  #XCustomGym-{{ section.id }} .xcustom-gym__description a,
  #XCustomGym-{{ section.id }} .xcustom-gym__description li {
    color: {{ section.settings.text_color }} !important;
    font-size: {{ section.settings.body_font_size }}px !important;
    line-height: {{ section.settings.body_line_height | divided_by: 100.0 }} !important;
    text-shadow: 0 1px 12px rgba(0, 0, 0, {{ section.settings.text_shadow_opacity | divided_by: 100.0 }});
  }

  {% unless section.settings.body_use_theme_font %}
    #XCustomGym-{{ section.id }} .xcustom-gym__description,
    #XCustomGym-{{ section.id }} .xcustom-gym__description p,
    #XCustomGym-{{ section.id }} .xcustom-gym__description span,
    #XCustomGym-{{ section.id }} .xcustom-gym__description strong,
    #XCustomGym-{{ section.id }} .xcustom-gym__description em,
    #XCustomGym-{{ section.id }} .xcustom-gym__description a,
    #XCustomGym-{{ section.id }} .xcustom-gym__description li,
    #XCustomGym-{{ section.id }} .xcustom-gym__button,
    #XCustomGym-{{ section.id }} .xcustom-gym__button-note {
      font-family:
        {{ section.settings.body_font.family }},
        {{ section.settings.body_font.fallback_families }};
      font-style: {{ section.settings.body_font.style }};
    }
  {% endunless %}

  #XCustomGym-{{ section.id }} .xcustom-gym__description > *:first-child {
    margin-top: 0;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__description > *:last-child {
    margin-bottom: 0;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: {{ button_alignment }};
    gap: {{ section.settings.button_gap }}px;
    width: 100%;
    margin-top: {{ section.settings.button_top_gap }}px;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: {{ section.settings.button_height }}px;
    max-width: 100%;
    padding: 10px {{ section.settings.button_horizontal_padding }}px;
    border: 1px solid transparent;
    border-radius: {{ section.settings.button_radius }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    white-space: normal;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.16);
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__button:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.2);
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__button span {
    display: block;
    min-width: 0;
    max-width: 100%;
    color: inherit;
    font: inherit;
    line-height: inherit;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__button--primary {
    color: {{ section.settings.primary_button_text }};
    background-color: {{ section.settings.primary_button_background }};
    border-color: {{ section.settings.primary_button_background }};
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__button--primary:hover {
    color: {{ section.settings.primary_button_hover_text }};
    background-color: {{ section.settings.primary_button_hover_background }};
    border-color: {{ section.settings.primary_button_hover_background }};
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__button--secondary {
    color: {{ section.settings.secondary_button_text }};
    background-color: {{ section.settings.secondary_button_background }};
    border-color: {{ section.settings.secondary_button_border }};
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__button--secondary:hover {
    color: {{ section.settings.secondary_button_hover_text }};
    background-color: {{ section.settings.secondary_button_hover_background }};
    border-color: {{ section.settings.secondary_button_hover_border }};
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__button-note {
    width: 100%;
    margin-top: {{ section.settings.button_note_gap }}px;
    color: {{ section.settings.button_note_color }};
    font-size: {{ section.settings.button_note_size }}px;
    font-weight: 500;
    line-height: 1.4;
    text-align: {{ section.settings.text_alignment }};
    text-shadow: 0 1px 10px rgba(0, 0, 0, {{ section.settings.text_shadow_opacity | divided_by: 100.0 }});
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__button--disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  #XCustomGym-{{ section.id }} .xcustom-gym__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }



  /* Narrow desktop / tablet protection only.
     This keeps the original full-width desktop layout unchanged,
     and only adjusts typography + inner spacing when the viewport gets narrow. */
  @media screen and (min-width: 1200px) and (max-width: 1499px) {
    #XCustomGym-{{ section.id }} .xcustom-gym__content {
      width: max({{ section.settings.content_width }}%, 46%);
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__copy {
      padding-left: min({{ section.settings.copy_padding_left_percent }}%, 120px);
      padding-right: min({{ section.settings.copy_padding_right_percent }}%, 72px);
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__heading {
      font-size: clamp(50px, 4.2vw, {{ section.settings.heading_font_size }}px) !important;
      line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }} !important;
      overflow-wrap: normal;
      word-break: normal;
      hyphens: manual;
      text-wrap: balance;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__description,
    #XCustomGym-{{ section.id }} .xcustom-gym__description p,
    #XCustomGym-{{ section.id }} .xcustom-gym__description span,
    #XCustomGym-{{ section.id }} .xcustom-gym__description strong,
    #XCustomGym-{{ section.id }} .xcustom-gym__description em,
    #XCustomGym-{{ section.id }} .xcustom-gym__description a,
    #XCustomGym-{{ section.id }} .xcustom-gym__description li {
      font-size: clamp(15px, 1.2vw, {{ section.settings.body_font_size }}px) !important;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__button {
      min-height: clamp(42px, 3.4vw, {{ section.settings.button_height }}px);
      padding-left: clamp(18px, 2.1vw, {{ section.settings.button_horizontal_padding }}px);
      padding-right: clamp(18px, 2.1vw, {{ section.settings.button_horizontal_padding }}px);
      font-size: clamp(14px, 1.1vw, {{ section.settings.button_font_size }}px);
    }
  }

  @media screen and (min-width: 768px) and (max-width: 1199px) {
    #XCustomGym-{{ section.id }} .xcustom-gym__content {
      width: max({{ section.settings.content_width }}%, 56%);
      max-width: calc(100% - 24px);
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__copy {
      max-width: min({{ section.settings.copy_max_width }}px, 620px);
      padding-left: clamp(28px, 7vw, 92px);
      padding-right: clamp(16px, 4vw, 48px);
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__heading {
      font-size: clamp(38px, 5.1vw, 56px) !important;
      line-height: 1.04 !important;
      overflow-wrap: normal;
      word-break: normal;
      hyphens: manual;
      text-wrap: balance;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__description {
      margin-top: clamp(12px, 1.6vw, {{ section.settings.text_gap }}px);
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__description,
    #XCustomGym-{{ section.id }} .xcustom-gym__description p,
    #XCustomGym-{{ section.id }} .xcustom-gym__description span,
    #XCustomGym-{{ section.id }} .xcustom-gym__description strong,
    #XCustomGym-{{ section.id }} .xcustom-gym__description em,
    #XCustomGym-{{ section.id }} .xcustom-gym__description a,
    #XCustomGym-{{ section.id }} .xcustom-gym__description li {
      font-size: clamp(14px, 1.6vw, {{ section.settings.body_font_size }}px) !important;
      line-height: 1.48 !important;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__buttons {
      gap: clamp(8px, 1.2vw, {{ section.settings.button_gap }}px);
      margin-top: clamp(18px, 2.4vw, {{ section.settings.button_top_gap }}px);
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__button {
      min-height: clamp(40px, 4vw, {{ section.settings.button_height }}px);
      padding-left: clamp(16px, 2.4vw, {{ section.settings.button_horizontal_padding }}px);
      padding-right: clamp(16px, 2.4vw, {{ section.settings.button_horizontal_padding }}px);
      font-size: clamp(13px, 1.45vw, {{ section.settings.button_font_size }}px);
      white-space: nowrap;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__button-note {
      margin-top: clamp(8px, 1.1vw, {{ section.settings.button_note_gap }}px);
      font-size: clamp(11px, 1.25vw, {{ section.settings.button_note_size }}px);
    }
  }

  @media screen and (max-width: 767px) {
    #XCustomGym-{{ section.id }} {
      padding:
        {{ section.settings.padding_top_mobile }}px
        0
        {{ section.settings.padding_bottom_mobile }}px;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__hero {
      min-height: {{ section.settings.hero_min_height_mobile }}px;
      aspect-ratio: {{ mobile_image_aspect_ratio }};
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__image {
      object-position: {{ mobile_image_focal_point }};
    }

    #XCustomGym-{{ section.id }}.xcustom-gym--height-custom .xcustom-gym__hero {
      height: {{ section.settings.hero_height_mobile }}px;
      min-height: {{ section.settings.hero_height_mobile }}px;
      aspect-ratio: auto;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__content {
      top: {{ section.settings.text_top_mobile }}%;
      left: {{ section.settings.text_left_mobile }}%;
      width: {{ section.settings.content_width_mobile }}%;
      max-width: calc(100% - {{ section.settings.mobile_side_padding | times: 2 }}px);
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__copy {
      max-width: {{ section.settings.copy_max_width_mobile }}px;
      padding:
        {{ section.settings.copy_mobile_padding_top }}px
        {{ section.settings.copy_mobile_padding_right_percent }}%
        {{ section.settings.copy_mobile_padding_bottom }}px
        {{ section.settings.copy_mobile_padding_left_percent }}%;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__left-gradient {
      {% if section.settings.enable_left_gradient %}
        background:
          linear-gradient(
            90deg,
            rgba(0, 0, 0, {{ section.settings.left_gradient_opacity_mobile | divided_by: 100.0 }}) 0%,
            rgba(0, 0, 0, {{ section.settings.left_gradient_opacity_mobile | times: 0.64 | divided_by: 100.0 }}) 62%,
            rgba(0, 0, 0, 0.05) 100%
          );
      {% endif %}
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px !important;
      line-height: {{ section.settings.heading_line_height_mobile | divided_by: 100.0 }} !important;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__description {
      margin-top: {{ section.settings.text_gap_mobile }}px;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__description,
    #XCustomGym-{{ section.id }} .xcustom-gym__description p,
    #XCustomGym-{{ section.id }} .xcustom-gym__description span,
    #XCustomGym-{{ section.id }} .xcustom-gym__description strong,
    #XCustomGym-{{ section.id }} .xcustom-gym__description em,
    #XCustomGym-{{ section.id }} .xcustom-gym__description a,
    #XCustomGym-{{ section.id }} .xcustom-gym__description li {
      font-size: {{ section.settings.body_font_size_mobile }}px !important;
      line-height: {{ section.settings.body_line_height_mobile | divided_by: 100.0 }} !important;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__buttons {
      display: grid;
      grid-template-columns:
        repeat({% if button_count > 1 %}2{% else %}1{% endif %}, minmax(0, 1fr));
      gap: {{ section.settings.button_gap_mobile }}px;
      margin-top: {{ section.settings.button_top_gap_mobile }}px;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__button {
      width: 100%;
      min-width: 0;
      min-height: {{ section.settings.button_height_mobile }}px;
      padding: 8px 6px;
      font-size: clamp(10px, 3.2vw, {{ section.settings.button_font_size_mobile }}px);
      line-height: 1.15;
    }

    #XCustomGym-{{ section.id }} .xcustom-gym__button-note {
      margin-top: {{ section.settings.button_note_gap_mobile }}px;
      font-size: {{ section.settings.button_note_size_mobile }}px;
      line-height: 1.4;
    }
  }

  {% if primary_button_target != blank %}
    [id="{{ primary_button_target | escape }}"] {
      scroll-margin-top: {{ section.settings.scroll_offset | default: 204 }}px;
    }
  {% endif %}

  {% if secondary_button_target != blank and secondary_button_target != primary_button_target %}
    [id="{{ secondary_button_target | escape }}"] {
      scroll-margin-top: {{ section.settings.scroll_offset | default: 204 }}px;
    }
  {% endif %}
{% endstyle %}

<script>
  (function () {
    var sectionId = 'XCustomGym-{{ section.id }}';

    function getScrollTop() {
      return window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
    }

    function normalizeTargetId(value) {
      return (value || '').toString().replace(/^#/, '').trim();
    }

    function findTarget(targetId) {
      targetId = normalizeTargetId(targetId);
      if (!targetId) return null;

      return document.getElementById(targetId);
    }

    function scrollWithOffset(target, offset, behavior) {
      if (!target) return;

      var targetTop = target.getBoundingClientRect().top + getScrollTop() - offset;

      window.scrollTo({
        top: Math.max(targetTop, 0),
        behavior: behavior || 'smooth'
      });
    }

    document.addEventListener('click', function (event) {
      var clicked = event.target;

      if (clicked && clicked.nodeType === 3) {
        clicked = clicked.parentNode;
      }

      if (!clicked || !clicked.closest) return;

      var trigger = clicked.closest('a[data-xcustom-scroll-target]');
      if (!trigger) return;

      var section = document.getElementById(sectionId);
      if (!section || !section.contains(trigger)) return;

      event.preventDefault();
      event.stopPropagation();

      if (event.stopImmediatePropagation) {
        event.stopImmediatePropagation();
      }

      var targetId = normalizeTargetId(trigger.getAttribute('data-xcustom-scroll-target') || trigger.getAttribute('href'));
      var target = findTarget(targetId);

      if (!target) return;

      var offset = parseInt(trigger.getAttribute('data-xcustom-scroll-offset'), 10);
      if (isNaN(offset)) {
        offset = {{ section.settings.scroll_offset | default: 204 }};
      }

      scrollWithOffset(target, offset, 'smooth');

      if (window.history && window.history.pushState) {
        window.history.pushState(null, '', '#' + targetId);
      }
    }, true);
  })();
</script>

