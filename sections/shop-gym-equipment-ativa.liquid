{%- liquid
  assign sid = section.id
  assign mobile_layout = section.settings.mobile_layout | default: 'carousel'
-%}

<script src="{{ 'shop-gym-equipment-ativa.js' | asset_url }}" defer></script>

{% style %}
  .sg-{{ sid }} {
    padding: 60px 0;
  }
  .sg-{{ sid }} .sg__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .sg-{{ sid }} .sg__heading {
    margin: 0 0 14px;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-weight: 900;
    font-size: 30px;
    line-height: 1.3;
    letter-spacing: -1px;
    text-transform: uppercase;
    text-align: center;
    color: {{ section.settings.heading_color }};
  }
  .sg-{{ sid }} .sg__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sg-{{ sid }} .sg__item {
    margin: 0;
    min-width: 0;
  }
  .sg-{{ sid }} .sg__card {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 291 / 400;
    overflow: hidden;
    border-radius: 8px;
    background: {{ section.settings.card_placeholder_bg }};
    text-decoration: none;
    color: inherit;
  }
  .sg-{{ sid }} .sg__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sg-{{ sid }} .sg__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, transparent 55%);
    pointer-events: none;
  }
  .sg-{{ sid }} .sg__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px;
    z-index: 1;
  }
  .sg-{{ sid }} .sg__title {
    margin: 0 0 6px;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-weight: 700;
    font-size: 18px;
    line-height: 1.15;
    text-transform: uppercase;
    color: #fff;
  }
  .sg-{{ sid }} .sg__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 13px;
    color: {{ section.settings.accent_color }};
  }
  .sg-{{ sid }} .sg__cta svg {
    width: 16px;
    height: 16px;
  }

  .sg-{{ sid }} .sg__dots-wrap {
    display: none;
    justify-content: center;
    margin-top: 16px;
  }
  .sg-{{ sid }} .sg__dots {
    display: flex;
    gap: 8px;
  }
  .sg-{{ sid }} .sg-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(26, 28, 28, 0.22);
    cursor: pointer;
  }
  .sg-{{ sid }} .sg-dot[aria-current="true"] {
    background: {{ section.settings.accent_color }};
  }

  @media (max-width: 767px) {
    {%- if mobile_layout == 'carousel' -%}
    .sg-{{ sid }} .sg__grid {
      display: flex;
      grid-template-columns: none;
      gap: 12px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-padding: 0 16px;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      margin: 0 -16px;
      padding: 0 16px 4px;
      scrollbar-width: none;
    }
    .sg-{{ sid }} .sg__grid::-webkit-scrollbar { display: none; }
    .sg-{{ sid }} .sg__item {
      flex: 0 0 calc(100% - 40px);
      max-width: 340px;
      scroll-snap-align: center;
    }
    .sg-{{ sid }} .sg__dots-wrap[data-show] {
      display: flex;
    }
    {%- endif -%}
  }

  @media (min-width: 768px) {
    .sg-{{ sid }} {
      padding: 80px 0;
    }
    .sg-{{ sid }} .sg__heading {
      font-size: 36px;
      margin-bottom: 48px;
    }
    .sg-{{ sid }} .sg__title {
      font-size: 22px;
    }
    .sg-{{ sid }} .sg__content {
      padding: 28px;
    }
  }

  @media (min-width: 990px) {
    .sg-{{ sid }} .sg__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstyle %}

<section
  class="sg-{{ sid }}"
  data-shop-gym
  aria-label="{{ section.settings.section_a11y_label | default: 'Equipment categories' | escape }}"
  {{ section.shopify_attributes }}>
  <div class="sg__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="sg__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="sg__grid" data-sg-track role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            {%- liquid
              assign is_first = forloop.first
              assign loading = 'lazy'
              if is_first
                assign loading = 'eager'
              endif
            -%}
            <li class="sg__item" data-sg-item {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="sg__card" href="{{ block.settings.link }}">
              {%- else -%}
                <div class="sg__card" role="group" aria-label="{{ block.settings.title | escape }}">
              {%- endif -%}
                {%- if block.settings.image != blank -%}
                  <img class="sg__img"
                    src="{{ block.settings.image | image_url: width: 480, format: 'webp' }}"
                    srcset="{{ block.settings.image | image_url: width: 240, format: 'webp' }} 240w, {{ block.settings.image | image_url: width: 360, format: 'webp' }} 360w, {{ block.settings.image | image_url: width: 480, format: 'webp' }} 480w"
                    sizes="(min-width: 990px) 25vw, (min-width: 768px) 50vw, 90vw"
                    alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                    loading="{{ loading }}"
                    decoding="async"
                    width="480" height="660">
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'sg__img' }}
                {%- endif -%}
                <div class="sg__overlay" aria-hidden="true"></div>
                <div class="sg__content">
                  {%- if block.settings.title != blank -%}
                    <h3 class="sg__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  <span class="sg__cta">
                    {{- block.settings.cta_label | default: 'See products' | escape -}}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </div>
              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if mobile_layout == 'carousel' -%}
        <div class="sg__dots-wrap" data-show>
          <nav class="sg__dots" data-sg-dots aria-label="Carousel navigation"></nav>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop Home Gym Equipment",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section title",
      "default": "Shop Home Gym Equipment"
    },
    {
      "type": "text",
      "id": "section_a11y_label",
      "label": "Region name (accessibility)",
      "default": "Equipment categories"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid (2 per row)" }
      ],
      "default": "carousel",
      "info": "Tablet+ stays as grid (2 then 4 columns)."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1c1c"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "CTA / arrow color",
      "default": "#eb701f"
    },
    {
      "type": "color",
      "id": "card_placeholder_bg",
      "label": "Card background (placeholder)",
      "default": "#f2f2f2"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Strength Training" },
        { "type": "url", "id": "link", "label": "Card link" },
        { "type": "text", "id": "cta_label", "label": "CTA text", "default": "See products" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop Home Gym Equipment",
      "blocks": [
        { "type": "card", "settings": { "title": "Strength Training" } },
        { "type": "card", "settings": { "title": "Cardio Training" } },
        { "type": "card", "settings": { "title": "Flexibility Training" } },
        { "type": "card", "settings": { "title": "Family Fun" } }
      ]
    }
  ]
}
{% endschema %}
