{%- liquid
  assign sid = section.id
  assign sc = section.settings
-%}

{% style %}
  .bcb-{{ sid }} {
    background: {{ sc.bg_color }};
    padding: {{ sc.padding_y }}px 0;
  }
  .bcb-{{ sid }} .bcb__row {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px 16px;
    text-align: center;
  }
  .bcb-{{ sid }} .bcb__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ sc.gap_number_label }}px;
    min-width: 0;
  }
  .bcb-{{ sid }} .bcb__number {
    color: {{ sc.number_color }};
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-size: {{ sc.number_size_mobile }}px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -1px;
    white-space: nowrap;
    margin: 0;
  }
  .bcb-{{ sid }} .bcb__label {
    color: {{ sc.label_color }};
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-size: {{ sc.label_size_mobile }}px;
    line-height: 1.3;
    font-weight: 500;
    margin: 0;
  }

  @media (min-width: 600px) {
    .bcb-{{ sid }} .bcb__row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px 32px;
    }
  }

  @media (min-width: 768px) {
    .bcb-{{ sid }} .bcb__number {
      font-size: {{ sc.number_size_desktop }}px;
    }
    .bcb-{{ sid }} .bcb__label {
      font-size: {{ sc.label_size_desktop }}px;
    }
  }
{% endstyle %}

<section class="bcb-{{ sid }}" aria-label="Brand credentials" {{ section.shopify_attributes }}>
  <dl class="bcb__row">
    {%- if sc.number_1 != blank or sc.label_1 != blank -%}
      <div class="bcb__item">
        {%- if sc.number_1 != blank -%}
          <dt class="bcb__number">{{ sc.number_1 | escape }}</dt>
        {%- endif -%}
        {%- if sc.label_1 != blank -%}
          <dd class="bcb__label">{{ sc.label_1 | escape }}</dd>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if sc.number_2 != blank or sc.label_2 != blank -%}
      <div class="bcb__item">
        {%- if sc.number_2 != blank -%}
          <dt class="bcb__number">{{ sc.number_2 | escape }}</dt>
        {%- endif -%}
        {%- if sc.label_2 != blank -%}
          <dd class="bcb__label">{{ sc.label_2 | escape }}</dd>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if sc.number_3 != blank or sc.label_3 != blank -%}
      <div class="bcb__item">
        {%- if sc.number_3 != blank -%}
          <dt class="bcb__number">{{ sc.number_3 | escape }}</dt>
        {%- endif -%}
        {%- if sc.label_3 != blank -%}
          <dd class="bcb__label">{{ sc.label_3 | escape }}</dd>
        {%- endif -%}
      </div>
    {%- endif -%}
  </dl>
</section>

{% schema %}
{
  "name": "Brand credentials bar",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Stat 1"
    },
    {
      "type": "text",
      "id": "number_1",
      "label": "Number",
      "default": "30+"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Label",
      "default": "years experience"
    },
    {
      "type": "header",
      "content": "Stat 2"
    },
    {
      "type": "text",
      "id": "number_2",
      "label": "Number",
      "default": "30+"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Label",
      "default": "patents"
    },
    {
      "type": "header",
      "content": "Stat 3"
    },
    {
      "type": "text",
      "id": "number_3",
      "label": "Number",
      "default": "2,000+"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Label",
      "default": "verified reviews"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "number_size_desktop",
      "min": 32,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Number size (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "number_size_mobile",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Number size (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "label_size_desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Label size (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "label_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Label size (mobile)",
      "default": 13
    },
    {
      "type": "range",
      "id": "gap_number_label",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Space between number and label",
      "default": 6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#eeeeee"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number color",
      "default": "#eb701f"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#1a1c1c"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 24,
      "max": 128,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Brand credentials bar",
      "category": "Trust & social proof"
    }
  ]
}
{% endschema %}
