<section
  class="section product-colorways"
  data-section-id="{{ section.id }}"
  data-section-type="product-colorways"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- liquid
      assign heading_raw = product.metafields.custom.colorways_heading.value | default: section.settings.heading_text
      assign heading_normalized = heading_raw | replace: '</hight>', '<high>' | replace: '</high>', '<high>' | replace: '<hight>', '<high>'
      assign heading_parts = heading_normalized | split: '<high>'

      assign description_text = product.metafields.custom.colorways_description.value | default: section.settings.description_text
    -%}

    <div class="colorways-content">
      {%- if heading_raw != blank -%}
        <h2 class="colorways-heading">
          {%- for part in heading_parts -%}
            {%- assign idx_mod = forloop.index0 | modulo: 2 -%}
            {%- if idx_mod == 1 -%}
              <span class="highlight-text">{{ part }}</span>
            {%- else -%}
              {{ part }}
            {%- endif -%}
          {%- endfor -%}
        </h2>
      {%- endif -%}

      {%- if description_text != blank -%}
        <div class="colorways-description">
          {%- assign description_lines = description_text | newline_to_br | split: '<br />' -%}
          {%- for line in description_lines -%}
            {%- assign line_trim = line | strip -%}
            {%- if line_trim != blank -%}
              <p>{{ line_trim }}</p>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .product-colorways {
    background-color: #fff;
  }

  .colorways-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .colorways-heading {
    font-family: 'Barlow'
    , sans-serif !important;
    font-weight: 700 !important;
    font-size: {{ section.settings.heading_font_size | default: 32 }}px;
    line-height: 1.1;
    letter-spacing: 0;
    color: #000000;
    margin: 0 0 24px;
  }

  .highlight-text {
    color: #EB701F;
  }

  .colorways-description {
    font-family: 'Barlow'
    , sans-serif !important;
    letter-spacing: 0;
    color: #000;
  }

  .colorways-description p {
    margin: 0 0 8px;
    font-family: Barlow;

    font-style: Medium;
    font-size: {{ section.settings.description_font_size | default: 20 }}
    px !important;
    leading-trim: NONE;
    line-height: 1.24;
    letter-spacing: 0;
    text-align: center;

  }

  .colorways-description p:last-child {
    margin-bottom: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .colorways-heading {
      font-size: {{ section.settings.mobile_heading_font_size | default: 28 }}px;
      line-height: 1.1;
      margin-bottom: 20px;
    }

    /* Mobile: transforma parágrafos em texto contínuo */
    .colorways-description {
      font-family: Barlow;

      font-style: Medium;
      font-size: {{ section.settings.mobile_description_font_size | default: 18 }}
      px !important;
      leading-trim: NONE;
      line-height: 1.3;
      letter-spacing: 0;
      text-align: center;
    }

    .colorways-description p {
      display: inline;
      margin: 0;
      font-size: {{ section.settings.mobile_description_font_size | default: 18 }}
      px !important;
    }

    .colorways-description p:not(:last-child):after {
      content: " ";
    }
  }

  @media (max-width: 480px) {
    .colorways-heading {
      font-size: 24px;
      line-height: 1.1;
    }

    /* Telas menores: ajusta font-size */
    .colorways-description {
      font-size: 16px !important;
      line-height: 1.2;
    }
  }
</style>

{% schema %}
  {
    "name": "Product Colorways",
    "settings": [
      {
        "type": "header",
        "content": "Heading (fallback)"
      },
      {
        "type": "paragraph",
        "content": "Used when product has no value in custom.colorways_heading. Wrap highlighted words with <high>...</high>. Example: Sleek Style: <high>Sunrise</high> & <high>Midnight</high>"
      },
      {
        "type": "text",
        "id": "heading_text",
        "label": "Heading Text",
        "default": "Sleek Style: <high>Sunrise</high> & <high>Midnight</high>"
      },
      {
        "type": "header",
        "content": "Description (fallback)"
      },
      {
        "type": "paragraph",
        "content": "Used when product has no value in custom.colorways_description. Each line break creates a new paragraph."
      },
      {
        "type": "textarea",
        "id": "description_text",
        "label": "Description Text",
        "default": "Say goodbye to cold, industrial equipment.\nWith \"Sunrise\" & \"Midnight\" colorways, Spark dumbbell\nis a stylish piece of your home decor."
      },
      {
        "type": "header",
        "content": "Typography Settings"
      }, {
        "type": "range",
        "id": "heading_font_size",
        "min": 20,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "Heading Font Size",
        "default": 32,
        "info": "Font size for the main heading"
      }, {
        "type": "range",
        "id": "description_font_size",
        "min": 14,
        "max": 32,
        "step": 1,
        "unit": "px",
        "label": "Description Font Size",
        "default": 20,
        "info": "Font size for description paragraphs"
      }, {
        "type": "header",
        "content": "Mobile Typography Settings"
      }, {
        "type": "range",
        "id": "mobile_heading_font_size",
        "min": 16,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Mobile Heading Font Size",
        "default": 28,
        "info": "Font size for the main heading on mobile (<768px)"
      }, {
        "type": "range",
        "id": "mobile_description_font_size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Mobile Description Font Size",
        "default": 18,
        "info": "Font size for description paragraphs on mobile (<768px)"
      }, {
        "type": "header",
        "content": "Spacing Settings"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding top",
        "default": 60
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding bottom",
        "default": 60
      }
    ],
    "presets": [
      {
        "category": "Product",
        "name": "Product Colorways",
        "settings": {
          "heading_text": "Sleek Style: <high>Sunrise</high> & <high>Midnight</high>",
          "description_text": "Say goodbye to cold, industrial equipment.\nWith \"Sunrise\" & \"Midnight\" colorways, Spark dumbbell\nis a stylish piece of your home decor.",
          "heading_font_size": 32,
          "description_font_size": 20,
          "mobile_heading_font_size": 28,
          "mobile_description_font_size": 18
        }
      }
    ]
  }
{% endschema %}