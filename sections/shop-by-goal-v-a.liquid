{%- liquid
  assign sid = section.id
  assign sc = section.settings
  assign accent = sc.tab_active_bg | default: '#eb701f'
-%}

{% style %}
  .sbg-{{ sid }} {
    background: {{ sc.background_color }};
    padding: {{ sc.padding_top }}px 0 {{ sc.padding_bottom }}px;
  }
  .sbg-{{ sid }} .sbg__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .sbg-{{ sid }} .sbg__title {
    margin: 0 0 14px;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-weight: 900;
    font-size: 30px;
    line-height: 1.3;
    letter-spacing: -1px;
    text-transform: uppercase;
    text-align: center;
    color: {{ sc.title_color }};
  }
  .sbg-{{ sid }} .sbg__tabs {
    display: flex;
    flex-wrap: nowrap;
    gap: 8px;
    margin: 24px 0;
    overflow-x: auto;
    padding: 4px 0;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .sbg-{{ sid }} .sbg__tabs::-webkit-scrollbar { display: none; }
  .sbg-{{ sid }} .sbg__tab {
    flex-shrink: 0;
    padding: 10px 18px;
    border: 0;
    border-radius: 999px;
    background: {{ sc.tab_inactive_bg }};
    color: {{ sc.tab_inactive_text }};
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-weight: 700;
    font-size: 13px;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }
  .sbg-{{ sid }} .sbg__tab[aria-selected="true"] {
    background: {{ accent }};
    color: {{ sc.tab_active_text }};
  }
  .sbg-{{ sid }} .sbg__panel[hidden] { display: none; }
  .sbg-{{ sid }} .sbg__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .sbg-{{ sid }} .sbg__override {
    text-align: center;
    padding: 48px 16px;
  }
  .sbg-{{ sid }} .sbg__override-cta {
    display: inline-block;
    padding: 14px 28px;
    background: {{ accent }};
    color: {{ sc.tab_active_text }};
    border-radius: 4px;
    text-decoration: none;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
  }
  .sbg-{{ sid }} .sbg__view-all {
    margin-top: 24px;
    text-align: center;
  }
  .sbg-{{ sid }} .sbg__view-all a {
    color: {{ accent }};
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* Product card — scoped copy of product-card-simple, matches collection page */
  .sbg-{{ sid }} .product-card-simple__card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 10px;
    overflow: hidden;
    height: 100%;
  }
  .sbg-{{ sid }} .product-card-simple__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .sbg-{{ sid }} .product-card-simple__image {
    position: relative;
    background: #f2f2f2;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 10px;
  }
  .sbg-{{ sid }} .product-card-simple__image img,
  .sbg-{{ sid }} .product-card-simple__image svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .sbg-{{ sid }} .product-card-simple__discount-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 6px 12px;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    background: {{ accent }};
    border-radius: 999px;
    line-height: 1;
    z-index: 1;
  }
  .sbg-{{ sid }} .product-card-simple__content {
    padding: 14px 4px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .sbg-{{ sid }} .product-card-simple__title {
    margin: 0;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    color: #1a1c1c;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sbg-{{ sid }} .product-card-simple__title a {
    color: inherit;
    text-decoration: none;
  }
  .sbg-{{ sid }} .product-card-simple__variants {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .sbg-{{ sid }} .product-card-simple__variant-btn {
    width: 30px;
    height: 30px;
    padding: 0;
    border: 2px solid #e5e5e5;
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
    overflow: hidden;
  }
  .sbg-{{ sid }} .product-card-simple__variant-btn--selected,
  .sbg-{{ sid }} .product-card-simple__variant-btn:hover {
    border-color: {{ accent }};
  }
  .sbg-{{ sid }} .product-card-simple__variant-btn-inner {
    display: block;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }
  .sbg-{{ sid }} .product-card-simple__price {
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: #1a1c1c;
  }
  .sbg-{{ sid }} .product-card-simple__price-current { color: {{ accent }}; }
  .sbg-{{ sid }} .product-card-simple__price-compare {
    margin-left: 6px;
    color: #888;
    font-weight: 500;
    text-decoration: line-through;
    font-size: 0.9em;
  }
  .sbg-{{ sid }} .product-card-simple__rating {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: #1a1c1c;
  }
  .sbg-{{ sid }} .product-card-simple__stars { color: #ddd; }
  .sbg-{{ sid }} .product-card-simple__star--active { color: {{ accent }}; }
  .sbg-{{ sid }} .product-card-simple__form {
    margin-top: auto;
  }
  .sbg-{{ sid }} .product-card-simple__atc {
    width: 100%;
    padding: 11px 14px;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    color: #fff;
    background: {{ accent }};
    border: 0;
    border-radius: 8px;
    cursor: pointer;
  }
  .sbg-{{ sid }} .product-card-simple__atc:disabled {
    background: #ccc;
    cursor: not-allowed;
  }

  @media (min-width: 768px) {
    .sbg-{{ sid }} .sbg__title { font-size: 36px; margin-bottom: 24px; }
    .sbg-{{ sid }} .sbg__grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .sbg-{{ sid }} .product-card-simple__title { font-size: 15px; }
    .sbg-{{ sid }} .product-card-simple__price { font-size: 15px; }
  }

  @media (min-width: 990px) {
    .sbg-{{ sid }} .sbg__grid {
      grid-template-columns: repeat({{ sc.columns_desktop }}, 1fr);
    }
  }
{% endstyle %}

<section class="sbg-{{ sid }}" data-sbg {{ section.shopify_attributes }}>
  <div class="sbg__inner">
    {%- if sc.title != blank -%}
      <h2 class="sbg__title">{{ sc.title | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sbg__tabs" role="tablist" aria-label="Shop by goal">
        {%- for block in section.blocks -%}
          {%- if block.type == 'goal_tab' -%}
            <button
              type="button"
              role="tab"
              class="sbg__tab"
              id="sbg-tab-{{ sid }}-{{ forloop.index0 }}"
              aria-controls="sbg-panel-{{ sid }}-{{ forloop.index0 }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}>
              {{ block.settings.label | escape }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'goal_tab' -%}
          {%- liquid
            assign tab_index = forloop.index0
            assign max_products = block.settings.max_products | default: 4
            assign collection = collections[block.settings.collection]
            assign handles_raw = block.settings.product_handles | default: ''
            assign override_link = block.settings.override_link
            assign tab_kind = 'empty'
            if override_link != blank
              assign tab_kind = 'override'
            elsif handles_raw != blank
              assign tab_kind = 'handles'
            elsif collection != empty and collection.products.size > 0
              assign tab_kind = 'collection'
            endif
          -%}
          <div
            class="sbg__panel"
            id="sbg-panel-{{ sid }}-{{ tab_index }}"
            role="tabpanel"
            aria-labelledby="sbg-tab-{{ sid }}-{{ tab_index }}"
            {% unless forloop.first %}hidden{% endunless %}>

            {%- if tab_kind == 'override' -%}
              <div class="sbg__override">
                <a class="sbg__override-cta" href="{{ override_link }}">{{ block.settings.label | escape }}</a>
              </div>

            {%- elsif tab_kind == 'handles' -%}
              <div class="sbg__grid">
                {%- assign handles = handles_raw | split: ',' -%}
                {%- for handle_raw in handles limit: max_products -%}
                  {%- assign handle = handle_raw | strip -%}
                  {%- assign p = all_products[handle] -%}
                  {%- if p != blank -%}
                    {%- render 'product-card-simple', product: p, show_reviews: sc.show_reviews -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- elsif tab_kind == 'collection' -%}
              <div class="sbg__grid">
                {%- for p in collection.products limit: max_products -%}
                  {%- render 'product-card-simple', product: p, show_reviews: sc.show_reviews -%}
                {%- endfor -%}
              </div>
              {%- if collection.products.size > max_products -%}
                <div class="sbg__view-all">
                  <a href="{{ collection.url }}">View all →</a>
                </div>
              {%- endif -%}

            {%- else -%}
              <div class="sbg__override">
                <p style="margin:0 0 16px;color:#666;">No products yet.</p>
                <a class="sbg__override-cta" href="/collections/all">Browse all</a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<script>
(function(){
  var root = document.currentScript.previousElementSibling;
  while (root && root.getAttribute && !root.matches('[data-sbg]')) root = root.previousElementSibling;
  if (!root || !root.matches) return;
  var tabs = root.querySelectorAll('[role="tab"]');
  var panels = root.querySelectorAll('[role="tabpanel"]');
  function activate(idx) {
    for (var i = 0; i < tabs.length; i++) {
      var on = i === idx;
      tabs[i].setAttribute('aria-selected', on ? 'true' : 'false');
      tabs[i].setAttribute('tabindex', on ? '0' : '-1');
      if (on) panels[i].removeAttribute('hidden');
      else panels[i].setAttribute('hidden', '');
    }
  }
  for (var i = 0; i < tabs.length; i++) {
    (function(idx){
      tabs[idx].addEventListener('click', function(){ activate(idx); });
      tabs[idx].addEventListener('keydown', function(e){
        var max = tabs.length - 1, next = -1;
        if (e.key === 'ArrowRight') next = idx === max ? 0 : idx + 1;
        else if (e.key === 'ArrowLeft') next = idx === 0 ? max : idx - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = max;
        if (next >= 0) { e.preventDefault(); activate(next); tabs[next].focus(); }
      });
    })(i);
  }
})();
</script>

{% schema %}
{
  "name": "Shop by Goal",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Shop by Goal"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show review stars",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tab_active_bg",
      "label": "Active tab / accent",
      "default": "#eb701f"
    },
    {
      "type": "color",
      "id": "tab_active_text",
      "label": "Active tab text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tab_inactive_bg",
      "label": "Inactive tab background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "tab_inactive_text",
      "label": "Inactive tab text",
      "default": "#1a1c1c"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 128,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 128,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "goal_tab",
      "name": "Goal tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Tab"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Auto-pulls products from this collection."
        },
        {
          "type": "text",
          "id": "product_handles",
          "label": "Manual products (comma-separated handles)",
          "info": "Use when no collection. Example: product-a,product-b"
        },
        {
          "type": "range",
          "id": "max_products",
          "min": 2,
          "max": 8,
          "step": 1,
          "label": "Max products to show",
          "default": 4
        },
        {
          "type": "url",
          "id": "override_link",
          "label": "Override link (CTA only)",
          "info": "When set, this tab shows only a CTA button (no products)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Goal",
      "blocks": [
        { "type": "goal_tab", "settings": { "label": "Best Sellers" } },
        { "type": "goal_tab", "settings": { "label": "Strength" } },
        { "type": "goal_tab", "settings": { "label": "Cardio" } }
      ]
    }
  ]
}
{% endschema %}
