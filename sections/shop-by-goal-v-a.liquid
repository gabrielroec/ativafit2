{%- liquid
  assign sid = 'shop-by-goal-va-' | append: section.id
  assign mobile_layout = section.settings.mobile_layout | default: 'carousel'

  assign grid_class = 'shop-by-goal-va__grid'
  if mobile_layout == 'carousel'
    assign grid_class_mobile = 'shop-by-goal-va__grid--m-carousel'
  else
    assign grid_class_mobile = 'shop-by-goal-va__grid--m-grid2'
  endif
-%}

<link rel="preload" as="style" href="{{ 'shop-by-goal-v-a.css' | asset_url }}" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'shop-by-goal-v-a.css' | asset_url }}"></noscript>
<script src="{{ 'shop-by-goal-v-a.js' | asset_url }}" defer></script>

<section
  id="{{ sid }}"
  class="shop-by-goal-va"
  data-section-type="shop-by-goal-v-a"
  data-shop-by-goal
  style="
    --sbg-bg: {{ section.settings.background_color }};
    --sbg-pad-top: {{ section.settings.padding_top }}px;
    --sbg-pad-bottom: {{ section.settings.padding_bottom }}px;
    --sbg-title-color: {{ section.settings.title_color }};
    --sbg-subtitle-color: {{ section.settings.subtitle_color }};
    --sbg-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --sbg-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --sbg-pill-pad: {{ section.settings.tab_pill_padding }}px;
    --sbg-pill-bg: {{ section.settings.tab_pill_bg }};
    --sbg-pill-radius: {{ section.settings.tab_pill_radius }}px;
    --sbg-tab-radius: {{ section.settings.tab_item_radius }}px;
    --sbg-tab-inactive: {{ section.settings.tab_inactive_text }};
    --sbg-accent: {{ section.settings.tab_active_bg }};
    --sbg-tab-active-text: {{ section.settings.tab_active_text }};
    --sbg-cols-desktop: {{ section.settings.columns_desktop }};
    --sbg-cols-tablet: {{ section.settings.columns_tablet }};
    --sbg-grid-gap: {{ section.settings.grid_gap }}px;
  ">
  <div class="shop-by-goal-va__container">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <header class="shop-by-goal-va__header">
        {%- if section.settings.title != blank -%}
          <h2 class="shop-by-goal-va__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="shop-by-goal-va__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- comment -%} First pass: render tabs (carousel rolável por swipe/drag) {%- endcomment -%}
      {%- assign active_tab_assigned = false -%}
      <div class="shop-by-goal-va__tabs-row">
        <div
          class="shop-by-goal-va__tabs"
          role="tablist"
          aria-label="{{ section.settings.tablist_label | default: 'Shop by goal categories' | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_link = false
            if block.settings.override_link != blank
              assign is_link = true
            endif
            assign tab_id = sid | append: '-tab-' | append: forloop.index
            assign panel_id = sid | append: '-panel-' | append: forloop.index

            assign is_active = false
            unless is_link
              unless active_tab_assigned
                assign is_active = true
                assign active_tab_assigned = true
              endunless
            endunless
          -%}

          {%- if is_link -%}
            <a
              href="{{ block.settings.override_link }}"
              class="shop-by-goal-va__tab shop-by-goal-va__tab--link"
              {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                <span class="shop-by-goal-va__tab-icon" aria-hidden="true">
                  {%- render 'shop-by-goal-v-a-icon', icon: block.settings.icon -%}
                </span>
              {%- endif -%}
              <span class="shop-by-goal-va__tab-label">{{ block.settings.label | escape }}</span>
            </a>
          {%- else -%}
            <button
              type="button"
              role="tab"
              id="{{ tab_id }}"
              aria-controls="{{ panel_id }}"
              aria-selected="{% if is_active %}true{% else %}false{% endif %}"
              tabindex="{% if is_active %}0{% else %}-1{% endif %}"
              class="shop-by-goal-va__tab"
              {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                <span class="shop-by-goal-va__tab-icon" aria-hidden="true">
                  {%- render 'shop-by-goal-v-a-icon', icon: block.settings.icon -%}
                </span>
              {%- endif -%}
              <span class="shop-by-goal-va__tab-label">{{ block.settings.label | escape }}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Second pass: render panels (only for non-link blocks) {%- endcomment -%}
      {%- assign active_panel_assigned = false -%}
      <div class="shop-by-goal-va__panels">
        {%- for block in section.blocks -%}
          {%- if block.settings.override_link == blank -%}
            {%- liquid
              assign tab_id = sid | append: '-tab-' | append: forloop.index
              assign panel_id = sid | append: '-panel-' | append: forloop.index

              assign is_active = false
              unless active_panel_assigned
                assign is_active = true
                assign active_panel_assigned = true
              endunless

              assign default_limit = section.settings.max_products_default | default: 4
              assign limit_n = block.settings.max_products | default: 0
              if limit_n == 0
                assign limit_n = default_limit
              endif

              assign coll = collections[block.settings.collection]
              assign mp1 = block.settings.product_1
              assign mp2 = block.settings.product_2
              assign mp3 = block.settings.product_3
              assign mp4 = block.settings.product_4
              assign use_manual_products = false
              if mp1 != blank or mp2 != blank or mp3 != blank or mp4 != blank
                assign use_manual_products = true
              endif
            -%}

            {%- comment -%}
              Active panel renders its product cards immediately (visible on
              first paint, contributes to LCP candidates if hero hadn't won).
              Inactive panels render their card markup inside a <template>,
              which keeps the HTML reachable for SEO/Theme Editor but skips
              image downloads, JS init, and DOM cost until the user clicks
              the tab. Hydration: on first tab activation, we replace the
              <template> with its content (clones the DocumentFragment).
            {%- endcomment -%}
            <div
              id="{{ panel_id }}"
              role="tabpanel"
              aria-labelledby="{{ tab_id }}"
              class="shop-by-goal-va__panel"
              {% unless is_active %}hidden{% endunless %}
              {% unless is_active %}data-shop-goal-deferred="1"{% endunless %}
              tabindex="0">
              {%- capture panel_inner -%}
                {%- if use_manual_products -%}
                  {%- assign manual_shown = 0 -%}
                  <ul class="{{ grid_class }} {{ grid_class_mobile }}" role="list">
                    {%- if mp1 != blank and manual_shown < limit_n -%}
                      <li class="shop-by-goal-va__item">
                        {%- render 'product-card-simple', product: mp1, show_reviews: section.settings.show_reviews -%}
                      </li>
                      {%- assign manual_shown = manual_shown | plus: 1 -%}
                    {%- endif -%}
                    {%- if mp2 != blank and manual_shown < limit_n -%}
                      <li class="shop-by-goal-va__item">
                        {%- render 'product-card-simple', product: mp2, show_reviews: section.settings.show_reviews -%}
                      </li>
                      {%- assign manual_shown = manual_shown | plus: 1 -%}
                    {%- endif -%}
                    {%- if mp3 != blank and manual_shown < limit_n -%}
                      <li class="shop-by-goal-va__item">
                        {%- render 'product-card-simple', product: mp3, show_reviews: section.settings.show_reviews -%}
                      </li>
                      {%- assign manual_shown = manual_shown | plus: 1 -%}
                    {%- endif -%}
                    {%- if mp4 != blank and manual_shown < limit_n -%}
                      <li class="shop-by-goal-va__item">
                        {%- render 'product-card-simple', product: mp4, show_reviews: section.settings.show_reviews -%}
                      </li>
                      {%- assign manual_shown = manual_shown | plus: 1 -%}
                    {%- endif -%}
                  </ul>
                {%- elsif coll != blank and coll.products.size > 0 -%}
                  <ul class="{{ grid_class }} {{ grid_class_mobile }}" role="list">
                    {%- for product in coll.products limit: limit_n -%}
                      <li class="shop-by-goal-va__item">
                        {%- render 'product-card-simple',
                          product: product,
                          show_reviews: section.settings.show_reviews
                        -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <div class="shop-by-goal-va__empty" role="status">
                    <p class="shop-by-goal-va__empty-text">
                      {{- section.settings.empty_text | default: 'No products yet.' | escape -}}
                    </p>
                    {%- if section.settings.empty_link != blank -%}
                      <a href="{{ section.settings.empty_link }}" class="shop-by-goal-va__empty-cta">
                        {{- section.settings.empty_cta_label | default: 'Browse all' | escape -}}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endcapture -%}
              {%- if is_active -%}
                {{ panel_inner }}
              {%- else -%}
                <template data-shop-goal-template>{{ panel_inner }}</template>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="shop-by-goal-va__empty-state" role="status">
        <p>{{ 'Add tabs in the theme editor to display collections here.' }}</p>
      </div>
    {%- endif -%}
  </div>
</section>


{% schema %}
{
  "name": "Shop by Goal V.A",
  "tag": "section",
  "class": "section-shop-by-goal-v-a",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop by Goal"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "tablist_label",
      "label": "Tablist accessibility label",
      "default": "Shop by goal categories",
      "info": "Read by screen readers to describe the tab group."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns (tablet)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "carousel", "label": "Carousel (swipe)" },
        { "value": "grid2", "label": "Grid 2 columns" }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "max_products_default",
      "label": "Default products per tab",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 4,
      "info": "Can be overridden per block."
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show product reviews",
      "default": false
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Title size (desktop)",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title size (mobile)",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Tab pill"
    },
    {
      "type": "range",
      "id": "tab_pill_padding",
      "label": "Pill inner padding",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "tab_pill_radius",
      "label": "Pill border radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "tab_item_radius",
      "label": "Active tab border radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle",
      "default": "#574237"
    },
    {
      "type": "color",
      "id": "tab_pill_bg",
      "label": "Tab pill background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "tab_inactive_text",
      "label": "Tab (inactive) text",
      "default": "#1a1c1c"
    },
    {
      "type": "color",
      "id": "tab_active_bg",
      "label": "Tab (active) background",
      "default": "#eb701f"
    },
    {
      "type": "color",
      "id": "tab_active_text",
      "label": "Tab (active) text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Empty state"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty text",
      "default": "No products yet."
    },
    {
      "type": "text",
      "id": "empty_cta_label",
      "label": "Empty CTA label",
      "default": "Browse all"
    },
    {
      "type": "url",
      "id": "empty_link",
      "label": "Empty CTA link"
    }
  ],
  "blocks": [
    {
      "type": "goal_tab",
      "name": "Tab",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Best Sellers"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "bestsellers", "label": "Best sellers (trophy)" },
            { "value": "strength", "label": "Strength (dumbbell)" },
            { "value": "cardio", "label": "Cardio (heart)" },
            { "value": "flexibility", "label": "Flexibility (yoga)" },
            { "value": "family", "label": "Family fun (ball)" },
            { "value": "all-collections", "label": "Shop all (cart)" }
          ],
          "default": "none"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Usada quando nenhum produto manual está definido abaixo. Deixe vazio se esta aba só usar produtos manuais ou link."
        },
        {
          "type": "header",
          "content": "Produtos manuais (opcional)"
        },
        {
          "type": "paragraph",
          "content": "Se escolher um ou mais produtos, esta aba mostra só eles (nesta ordem), até o limite \"Max products\". Ignora a coleção acima."
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },
        {
          "type": "range",
          "id": "max_products",
          "label": "Max products (override)",
          "min": 0,
          "max": 16,
          "step": 1,
          "default": 0,
          "info": "0 = use section default."
        },
        {
          "type": "header",
          "content": "Link mode (optional)"
        },
        {
          "type": "url",
          "id": "override_link",
          "label": "Override link",
          "info": "If filled, this tab becomes a plain navigation link (no collection panel). Ideal for 'shop all'."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Goal V.A",
      "category": "Collections",
      "blocks": [
        { "type": "goal_tab", "settings": { "label": "Best Sellers" } },
        { "type": "goal_tab", "settings": { "label": "Strength Training" } },
        { "type": "goal_tab", "settings": { "label": "Cardio Training" } },
        { "type": "goal_tab", "settings": { "label": "Flexibility Training" } },
        { "type": "goal_tab", "settings": { "label": "Family Fun" } },
        { "type": "goal_tab", "settings": { "label": "shop all" } }
      ]
    }
  ]
}
{% endschema %}
