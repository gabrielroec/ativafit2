{%- liquid
  assign sid = 'why-dumbbells-' | append: section.id
  assign wds_has_demo_video = false
  if section.settings.demo_video != blank
    assign wds_has_demo_video = true
    assign wds_demo_video = section.settings.demo_video
  endif
-%}

<link rel="preload" as="style" href="{{ 'why-dumbbells-stand-out.css' | asset_url }}" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'why-dumbbells-stand-out.css' | asset_url }}"></noscript>
<script src="{{ 'why-dumbbells-stand-out.js' | asset_url }}" defer></script>

<section
  id="{{ sid }}"
  class="why-dumbbells-stand-out"
  data-section-type="why-dumbbells-stand-out"
  data-why-dumbbells
  style="
    --wds-section-bg: {{ section.settings.section_bg }};
    --wds-card-bg: {{ section.settings.card_bg }};
    --wds-icon-color: {{ section.settings.icon_color }};
    --wds-heading-color: {{ section.settings.heading_color }};
    --wds-body-color: {{ section.settings.body_color }};
    --wds-pad-top: {{ section.settings.padding_top }}px;
    --wds-pad-bottom: {{ section.settings.padding_bottom }}px;
    --wds-grid-margin-bottom: {{ section.settings.grid_margin_bottom }}px;
    --wds-card-title-size: {{ section.settings.card_title_size }}px;
    --wds-card-text-size: {{ section.settings.card_text_size }}px;
    --wds-video-margin-top: {{ section.settings.video_margin_top }}px;
    --wds-video-shell-max-width: {{ section.settings.video_shell_max_width | default: 820 }}px;
  ">
  <div class="why-dumbbells-stand-out__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="why-dumbbells-stand-out__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="why-dumbbells-stand-out__carousel" data-wds-carousel>
        <div class="why-dumbbells-stand-out__grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="why-dumbbells-stand-out__card" {{ block.shopify_attributes }}>
                <div class="why-dumbbells-stand-out__card-inner">
                  {%- liquid
                    assign wds_icon_sym = block.settings.icon_custom | strip
                    if wds_icon_sym == blank
                      assign wds_icon_sym = block.settings.icon | default: 'widgets'
                    endif
                  -%}
                  {%- if block.settings.icon_image != blank -%}
                    <span class="why-dumbbells-stand-out__icon why-dumbbells-stand-out__icon--custom" aria-hidden="true">
                      {%- comment -%}
                        Os 4 ícones (12-in-1, quick-weight-changes, build-to-last,
                        secure-stable) são PNGs com transparência. format: 'webp'
                        usa lossy WebP com alpha channel — economiza ~60-70% vs PNG
                        sem perda visual em ícones desse tamanho.
                        fetchpriority: 'low' libera banda pro LCP.
                      {%- endcomment -%}
                      {{
                        block.settings.icon_image
                        | image_url: width: 128, format: 'webp'
                        | image_tag:
                          loading: 'lazy',
                          decoding: 'async',
                          fetchpriority: 'low',
                          widths: '48, 64, 96, 128',
                          sizes: '40px',
                          class: 'why-dumbbells-stand-out__icon-img',
                          alt: ''
                      }}
                    </span>
                  {%- elsif wds_icon_sym != blank -%}
                    <span
                      class="why-dumbbells-stand-out__icon why-dumbbells-stand-out__icon--inline"
                      aria-hidden="true">{%- render 'inline-icon', name: wds_icon_sym, class: 'why-dumbbells-stand-out__icon-svg', size: 26 -%}</span>
                  {%- endif -%}
                  <div class="why-dumbbells-stand-out__card-text">
                    {%- if block.settings.title != blank -%}
                      <h3 class="why-dumbbells-stand-out__card-title">{{ block.settings.title | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <p class="why-dumbbells-stand-out__card-desc">{{ block.settings.text | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="why-dumbbells-stand-out__carousel-ui" data-wds-carousel-ui hidden>
          <div
            class="why-dumbbells-stand-out__dots"
            data-wds-dots
            role="group"
            aria-label="{{ section.settings.carousel_dots_label | default: 'Feature carousel navigation' | escape }}"></div>
        </div>
      </div>
    {%- endif -%}

    <div class="why-dumbbells-stand-out__video">
      <div
        class="why-dumbbells-stand-out__video-shell{% unless wds_has_demo_video %} why-dumbbells-stand-out__video-shell--placeholder{% endunless %}"
        role="region"
        aria-label="{{ section.settings.video_heading | default: 'Product demo video' | escape }}">
        <div
          class="why-dumbbells-stand-out__video-poster{% unless wds_has_demo_video %} why-dumbbells-stand-out__video-poster--static{% endunless %}"
          {% if wds_has_demo_video %}
            data-wds-video-poster
          {% endif %}
          tabindex="-1">
          <div class="why-dumbbells-stand-out__video-poster-bg"></div>
          {%- if section.settings.video_poster != blank -%}
            <div class="why-dumbbells-stand-out__video-poster-img">
              {%- comment -%}
                Lighthouse reportou o poster sendo servido em 1100px num slot
                de 364px (desktop) — reduzido o ladder pra 400/600/900/1200.
                width:1200 base é mais que suficiente pra retina; format:webp
                garante a melhor compressão.
              {%- endcomment -%}
              {{
                section.settings.video_poster
                | image_url: width: 1200, format: 'webp'
                | image_tag: loading: 'lazy', decoding: 'async', fetchpriority: 'low', widths: '400, 600, 900, 1200', sizes: '(min-width: 768px) 80rem, 100vw', alt: ''
              }}
            </div>
          {%- elsif wds_has_demo_video and wds_demo_video.preview_image -%}
            <div class="why-dumbbells-stand-out__video-poster-img">
              {{
                wds_demo_video.preview_image
                | image_url: width: 1200, format: 'webp'
                | image_tag: loading: 'lazy', decoding: 'async', fetchpriority: 'low', widths: '400, 600, 900, 1200', sizes: '(min-width: 768px) 80rem, 100vw', alt: ''
              }}
            </div>
          {%- endif -%}
          <span class="why-dumbbells-stand-out__video-deco why-dumbbells-stand-out__video-deco--inline" aria-hidden="true">{%- render 'inline-icon', name: 'image', size: 96 -%}</span>
          <div class="why-dumbbells-stand-out__video-poster-center">
            <button
              type="button"
              class="why-dumbbells-stand-out__video-play"
              {% if wds_has_demo_video %}
                data-wds-video-play
                aria-label="{{ section.settings.video_play_label | escape }}"
              {% else %}
                disabled
                aria-disabled="true"
                aria-label="{{ section.settings.video_placeholder_aria | default: 'Demo video not available yet' | escape }}"
              {% endif %}>
              <span class="why-dumbbells-stand-out__video-play-inner">
                <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M8 5v14l11-7L8 5z" fill="#ffffff" />
                </svg>
              </span>
            </button>
            {%- unless wds_has_demo_video -%}
              {%- if section.settings.video_placeholder_caption != blank -%}
                <p class="why-dumbbells-stand-out__video-placeholder-caption">{{ section.settings.video_placeholder_caption | escape }}</p>
              {%- endif -%}
            {%- endunless -%}
          </div>
        </div>
        {%- if wds_has_demo_video -%}
          <video
            class="why-dumbbells-stand-out__video-el"
            data-wds-video-el
            controls
            playsinline
            preload="metadata"
            hidden>
            {%- for source in wds_demo_video.sources -%}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          </video>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why dumbbells stand out",
  "tag": "section",
  "class": "section-why-dumbbells-stand-out",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why Ativafit Dumbbells Stand Out"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 22,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading font size",
      "default": 30
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Space below heading",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Card title size",
      "default": 17
    },
    {
      "type": "range",
      "id": "card_text_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Card description size",
      "default": 14
    },
    {
      "type": "range",
      "id": "grid_margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space below grid",
      "default": 48,
      "info": "Space before the video block (when enabled)."
    },
    {
      "type": "header",
      "content": "Mobile carousel"
    },
    {
      "type": "text",
      "id": "carousel_dots_label",
      "label": "Dots — accessibility label",
      "default": "Feature carousel navigation",
      "info": "Shown below the cards on screens up to 767px when there are at least two feature cards."
    },
    {
      "type": "header",
      "content": "Video demo"
    },
    {
      "type": "video",
      "id": "demo_video",
      "label": "Video (MP4 hosted on Shopify)",
      "info": "Optional. Without video, the same look shows as a placeholder (play disabled). Below the benefits grid."
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Poster image (optional)",
      "info": "If empty, uses the video-generated thumbnail; placeholder keeps texture + icon."
    },
    {
      "type": "text",
      "id": "video_heading",
      "label": "Region name (accessibility)",
      "default": "Product demo video",
      "info": "Read by screen readers in the video area."
    },
    {
      "type": "text",
      "id": "video_play_label",
      "label": "Play button label",
      "default": "Play product demo video"
    },
    {
      "type": "text",
      "id": "video_placeholder_aria",
      "label": "Accessibility — disabled button (no video)",
      "default": "Demo video not available yet"
    },
    {
      "type": "text",
      "id": "video_placeholder_caption",
      "label": "Text under play (only when there is no video)",
      "default": "Add a video in this section’s settings to enable playback."
    },
    {
      "type": "range",
      "id": "video_margin_top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Extra space above video",
      "default": 0
    },
    {
      "type": "range",
      "id": "video_shell_max_width",
      "min": 320,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Max video width",
      "default": 820,
      "info": "Caps width and height (16:9) and centers the block. Lower values = smaller video."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#eb701f"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading and card titles",
      "default": "#1a1c1c"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Card description",
      "default": "#888888"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image",
          "info": "Optional. When set, replaces the Material Symbol. Use a square PNG or SVG for best results."
        },
        {
          "type": "text",
          "id": "icon_custom",
          "label": "Custom Material Symbol name",
          "info": "Optional. Any Material Symbols Outlined ligature (e.g. fitness_center, bolt). When filled, overrides the preset below."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Preset icon (Material Symbols)",
          "default": "widgets",
          "info": "Used when custom image and custom name are empty. Original set: widgets, speed, architecture, lock.",
          "options": [
            { "value": "widgets", "label": "widgets — 12-in-1 / grid" },
            { "value": "speed", "label": "speed — fast / dial" },
            { "value": "architecture", "label": "architecture — build / steel" },
            { "value": "lock", "label": "lock — secure / stable" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Short supporting copy for this benefit."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why dumbbells stand out",
      "category": "Storytelling",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "widgets",
            "title": "12-in-1 System",
            "text": "Save up to 80% space compared to traditional dumbbells"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "speed",
            "title": "Quick Weight Changes",
            "text": "Adjust in seconds with smooth dial control"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "architecture",
            "title": "Built to Last",
            "text": "Solid steel construction for long-term durability"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "lock",
            "title": "Secure & Stable",
            "text": "Lock-in design for safe and confident workouts"
          }
        }
      ]
    }
  ]
}
{% endschema %}
