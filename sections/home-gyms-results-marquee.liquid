{%- liquid
  assign hg_id = 'home-gyms-marquee-' | append: section.id
  assign hg_blocks_count = section.blocks.size
  assign hg_duration = section.settings.marquee_seconds | default: 45
  if hg_duration < 12
    assign hg_duration = 12
  endif
  assign hg_strip_cycles = section.settings.strip_cycles | default: 2
  if hg_strip_cycles < 1
    assign hg_strip_cycles = 1
  endif
  if hg_strip_cycles > 8
    assign hg_strip_cycles = 8
  endif
-%}

<link rel="preload" as="style" href="{{ 'home-gyms-results-marquee.css' | asset_url }}" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'home-gyms-results-marquee.css' | asset_url }}"></noscript>
<script src="{{ 'home-gyms-results-marquee.js' | asset_url }}" defer></script>

<section
  id="{{ hg_id }}"
  class="home-gyms-marquee"
  data-section-type="home-gyms-results-marquee"
  data-home-gyms-marquee
  data-hgm-defer-margin="{{ section.settings.defer_init_margin | default: 320 }}"
  style="
    --hgm-bg: {{ section.settings.background_color }};
    --hgm-pad-top: {{ section.settings.padding_top }}px;
    --hgm-pad-bottom: {{ section.settings.padding_bottom }}px;
    --hgm-intro-mb: {{ section.settings.intro_margin_bottom }}px;
    --hgm-subtitle-size: {{ section.settings.subtitle_size }}px;
    --hgm-subtitle-color: {{ section.settings.subtitle_color }};
    --hgm-title-color: {{ section.settings.title_color }};
    --hgm-tag-color: {{ section.settings.tag_text_color }};
    --hgm-card-gap: {{ section.settings.card_gap }}px;
    --hgm-card-radius: {{ section.settings.card_radius }}px;
  ">
  <div class="home-gyms-marquee__inner">
    <div class="home-gyms-marquee__intro">
      {%- if section.settings.title != blank -%}
        <h2 class="home-gyms-marquee__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="home-gyms-marquee__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    <div class="home-gyms-marquee__viewport">
      <div
        class="home-gyms-marquee__track"
        data-home-gyms-track
        style="--hg-duration: {{ hg_duration }}s;">
        <div class="home-gyms-marquee__strip" data-home-gyms-strip>
          {%- if hg_blocks_count > 0 -%}
            {%- for hg_rep in (1..hg_strip_cycles) -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'card' -%}
                  <div
                    class="home-gyms-marquee__cell"
                    {% if hg_rep == 1 %}
                      {{ block.shopify_attributes }}
                    {% endif %}>
                    {%- render 'home-gyms-marquee-card',
                      block: block,
                      section: section,
                      duplicate_strip: false,
                      hg_rep: hg_rep,
                      card_index: forloop.index0
                    -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- else -%}
            {%- for hg_rep in (1..hg_strip_cycles) -%}
              {%- for i in (1..4) -%}
                <div class="home-gyms-marquee__cell">
                  <div class="home-gyms-marquee__card home-gyms-marquee__card--placeholder" style="width: {{ section.settings.card_width }}px;">
                    <div class="home-gyms-marquee__card-frame">
                      <div class="home-gyms-marquee__ph"></div>
                      <div class="home-gyms-marquee__tag-wrap">
                        <span class="home-gyms-marquee__tag">{{ 'Community' | escape }}</span>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="home-gyms-marquee__strip" aria-hidden="true">
          {%- if hg_blocks_count > 0 -%}
            {%- for hg_rep in (1..hg_strip_cycles) -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'card' -%}
                  <div class="home-gyms-marquee__cell">
                    {%- render 'home-gyms-marquee-card',
                      block: block,
                      section: section,
                      duplicate_strip: true,
                      hg_rep: hg_rep,
                      card_index: forloop.index0
                    -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- else -%}
            {%- for hg_rep in (1..hg_strip_cycles) -%}
              {%- for i in (1..4) -%}
                <div class="home-gyms-marquee__cell">
                  <div class="home-gyms-marquee__card home-gyms-marquee__card--placeholder" style="width: {{ section.settings.card_width }}px;">
                    <div class="home-gyms-marquee__card-frame">
                      <div class="home-gyms-marquee__ph"></div>
                      <div class="home-gyms-marquee__tag-wrap">
                        <span class="home-gyms-marquee__tag">{{ 'Community' | escape }}</span>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home gyms results marquee",
  "tag": "section",
  "class": "section-home-gyms-results-marquee",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Real Home Gyms. Real Results."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "See how our community trains at home with Ativafit gear"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 52,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 36
    },
    {
      "type": "range",
      "id": "title_sub_gap",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Space title → subtitle",
      "default": 8
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Subtitle size",
      "default": 16
    },
    {
      "type": "range",
      "id": "intro_margin_bottom",
      "min": 32,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Space below intro (before marquee)",
      "default": 64
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#574237"
    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Tag text color",
      "default": "#1a1c1c"
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 220,
      "max": 380,
      "step": 10,
      "unit": "px",
      "label": "Each card width (height follows 9:16)",
      "default": 300,
      "info": "Fixed 9 (width) : 16 (height) ratio — vertical story-style format."
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Gap between cards",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "marquee_seconds",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "s",
      "label": "Full loop duration",
      "default": 50
    },
    {
      "type": "range",
      "id": "strip_cycles",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "List repeats per strip",
      "default": 2,
      "info": "Increase if the strip is shorter than the viewport."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    },
    {
      "type": "header",
      "content": "Performance"
    },
    {
      "type": "range",
      "id": "eager_first_cards",
      "min": 0,
      "max": 6,
      "step": 1,
      "label": "Eager-load first cards (visible strip)",
      "default": 0,
      "info": "First N cards in the first row use high fetch priority and eager loading. IMPORTANT: Keep at 0 if this section is below the fold (it steals fetch priority from the hero image and hurts LCP). Only raise if the marquee is actually the hero/ATF."
    },
    {
      "type": "range",
      "id": "defer_init_margin",
      "min": 0,
      "max": 800,
      "step": 40,
      "unit": "px",
      "label": "Start marquee JS before scroll (margin)",
      "default": 320,
      "info": "IntersectionObserver expands the viewport by this amount so animation and layout run slightly before the section enters the screen. 0 = init only when any part of the section is visible."
    },
    {
      "type": "text",
      "id": "gif_play_label",
      "label": "GIF play button label (accessibility)",
      "default": "Play animation"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image or GIF",
          "info": "PNG, JPG, WebP, or animated GIF. GIFs show a still JPG preview and load the animation only after Play. Heavy GIFs still affect performance after play — prefer short loops or MP4/WebM when possible."
        },
        {
          "type": "url",
          "id": "media_url",
          "label": "Media URL (optional)",
          "info": "If set, replaces the image above. GIF URLs load only after the user taps Play (best performance). Use “GIF poster” for a still preview."
        },
        {
          "type": "image_picker",
          "id": "gif_poster",
          "label": "GIF poster (static)",
          "info": "Optional still image before play. Recommended for GIFs via URL. Uploads from “Image or GIF” use an automatic JPG frame when possible."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "default": "Home gym"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag (hashtag)",
          "default": "#garage gym",
          "info": "e.g. #garage gym — you may include the # or not."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link",
          "info": "When set, the whole card (image + tag) is clickable and opens in a new tab."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home gyms results marquee",
      "category": "Storytelling",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "tag": "#garage gym",
            "image_alt": "Garage gym"
          }
        },
        {
          "type": "card",
          "settings": {
            "tag": "#apartment gym",
            "image_alt": "Apartment gym"
          }
        },
        {
          "type": "card",
          "settings": {
            "tag": "#living room",
            "image_alt": "Living room workout"
          }
        },
        {
          "type": "card",
          "settings": {
            "tag": "#outdoor",
            "image_alt": "Outdoor workout space"
          }
        }
      ]
    }
  ]
}
{% endschema %}
