{%- liquid
  assign section_id = 'BikeLifestyleScenarios-' | append: section.id
-%}

<section id="{{ section_id }}" class="bike-lifestyle">
  <div class="bike-lifestyle__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="bike-lifestyle__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="bike-lifestyle__grid">
      <div class="bike-lifestyle__media">
        {%- if section.settings.image != blank -%}
          {%- assign image_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
          {{
            section.settings.image
            | image_url: width: 1100, format: 'webp'
            | image_tag:
              loading: 'lazy',
              widths: '480, 640, 800, 960, 1100',
              sizes: '(min-width: 990px) 48vw, 100vw',
              alt: image_alt,
              class: 'bike-lifestyle__image'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'bike-lifestyle__placeholder' }}
        {%- endif -%}
      </div>

      <div class="bike-lifestyle__content">
        {%- for block in section.blocks -%}
          <article class="bike-lifestyle__card" {{ block.shopify_attributes }}>
            <div class="bike-lifestyle__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'apartment' -%}
                  <svg viewBox="0 0 24 24" focusable="false"><path d="M5 21V4.8C5 3.8 5.8 3 6.8 3h10.4c1 0 1.8.8 1.8 1.8V21M8 7h2M14 7h2M8 11h2M14 11h2M8 15h2M14 15h2M3.5 21h17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'laptop' -%}
                  <svg viewBox="0 0 24 24" focusable="false"><path d="M5 6.5h14v9H5zM3.5 18h17M8 18l.6-2.5M15.4 15.5L16 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" focusable="false"><path d="M20.3 5.7a5 5 0 0 0-7.1 0L12 6.9l-1.2-1.2a5 5 0 0 0-7.1 7.1L12 21l8.3-8.2a5 5 0 0 0 0-7.1Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </div>

            <div class="bike-lifestyle__card-copy">
              {%- if block.settings.title != blank -%}
                <h3 class="bike-lifestyle__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="bike-lifestyle__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="bike-lifestyle__cta" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    background: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #{{ section_id }} .bike-lifestyle__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 32px;
  }

  #{{ section_id }} .bike-lifestyle__heading {
    margin: 0 0 34px;
    color: #333333;
    font-size: {{ section.settings.heading_size }}px !important;
    line-height: 1.2 !important;
    font-weight: 700 !important;
    letter-spacing: 0;
    text-align: center !important;
  }

  #{{ section_id }} .bike-lifestyle__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.85fr);
    gap: 36px;
    align-items: stretch;
  }

  #{{ section_id }} .bike-lifestyle__media {
    min-height: 100%;
    overflow: hidden;
    border-radius: 12px;
    background: #f5f5f5;
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.08);
  }

  #{{ section_id }} .bike-lifestyle__image,
  #{{ section_id }} .bike-lifestyle__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 430px;
    object-fit: cover;
  }

  #{{ section_id }} .bike-lifestyle__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
  }

  #{{ section_id }} .bike-lifestyle__card {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 20px;
    align-items: center;
    min-height: 126px;
    padding: 22px 26px;
    border: 1px solid #e9e9e9;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.06);
  }

  #{{ section_id }} .bike-lifestyle__icon {
    display: flex;
    width: 58px;
    height: 58px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #eb7122;
    color: #ffffff;
    box-shadow: 0 8px 16px rgba(235, 113, 34, 0.2);
  }

  #{{ section_id }} .bike-lifestyle__icon svg {
    width: 32px;
    height: 32px;
  }

  #{{ section_id }} .bike-lifestyle__title {
    margin: 0 0 6px;
    color: #333333;
    font-size: 15px !important;
    line-height: 1.45 !important;
    font-weight: 700 !important;
    letter-spacing: 0;
  }

  #{{ section_id }} .bike-lifestyle__text {
    color: #333333;
    font-size: 15px !important;
    line-height: 1.45 !important;
    font-weight: 400 !important;
  }

  #{{ section_id }} .bike-lifestyle__text p {
    margin: 0;
    color: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    font-weight: inherit !important;
  }

  #{{ section_id }} .bike-lifestyle__cta {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 8px;
    margin: 4px 0 0 18px;
    color: #eb7122;
    font-size: 14px;
    line-height: 1.2;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (max-width: 989px) {
    #{{ section_id }} .bike-lifestyle__grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    #{{ section_id }} .bike-lifestyle__image,
    #{{ section_id }} .bike-lifestyle__placeholder {
      min-height: 320px;
    }
  }

  @media (max-width: 749px) {
    #{{ section_id }} {
      padding-top: {{ section.settings.padding_top | times: 0.72 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.72 | round }}px;
    }

    #{{ section_id }} .bike-lifestyle__inner {
      padding: 0 16px;
    }

    #{{ section_id }} .bike-lifestyle__heading {
      font-size: {{ section.settings.heading_size_mobile }}px !important;
      margin-bottom: 24px;
    }

    #{{ section_id }} .bike-lifestyle__image,
    #{{ section_id }} .bike-lifestyle__placeholder {
      min-height: 240px;
    }

    #{{ section_id }} .bike-lifestyle__card {
      grid-template-columns: 54px minmax(0, 1fr);
      gap: 14px;
      min-height: 0;
      padding: 18px;
    }

    #{{ section_id }} .bike-lifestyle__icon {
      width: 48px;
      height: 48px;
    }

    #{{ section_id }} .bike-lifestyle__icon svg {
      width: 27px;
      height: 27px;
    }

    #{{ section_id }} .bike-lifestyle__title {
      font-size: 14px !important;
    }

    #{{ section_id }} .bike-lifestyle__text {
      font-size: 14px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Bike lifestyle scenarios",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quiet Cardio That Fits Into Everyday Life"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Compare Models"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size desktop",
      "min": 24,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 22,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1540
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "scenario",
      "name": "Scenario",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "apartment",
          "options": [
            { "value": "apartment", "label": "Apartment" },
            { "value": "laptop", "label": "Laptop" },
            { "value": "heart", "label": "Heart" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Apartment Cardio"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>A compact foldable exercise bike helps you stay active without taking over your living space.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bike lifestyle scenarios"
    }
  ]
}
{% endschema %}
