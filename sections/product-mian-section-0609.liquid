      } else {
        variantId = ProductVariants.variants[0]?.id || {{ product.selected_or_first_available_variant.id }};
      }
      
      const quantity = parseInt(getQuantityInput()?.value || 1);
      const btn = getAddToCartButton();
      
      if (!variantId) {
        alert('Please select a product variant');
        return;
      }

      if (!btn) {
        console.error('Add to cart button not found for section {{ section.id }}');
        return;
      }
      
      // Prevent multiple submissions
      if (btn.dataset.processing === 'true') {
        return;
      }
      
      const originalText = btn.textContent;
      btn.textContent = 'ADDING...';
      btn.disabled = true;
      btn.style.opacity = '0.7';
      btn.dataset.processing = 'true';
      
      // ====================================================================
      // CAPTURE DISCOUNT INFORMATION FROM PDP BEFORE ADDING TO CART
      // ====================================================================
      let discountInfo = null;
      
      // Try to find price elements on the page using ALL possible selectors
      const oldPriceElement = document.querySelector(
        '.product-price-original_new, .product-info__price--compare, .compare-price, .old-price, [data-compare-price]'
      );
      const currentPriceElement = document.querySelector(
        '.product-price_new, .product-info__price--current, .price, .current-price, [data-price]'
      );
      
      console.log("[product-main-section.liquid] Looking for price elements:", {
        oldPriceElement: !!oldPriceElement,
        oldPriceText: oldPriceElement?.textContent,
        currentPriceElement: !!currentPriceElement,
        currentPriceText: currentPriceElement?.textContent,
      });
      
      if (oldPriceElement && currentPriceElement) {
        const oldPriceText = oldPriceElement.textContent.trim().replace(/[^0-9.]/g, "");
        const currentPriceText = currentPriceElement.textContent.trim().replace(/[^0-9.]/g, "");
        
        if (oldPriceText && currentPriceText) {
          const oldPrice = parseFloat(oldPriceText) * 100; // Convert to cents
          const currentPrice = parseFloat(currentPriceText) * 100; // Convert to cents
          
          console.log("[product-main-section.liquid] Extracted prices:", {
            oldPrice,
            currentPrice,
            difference: oldPrice - currentPrice,
          });
          
          if (oldPrice > currentPrice) {
            discountInfo = {
              originalPrice: oldPrice,
              currentPrice: currentPrice,
              savings: oldPrice - currentPrice,
              percentage: Math.round(((oldPrice - currentPrice) / oldPrice) * 100),
            };
            
            console.log("[product-main-section.liquid] ✅ Captured discount info:", discountInfo);
          }
        }
      } else {
        console.log("[product-main-section.liquid] ⚠️ Could not find price elements on page");
      }
      
      // If no discount found from page HTML, try to fetch variant data from Shopify API
      if (!discountInfo) {
        console.log("[product-main-section.liquid] Trying to fetch variant data from Shopify API for variant:", variantId);
        try {
          const variantResponse = await fetch(`/variants/${variantId}.js`);
          if (variantResponse.ok) {
            const variantData = await variantResponse.json();
            console.log("[product-main-section.liquid] Variant data from Shopify:", {
              price: variantData.price,
              compare_at_price: variantData.compare_at_price,
            });
            
            if (variantData.compare_at_price && variantData.compare_at_price > variantData.price) {
              discountInfo = {
                originalPrice: variantData.compare_at_price,
                currentPrice: variantData.price,
                savings: variantData.compare_at_price - variantData.price,
                percentage: Math.round(((variantData.compare_at_price - variantData.price) / variantData.compare_at_price) * 100),
              };
              console.log("[product-main-section.liquid] ✅ Captured discount from Shopify API:", discountInfo);
            }
          }
        } catch (apiError) {
          console.log("[product-main-section.liquid] Could not fetch variant data from API:", apiError);
        }
      }
      // ====================================================================
      
      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: [{ id: variantId, quantity: quantity }]
          })
        });
        
        if (!response.ok) {
          const error = await readCartError(response);
          console.error('Shopify cart/add.js error:', error);
          throw new Error(error.message || 'Error adding to cart');
        }
        
        const data = await response.json();
        
        // ====================================================================
        // STORE DISCOUNT INFO FOR THIS VARIANT
        // ====================================================================
        if (discountInfo && data.items && data.items.length > 0) {
          if (!window.cartDiscountData) {
            window.cartDiscountData = new Map();
          }
          
          // Get the variant ID from the response (first item)
          const addedItem = data.items[0];
          const addedVariantId = addedItem.variant_id || addedItem.id;
          
          window.cartDiscountData.set(addedVariantId.toString(), discountInfo);
          console.log("[product-main-section.liquid] ✅ Stored discount data for variant:", addedVariantId, discountInfo);
        } else {
          console.log("[product-main-section.liquid] ⚠️ No discount info to store or no items in response");
        }
        // ====================================================================
        
        // Update cart counter
        const cartData = await fetch('/cart.js').then(res => res.json());
        const cartCountElement = document.querySelector('.header__cart-count');
        if (cartCountElement) {
          cartCountElement.textContent = cartData.item_count;
        }
        
        // Update cart drawer if available
        if (window.cartDrawer) {
