
{% liquid
  assign proof_id = 'XCustomProof-' | append: section.id
  assign image_alt = section.settings.image.alt

  if image_alt == blank
    assign image_alt = section.settings.quote
  endif
%}

<section id="{{ proof_id }}" class="xcustom-proof">
  <div class="xcustom-proof__container">
    <div class="xcustom-proof__layout">
      <div class="xcustom-proof__feature">
        <div class="xcustom-proof__media">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1800
              | image_tag:
                widths: '550, 750, 960, 1200, 1500, 1800',
                sizes: '(min-width: 990px) 62vw, 100vw',
                class: 'xcustom-proof__image',
                loading: 'lazy',
                alt: image_alt
            }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'xcustom-proof__placeholder' }}
          {% endif %}

          <span class="xcustom-proof__overlay" aria-hidden="true"></span>

          {% if section.settings.badge != blank %}
            <div class="xcustom-proof__badge">
              {{ section.settings.badge | escape }}
            </div>
          {% endif %}

          <div class="xcustom-proof__feature-content">
            {% if section.settings.quote != blank %}
              <div class="xcustom-proof__quote">
                “{{ section.settings.quote | escape }}”
              </div>
            {% endif %}

            {% if section.settings.caption != blank %}
              <div class="xcustom-proof__caption">
                {{ section.settings.caption | escape }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <div
        class="xcustom-proof__reviews"
        tabindex="0"
        role="region"
        aria-label="{{ section.settings.scroll_area_label | escape }}"
      >
        <div class="xcustom-proof__reviews-list">
          {% for block in section.blocks %}
            <article
              class="xcustom-proof__review"
              {{ block.shopify_attributes }}
            >
              {% if section.settings.show_stars %}
                <div
                  class="xcustom-proof__stars"
                  aria-label="{{ block.settings.rating }} out of 5 stars"
                >
                  {% for star in (1..5) %}
                    <span
                      class="{% if star <= block.settings.rating %}is-filled{% else %}is-empty{% endif %}"
                      aria-hidden="true"
                    >
                      ★
                    </span>
                  {% endfor %}
                </div>
              {% endif %}

              {% if block.settings.title != blank %}
                <h3 class="xcustom-proof__review-title">
                  {{ block.settings.title | escape }}
                </h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="xcustom-proof__review-text">
                  {{ block.settings.text }}
                </div>
              {% endif %}

              {% if block.settings.meta != blank %}
                <div class="xcustom-proof__review-meta">
                  {{ block.settings.meta | escape }}
                </div>
              {% endif %}
            </article>
          {% else %}
            <div class="xcustom-proof__empty">
              Add review blocks to display customer feedback.
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  #{{ proof_id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding:
      {{ 72 }}px
      0
      {{ 72 }}px;
    overflow: hidden;
    background-color: {{ section.settings.background_color }};
  }

  #{{ proof_id }},
  #{{ proof_id }} *,
  #{{ proof_id }} *::before,
  #{{ proof_id }} *::after {
    box-sizing: border-box;
  }

  #{{ proof_id }} .xcustom-proof__container {
    width: 100%;
    max-width: {{ 1400 }}px;
    margin-right: auto;
    margin-left: auto;
    padding-right: {{ 24 }}px;
    padding-left: {{ 24 }}px;
  }

  #{{ proof_id }} .xcustom-proof__layout {
    display: grid;
    grid-template-columns:
      minmax(0, {{ 3 }}fr)
      minmax(320px, {{ 2 }}fr);
    align-items: stretch;
    gap: {{ 24 }}px;
    width: 100%;
  }

  #{{ proof_id }} .xcustom-proof__feature {
    min-width: 0;
  }

  #{{ proof_id }} .xcustom-proof__media {
    position: relative;
    width: 100%;
    height: {{ 520 }}px;
    overflow: hidden;
    border-radius: {{ 20 }}px;
    background-color: #242424;
  }

  #{{ proof_id }} .xcustom-proof__image,
  #{{ proof_id }} .xcustom-proof__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ proof_id }} .xcustom-proof__image {
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  #{{ proof_id }} .xcustom-proof__placeholder {
    background-color: #242424;
  }

  #{{ proof_id }} .xcustom-proof__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  #{{ proof_id }} .xcustom-proof__badge {
    position: absolute;
    top: {{ 32 }}px;
    left: {{ 32 }}px;
    z-index: 2;
    max-width: calc(100% - 48px);
    padding: 9px 16px;
    border-radius: 999px;
    color: {{ section.settings.badge_color }};
    background-color: {{ section.settings.badge_background }};
    font-family: inherit;
    font-size: {{ 11 }}px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ proof_id }} .xcustom-proof__feature-content {
    position: absolute;
    right: {{ 32 }}px;
    bottom: {{ 32 }}px;
    left: {{ 32 }}px;
    z-index: 2;
    max-width: {{ 580 }}px;
  }

  #{{ proof_id }} .xcustom-proof__quote {
    margin: 0;
    color: {{ section.settings.quote_color }};
    font-family: inherit;
    font-size: {{ 28 }}px;
    font-weight: 700;
    line-height: {{ 120 | divided_by: 100.0 }};
    letter-spacing: -0.025em;
    overflow-wrap: break-word;
  }

  #{{ proof_id }} .xcustom-proof__caption {
    margin-top: {{ 16 }}px;
    color: {{ section.settings.caption_color }};
    font-family: inherit;
    font-size: {{ 12 }}px;
    font-weight: 400;
    line-height: 1.4;
  }

  #{{ proof_id }} .xcustom-proof__reviews {
    width: 100%;
    height: {{ 520 }}px;
    min-width: 0;
    overflow-x: hidden;
    overflow-y: auto;
    padding-right: {{ 8 }}px;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    scroll-behavior: smooth;
  }

  #{{ proof_id }} .xcustom-proof__reviews:focus-visible {
    outline: 2px solid {{ section.settings.accent_color }};
    outline-offset: 4px;
    border-radius: {{ 16 }}px;
  }

  #{{ proof_id }} .xcustom-proof__reviews-list {
    display: flex;
    flex-direction: column;
    gap: {{ 16 }}px;
    width: 100%;
  }

  #{{ proof_id }} .xcustom-proof__review {
    width: 100%;
    padding:
      {{ 24 }}px
      {{ 24 }}px;
    border: {{ 0 }}px solid {{ '#333333' }};
    border-radius: {{ 16 }}px;
    background-color: {{ section.settings.review_background }};
  }

  #{{ proof_id }} .xcustom-proof__stars {
    display: flex;
    align-items: center;
    gap: 1px;
    margin: 0 0 {{ 4 }}px;
    font-size: {{ 17 }}px;
    line-height: 1;
    letter-spacing: 0;
  }

  #{{ proof_id }} .xcustom-proof__stars .is-filled {
    color: {{ section.settings.accent_color }};
  }

  #{{ proof_id }} .xcustom-proof__stars .is-empty {
    color: {{ '#555555' }};
  }

  #{{ proof_id }} .xcustom-proof__review-title {
    width: 100%;
    margin: 0;
    padding: 0;
    color: {{ section.settings.review_heading_color }};
    font-family: inherit;
    font-size: {{ 22 }}px;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
  }

  #{{ proof_id }} .xcustom-proof__review-text {
    width: 100%;
    margin-top: {{ 18 }}px;
    color: {{ section.settings.review_text_color }};
    font-family: inherit;
    font-size: {{ 14 }}px;
    font-weight: 400;
    line-height: {{ 150 | divided_by: 100.0 }};
  }

  #{{ proof_id }} .xcustom-proof__review-text p {
    margin: 0;
    color: inherit;
    font: inherit;
  }

  #{{ proof_id }} .xcustom-proof__review-text p + p {
    margin-top: 0.75em;
  }

  #{{ proof_id }} .xcustom-proof__review-meta {
    margin-top: {{ 18 }}px;
    color: {{ section.settings.meta_color }};
    font-family: inherit;
    font-size: {{ 12 }}px;
    font-weight: 400;
    line-height: 1.4;
  }

  #{{ proof_id }} .xcustom-proof__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
    padding: 30px;
    border-radius: {{ 16 }}px;
    color: {{ section.settings.review_text_color }};
    background-color: {{ section.settings.review_background }};
    text-align: center;
  }

  #{{ proof_id }} .xcustom-proof__reviews {
    scrollbar-width: thin;
    scrollbar-color:
      {{ '#444444' }}
      {{ '#181818' }};
  }

  #{{ proof_id }} .xcustom-proof__reviews::-webkit-scrollbar {
    width: {{ 6 }}px;
  }

  #{{ proof_id }} .xcustom-proof__reviews::-webkit-scrollbar-track {
    border-radius: 999px;
    background-color: {{ '#181818' }};
  }

  #{{ proof_id }} .xcustom-proof__reviews::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background-color: {{ '#444444' }};
  }

  #{{ proof_id }} .xcustom-proof__reviews::-webkit-scrollbar-thumb:hover {
    background-color: {{ '#666666' }};
  }

  @media screen and (max-width: 989px) {
    #{{ proof_id }} .xcustom-proof__layout {
      grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr);
      gap: 20px;
    }

    #{{ proof_id }} .xcustom-proof__feature-content {
      right: 24px;
      bottom: 24px;
      left: 24px;
    }

    #{{ proof_id }} .xcustom-proof__badge {
      top: 24px;
      left: 24px;
    }

    #{{ proof_id }} .xcustom-proof__quote {
      font-size: {{ 24 }}px;
    }

    #{{ proof_id }} .xcustom-proof__review {
      padding: 22px 20px;
    }

    #{{ proof_id }} .xcustom-proof__review-title {
      font-size: {{ 19 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ proof_id }} {
      padding:
        {{ 48 }}px
        0
        {{ 48 }}px;
    }

    #{{ proof_id }} .xcustom-proof__container {
      padding-right: {{ 16 }}px;
      padding-left: {{ 16 }}px;
    }

    #{{ proof_id }} .xcustom-proof__layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: {{ 20 }}px;
    }

    #{{ proof_id }} .xcustom-proof__media {
      height: {{ 420 }}px;
      border-radius: {{ 16 }}px;
    }

    #{{ proof_id }} .xcustom-proof__badge {
      top: {{ 22 }}px;
      left: {{ 22 }}px;
      padding: 8px 12px;
      font-size: {{ 10 }}px;
    }

    #{{ proof_id }} .xcustom-proof__feature-content {
      right: {{ 22 }}px;
      bottom: {{ 22 }}px;
      left: {{ 22 }}px;
    }

    #{{ proof_id }} .xcustom-proof__quote {
      font-size: {{ 22 }}px;
      line-height: {{ 125 | divided_by: 100.0 }};
    }

    #{{ proof_id }} .xcustom-proof__caption {
      margin-top: {{ 12 }}px;
      font-size: {{ 11 }}px;
    }

    #{{ proof_id }} .xcustom-proof__reviews {
      width: calc(100% + {{ 16 }}px);
      height: auto;
      min-width: 0;
      margin-right: calc({{ 16 }}px * -1);
      padding-right: {{ 16 }}px;
      padding-bottom: 4px;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      scrollbar-gutter: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #{{ proof_id }} .xcustom-proof__reviews::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }

    #{{ proof_id }} .xcustom-proof__reviews-list {
      display: flex;
      flex-direction: row;
      align-items: stretch;
      gap: {{ 14 }}px;
      width: max-content;
      min-width: 100%;
    }

    #{{ proof_id }} .xcustom-proof__review {
      display: flex;
      flex: 0 0 calc(
        {{ 88 }}vw -
        {{ 16 }}px
      );
      flex-direction: column;
      width: calc(
        {{ 88 }}vw -
        {{ 16 }}px
      );
      max-width: {{ 380 }}px;
      min-width: 0;
      padding:
        {{ 20 }}px
        {{ 18 }}px;
      border-radius: {{ 14 }}px;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    #{{ proof_id }} .xcustom-proof__review-meta {
      margin-top: auto;
      padding-top: {{ 14 }}px;
    }

    #{{ proof_id }} .xcustom-proof__stars {
      margin-bottom: {{ 4 }}px;
      font-size: {{ 16 }}px;
    }

    #{{ proof_id }} .xcustom-proof__review-title {
      font-size: {{ 18 }}px;
    }

    #{{ proof_id }} .xcustom-proof__review-text {
      margin-top: {{ 14 }}px;
      font-size: {{ 13 }}px;
    }

    #{{ proof_id }} .xcustom-proof__review-meta {
      font-size: {{ 11 }}px;
    }

    #{{ proof_id }} .xcustom-proof__empty {
      flex: 0 0 calc(
        100vw -
        {{ 16 | times: 2 }}px
      );
      width: calc(
        100vw -
        {{ 16 | times: 2 }}px
      );
      min-height: 220px;
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 374px) {
    #{{ proof_id }} .xcustom-proof__review {
      flex-basis: calc(92vw - {{ 16 }}px);
      width: calc(92vw - {{ 16 }}px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ proof_id }} .xcustom-proof__reviews {
      scroll-behavior: auto;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "XCustom Proof",
  "tag": "section",
  "class": "section-xcustom-proof",
  "max_blocks": 12,
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Image badge",
      "default": "REAL HOME GYMS. REAL RESULTS."
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Featured quote",
      "default": "The biggest difference was having a complete setup from day one. I stopped modifying workouts around missing equipment."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Featured quote caption",
      "default": "Verified purchaser · Progressive Strength Set"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star ratings",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_area_label",
      "label": "Review area label",
      "default": "Customer reviews"
    },
    {
      "type": "header",
      "content": "Core colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 10
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / stars",
      "default": "#eb701f"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#5a554d"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge text",
      "default": "#eb701f"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Featured quote",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Featured caption",
      "default": "#d0d0d0"
    },
    {
      "type": "color",
      "id": "review_background",
      "label": "Review card background",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "review_heading_color",
      "label": "Review heading",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "review_text_color",
      "label": "Review text",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Review meta",
      "default": "#999999"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Review by setup, not only product"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Review text",
          "default": "<p>Surface reviews that mention the dumbbell, bench, and storage experience together.</p>"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Review meta",
          "default": "Verified purchaser · Progressive Strength Set"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "XCustom Proof",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Review by setup, not only product",
            "text": "<p>Surface reviews that mention the dumbbell, bench, and storage experience together.</p>",
            "meta": "Verified purchaser · Progressive Strength Set"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Add customer room photos",
            "text": "<p>Show footprint, storage, and how the setup looks in real apartments and garages.</p>",
            "meta": "Community content module"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Answer the final objection",
            "text": "<p>Include comments about assembly, package delivery, stability, and long-term use.</p>",
            "meta": "Most helpful review themes"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "A complete setup from day one",
            "text": "<p>The equipment works together well and keeps the training area organized without taking over the room.</p>",
            "meta": "Verified purchaser"
          }
        }
      ]
    }
  ]
}
{% endschema %}
