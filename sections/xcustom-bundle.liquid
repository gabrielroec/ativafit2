</style>

<script>
  (function () {
    'use strict';

    var GLOBAL_KEY = '__xcustomBundleBuilderGlobalReady';

    function toInteger(value) {
      var parsed = parseInt(value, 10);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function initBundleBuilder(root) {
      if (!root || root.dataset.bundleInitialized === 'true') return;
      root.dataset.bundleInitialized = 'true';

      var instanceId = root.dataset.bundleInstance || '';
      var currency = root.dataset.currency || 'USD';
      var checkoutUrl = root.dataset.checkoutUrl || '/checkout';
      var checkoutRequirement = root.dataset.checkoutRequirement || 'step1';
      var discountMode = root.dataset.discountMode || 'display_only';
      var discountCode = (root.dataset.discountCode || '').trim();
      var discountTwoItemsPercent = Math.max(0, Math.min(100, toInteger(root.dataset.discountTwoItemsPercent || '10')));
      var discountThreePlusPercent = Math.max(0, Math.min(100, toInteger(root.dataset.discountThreePlusPercent || '12')));
      var mobileBaseLabel = root.dataset.mobileLabel || 'MY BUNDLE';

      var linesRoot = root.querySelector('[data-bundle-summary-lines]');
      var savingsEl = root.querySelector('[data-bundle-savings]');
      var totalEl = root.querySelector('[data-bundle-total]');
      var checkoutButton = root.querySelector('[data-bundle-checkout]');
      var checkoutLabel = root.querySelector('[data-bundle-checkout-label]');
      var mobileToggle = root.querySelector('[data-bundle-mobile-toggle]');
      var mobileLabel = root.querySelector('[data-bundle-mobile-label]');
      var mobileBackdrop = root.querySelector('[data-bundle-mobile-backdrop]');
      var mobileClose = root.querySelector('[data-bundle-mobile-close]');
      var summaryPanel = root.querySelector('[data-bundle-summary-panel]');
      var messageEl = root.querySelector('[data-bundle-message]');
      var lastFocusedElement = null;

      var formatter;
      try {
        formatter = new Intl.NumberFormat(document.documentElement.lang || 'en-US', {
          style: 'currency',
          currency: currency
        });
      } catch (ex) {
        formatter = null;
      }

      function formatMoney(cents) {
        var safeCents = Number.isFinite(Number(cents)) ? Number(cents) : 0;
        if (formatter) return formatter.format(safeCents / 100);
        return '$' + (safeCents / 100).toFixed(2);
      }

      function getStepInputs(stepNumber) {
        return Array.prototype.slice.call(
          root.querySelectorAll('[data-bundle-option-input][data-bundle-step="' + stepNumber + '"]:checked')
        );
      }

      function getRecoveryCards() {
        return Array.prototype.slice.call(root.querySelectorAll('[data-bundle-recovery-card]'));
      }

      function showMessage(message) {
        if (!messageEl) return;
        messageEl.textContent = message || '';
        messageEl.hidden = !message;
      }

      function clearMessage() {
        showMessage('');
      }

      function isCheckoutComplete(step1Count, step2Count) {
        if (checkoutRequirement === 'step1_or_step2') {
          return (step1Count + step2Count) > 0;
        }
        return step1Count > 0;
      }

      function isStep3Unlocked(step1Count, step2Count) {
        return true;
      }

      function updateLocks() {
        var step1Count = getStepInputs(1).length;
        var step2Count = getStepInputs(2).length;
        var step3Section = root.querySelector('[data-bundle-step-section="3"]');
        var unlocked = isStep3Unlocked(step1Count, step2Count);

        getRecoveryCards().forEach(function (card) {
          var toggle = card.matches('[data-bundle-recovery-toggle]')
            ? card
            : card.querySelector('[data-bundle-recovery-toggle]');
          var available = card.dataset.bundleAvailable !== 'false';

          if (toggle) toggle.disabled = !available;
        });

        if (step3Section) step3Section.classList.remove('is-locked');

        var complete = isCheckoutComplete(step1Count, step2Count);
        if (checkoutButton) {
          checkoutButton.classList.toggle('is-incomplete', !complete);
          checkoutButton.setAttribute('aria-disabled', complete ? 'false' : 'true');
        }

        return {
          step1Count: step1Count,
          step2Count: step2Count,
          complete: complete
        };
      }

      function collectLines() {
        var lines = [];

        getStepInputs(1).concat(getStepInputs(2)).forEach(function (input) {
          lines.push({
            variantId: toInteger(input.value),
            step: input.dataset.bundleStep || '',
            title: input.dataset.bundleLineTitle || '',
            category: input.dataset.bundleLineCategory || '',
            priceCents: toInteger(input.dataset.bundlePriceCents),
            comparePriceCents: toInteger(input.dataset.bundleComparePriceCents),
            discountCents: 0,
            discountPercent: 0
          });
        });

        getRecoveryCards().forEach(function (card) {
          if (!card.classList.contains('is-included')) return;
          if (card.dataset.bundleAvailable === 'false') return;

          lines.push({
            variantId: toInteger(card.dataset.bundleVariantId),
            step: card.dataset.bundleStep || '3',
            title: card.dataset.bundleLineTitle || '',
            category: card.dataset.bundleLineCategory || '',
            priceCents: toInteger(card.dataset.bundlePriceCents),
            comparePriceCents: toInteger(card.dataset.bundleComparePriceCents),
            discountCents: 0,
            discountPercent: 0
          });
        });

        return lines.filter(function (line) {
          return line.variantId > 0;
        });
      }

      function getBundleDiscountPercent(itemCount) {
        if (itemCount > 2) return discountThreePlusPercent;
        if (itemCount === 2) return discountTwoItemsPercent;
        return 0;
      }

      function applyBundleTierDiscounts(lines) {
        var percent = getBundleDiscountPercent(lines.length);
        var subtotal = 0;

        var normalizedLines = lines.map(function (line) {
          var salePriceCents = Math.max(0, toInteger(line.priceCents));
          var comparePriceCents = Math.max(0, toInteger(line.comparePriceCents));

          if (comparePriceCents <= salePriceCents) {
            comparePriceCents = 0;
          }

          subtotal += salePriceCents;

          return {
            variantId: line.variantId,
            step: line.step,
            title: line.title,
            category: line.category,
            priceCents: salePriceCents,
            comparePriceCents: comparePriceCents,
            productDiscountCents: comparePriceCents > salePriceCents ? comparePriceCents - salePriceCents : 0,
            discountCents: 0,
            discountPercent: percent
          };
        });

        var bundleSavings = percent > 0 && subtotal > 0
          ? Math.min(subtotal, Math.max(0, Math.round(subtotal * percent / 100)))
          : 0;
        var remainingSavings = bundleSavings;

        return normalizedLines.map(function (line, index) {
          var discountCents = 0;

          if (remainingSavings > 0 && subtotal > 0) {
            if (index === normalizedLines.length - 1) {
              discountCents = remainingSavings;
            } else {
              discountCents = Math.round(bundleSavings * line.priceCents / subtotal);
            }

            discountCents = Math.min(line.priceCents, Math.max(0, discountCents));
            remainingSavings = Math.max(0, remainingSavings - discountCents);
          }

          return {
            variantId: line.variantId,
            step: line.step,
            title: line.title,
            category: line.category,
            priceCents: line.priceCents,
            comparePriceCents: line.comparePriceCents,
            productDiscountCents: line.productDiscountCents,
            discountCents: discountCents,
            discountPercent: percent
          };
        });
      }

      function renderLines(lines) {
        if (!linesRoot) return;
        linesRoot.innerHTML = '';

        if (!lines.length) {
          var emptyLine = document.createElement('li');
          emptyLine.className = 'xcustom-bundle-summary__line is-empty';

          var emptyBody = document.createElement('div');
          emptyBody.className = 'xcustom-bundle-summary__line-body';

          var emptyTitle = document.createElement('span');
          emptyTitle.className = 'xcustom-bundle-summary__line-title';
          emptyTitle.textContent = {{ section.settings.empty_line_label | json }};

          var emptyPrice = document.createElement('span');
          emptyPrice.className = 'xcustom-bundle-summary__line-price';
          emptyPrice.textContent = '—';

          emptyBody.appendChild(emptyTitle);
          emptyLine.appendChild(emptyBody);
          emptyLine.appendChild(emptyPrice);
          linesRoot.appendChild(emptyLine);
          return;
        }

        lines.forEach(function (line) {
          var listItem = document.createElement('li');
          listItem.className = 'xcustom-bundle-summary__line';

          var body = document.createElement('div');
          body.className = 'xcustom-bundle-summary__line-body';

          var title = document.createElement('span');
          title.className = 'xcustom-bundle-summary__line-title';
          title.textContent = line.title;

          var category = document.createElement('span');
          category.className = 'xcustom-bundle-summary__line-category';
          category.textContent = line.category;

          var right = document.createElement('div');
          right.className = 'xcustom-bundle-summary__line-right';

          var priceStack = document.createElement('span');
          priceStack.className = 'xcustom-bundle-summary__line-price-stack';

          if (line.comparePriceCents > line.priceCents) {
            var comparePrice = document.createElement('span');
            comparePrice.className = 'xcustom-bundle-summary__line-compare';
            comparePrice.textContent = formatMoney(line.comparePriceCents);
            priceStack.appendChild(comparePrice);
          }

          var price = document.createElement('span');
          price.className = 'xcustom-bundle-summary__line-price';
          price.textContent = formatMoney(line.priceCents);

          body.appendChild(title);
          if (line.category) body.appendChild(category);
          priceStack.appendChild(price);
          right.appendChild(priceStack);

          listItem.appendChild(body);
          listItem.appendChild(right);
          linesRoot.appendChild(listItem);
        });
      }

      function updateSummary() {
        var lockState = updateLocks();
        var lines = applyBundleTierDiscounts(collectLines());
        var subtotal = 0;
        var configuredSavings = 0;

        lines.forEach(function (line) {
          subtotal += line.priceCents;
          configuredSavings += Math.min(line.priceCents, Math.max(0, line.discountCents));
        });

        var total = Math.max(0, subtotal - configuredSavings);

        renderLines(lines);
        if (savingsEl) savingsEl.textContent = '-' + formatMoney(configuredSavings);
        if (totalEl) totalEl.textContent = formatMoney(total);
        if (mobileLabel) {
          mobileLabel.textContent = lines.length
            ? mobileBaseLabel + ' · ' + formatMoney(total)
            : mobileBaseLabel;
        }

        if (checkoutButton) {
          checkoutButton.classList.toggle('is-incomplete', !lockState.complete);
        }

        clearMessage();
      }

      function openMobilePanel() {
        lastFocusedElement = document.activeElement;
        root.classList.add('is-mobile-open');
        document.body.classList.add('bundle-mobile-open');
        if (mobileToggle) mobileToggle.setAttribute('aria-expanded', 'true');
        window.setTimeout(function () {
          if (mobileClose) mobileClose.focus();
        }, 30);
      }

      function closeMobilePanel() {
        root.classList.remove('is-mobile-open');
        document.body.classList.remove('bundle-mobile-open');
        if (mobileToggle) mobileToggle.setAttribute('aria-expanded', 'false');
        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
          lastFocusedElement.focus();
        }
      }

      function createCartItems(lines) {
        return lines.map(function (line) {
          return {
            id: line.variantId,
            quantity: 1,
            properties: {
              '_Bundle ID': instanceId,
              '_Bundle Step': String(line.step),
              '_Bundle Discount Rule': line.discountPercent > 0 ? line.discountPercent + '% off' : 'No tier discount',
              '_Bundle Discount': formatMoney(Math.min(line.priceCents, line.discountCents))
            }
          };
        });
      }

      function getCartRootUrl() {
        if (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) {
          return window.Shopify.routes.root;
        }
        return '/';
      }

      function getDrawerSectionId() {
        var drawerItems = document.getElementById('CartDrawer-Items');
        if (drawerItems && drawerItems.dataset && drawerItems.dataset.id) {
          return drawerItems.dataset.id;
        }
        return 'cart-drawer';
      }

      function refreshDrawerFromHtml(html) {
        if (!html) return false;

        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        var didUpdate = false;

        var currentItems = document.getElementById('CartDrawer-Items');
        var newItems = doc.querySelector('#CartDrawer-Items');
        if (currentItems && newItems) {
          currentItems.innerHTML = newItems.innerHTML;
          didUpdate = true;
        }

        var currentRecommendations = document.getElementById('CartDrawer-Recommendations');
        var newRecommendations = doc.querySelector('#CartDrawer-Recommendations');
        if (currentRecommendations && newRecommendations) {
          currentRecommendations.innerHTML = newRecommendations.innerHTML;
          didUpdate = true;
        } else if (currentRecommendations && !newRecommendations) {
          currentRecommendations.remove();
          didUpdate = true;
        }

        var currentFooter = document.querySelector('.cart-drawer__footer');
        var newFooter = doc.querySelector('.cart-drawer__footer');
        if (currentFooter && newFooter) {
          currentFooter.innerHTML = newFooter.innerHTML;
          didUpdate = true;
        }

        return didUpdate;
      }

      function fetchDrawerSectionHtml() {
        var sectionId = getDrawerSectionId();
        var requestUrl = getCartRootUrl() + 'cart?sections=' + encodeURIComponent(sectionId);

        return fetch(requestUrl, {
          method: 'GET',
          headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          credentials: 'same-origin',
          cache: 'no-store'
        })
          .then(function (response) {
            if (!response.ok) return null;
            return response.json();
          })
          .then(function (sections) {
            if (!sections) return false;
            return refreshDrawerFromHtml(sections[sectionId]);
          })
          .then(function (updated) {
            return !!updated;
          }, function () {
            return false;
          });
      }

      function getFreshCart() {
        if (window.AfitCartApi && typeof window.AfitCartApi.invalidate === 'function') {
          window.AfitCartApi.invalidate();
        }

        if (window.AfitCartApi && typeof window.AfitCartApi.fetchCart === 'function') {
          return window.AfitCartApi.fetchCart({ force: true });
        }

        return fetch(getCartRootUrl() + 'cart.js', {
          method: 'GET',
          headers: { 'Accept': 'application/json' },
          credentials: 'same-origin',
          cache: 'no-store'
        }).then(function (response) {
          if (!response.ok) throw new Error('Cart refresh failed.');
          return response.json();
        });
      }

      function updateCountAndSubtotal(cart) {
        if (!cart) return;

        var count = Number(cart.item_count) || 0;
        var countElements = document.querySelectorAll('.cart-count, [data-cart-count], .header__cart-count, .cart-count-bubble span[aria-hidden="true"], .cart-count-bubble span:not(.visually-hidden)');
        Array.prototype.forEach.call(countElements, function (element) {
          element.textContent = count;
          element.hidden = false;
          element.removeAttribute('hidden');
          element.classList.toggle('hidden', count === 0);
        });

        var subtotal = document.querySelector('[data-cart-subtotal]');
        if (subtotal) subtotal.textContent = formatMoney(cart.total_price || 0);

        var drawer = document.querySelector('cart-drawer');
        if (drawer) drawer.classList.toggle('is-empty', count === 0);
      }

      function showAddedNotice() {
        if (!window.CartNotification || typeof window.CartNotification.success !== 'function') return;

        window.CartNotification.success({
          title: 'Product Added!',
          message: 'Join <a href="https://www.ativafit.com/pages/ativapeople-rewards-program" target="_blank" style="color: #eb701f; text-decoration: underline; font-weight: bold;">AtivaPeople</a> & get extra discount.',
          type: 'success'
        });
      }

      function openDrawer() {
        var drawer = document.querySelector('cart-drawer');
        if (drawer && typeof drawer.open === 'function') {
          drawer.open();
          return;
        }

        if (drawer) {
          drawer.classList.add('is-open');
          document.body.classList.add('cart-drawer-open');
          var panel = drawer.querySelector('#CartDrawer');
          if (panel) {
            panel.setAttribute('aria-hidden', 'false');
            if (typeof panel.focus === 'function') panel.focus();
          }
        }
      }

      function addBundleItems(items) {
        var sectionId = getDrawerSectionId();
        var body = {
          items: items,
          sections: sectionId,
          sections_url: window.location.pathname
        };

        return fetch(getCartRootUrl() + 'cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          credentials: 'same-origin',
          cache: 'no-store',
          body: JSON.stringify(body)
        }).then(function (response) {
          return response.json().then(function (data) {
            if (!response.ok) {
              throw new Error(data.description || data.message || 'Unable to add bundle to cart.');
            }
            return data;
          }, function () {
            if (!response.ok) throw new Error('Unable to add bundle to cart.');
            return {};
          });
        });
      }

      function applyCodeSilently() {
        if (discountMode !== 'code' || !discountCode) return;
        try {
          fetch(getCartRootUrl() + 'discount/' + encodeURIComponent(discountCode), {
            method: 'GET',
            credentials: 'same-origin',
            cache: 'no-store'
          });
        } catch (ex) {}
      }

      function resetCheckoutButtonLater() {
        window.setTimeout(function () {
          checkoutButton.disabled = false;
          if (checkoutLabel) checkoutLabel.textContent = {{ section.settings.checkout_label | json }};
        }, 1800);
      }

      function handleCheckout() {
        var lockState = updateLocks();
        if (!lockState.complete) {
          var incompleteMessage = root.dataset.alertIncomplete || 'Please complete the required bundle selection.';
          showMessage(incompleteMessage);
          if (summaryPanel && window.innerWidth < 1100) openMobilePanel();
          return;
        }

        if (discountMode === 'code' && !discountCode) {
          showMessage(root.dataset.alertDiscountError || 'The bundle discount is temporarily unavailable.');
          return;
        }

        var lines = applyBundleTierDiscounts(collectLines());
        var items = createCartItems(lines);
        if (!items.length) return;

        clearMessage();
        checkoutButton.disabled = true;
        if (checkoutLabel) checkoutLabel.textContent = {{ section.settings.checkout_loading_label | json }};

        console.log('[Bundle builder] add started', { items: items });

        addBundleItems(items)
          .then(function (addData) {
            console.log('[Bundle builder] cart/add.js success', addData);

            /*
              Important: open the drawer and show the notice immediately after cart/add.js succeeds.
              The drawer refresh can fail or be delayed independently, but it should not block the UI feedback.
            */
            if (root.classList.contains('is-mobile-open')) closeMobilePanel();
            if (checkoutLabel) checkoutLabel.textContent = 'ADDED TO CART';
            showAddedNotice();
            openDrawer();
            applyCodeSilently();

            var sectionId = getDrawerSectionId();
            var renderedFromAddResponse = false;

            if (addData && addData.sections && addData.sections[sectionId]) {
              try {
                renderedFromAddResponse = refreshDrawerFromHtml(addData.sections[sectionId]);
                console.log('[Bundle builder] rendered drawer from cart/add.js sections:', renderedFromAddResponse);
              } catch (ex) {
                console.log('[Bundle builder] failed to render drawer from cart/add.js sections', ex);
                renderedFromAddResponse = false;
              }
            } else {
              console.log('[Bundle builder] cart/add.js did not return drawer section, requesting cart sections.');
            }

            /*
              Always request a fresh cart-drawer section after multi-item add.
              This makes the flow closer to the theme cart drawer and avoids stale drawer HTML.
            */
            return fetchDrawerSectionHtml()
              .then(function (updated) {
                console.log('[Bundle builder] fetched fresh drawer section:', updated);
                return getFreshCart();
              }, function (ex) {
                console.log('[Bundle builder] fresh drawer section request failed', ex);
                return getFreshCart();
              });
          })
          .then(function (cart) {
            console.log('[Bundle builder] fresh cart', cart);
            updateCountAndSubtotal(cart);

            window.setTimeout(function () {
              fetchDrawerSectionHtml().then(function (updated) {
                console.log('[Bundle builder] delayed drawer refresh 350ms:', updated);
              });
            }, 350);

            window.setTimeout(function () {
              fetchDrawerSectionHtml().then(function (updated) {
                console.log('[Bundle builder] delayed drawer refresh 900ms:', updated);
              });
            }, 900);

            document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { cart: cart } }));
            document.dispatchEvent(new CustomEvent('cart:change', { bubbles: true, detail: { cart: cart } }));
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { cart: cart } }));

            resetCheckoutButtonLater();
          })
          .catch(function (ex) {
            var failMessage = ex && ex.message
              ? ex.message
              : (root.dataset.alertCartError || 'The bundle could not be added. Please try again.');

            console.log('[Bundle builder add failed]', ex);
            showMessage(failMessage);
            checkoutButton.disabled = false;
            if (checkoutLabel) checkoutLabel.textContent = {{ section.settings.checkout_label | json }};
          });
      }

      root.addEventListener('change', function (event) {
        if (event.target.matches('[data-bundle-option-input]')) {
          updateSummary();
        }
      });

      root.addEventListener('click', function (event) {
        var recoveryToggle = event.target.closest('[data-bundle-recovery-toggle]');
        if (recoveryToggle && root.contains(recoveryToggle)) {
          event.preventDefault();
          var recoveryCard = recoveryToggle.closest('[data-bundle-recovery-card]');
          if (!recoveryCard || recoveryToggle.disabled) return;

          var included = !recoveryCard.classList.contains('is-included');
          recoveryCard.classList.toggle('is-included', included);
          recoveryToggle.classList.toggle('is-active', included);
          recoveryToggle.setAttribute('aria-pressed', included ? 'true' : 'false');
          updateSummary();
          return;
        }

        if (event.target.closest('[data-bundle-mobile-toggle]')) {
          if (root.classList.contains('is-mobile-open')) closeMobilePanel();
          else openMobilePanel();
          return;
        }

        if (event.target.closest('[data-bundle-mobile-backdrop]') || event.target.closest('[data-bundle-mobile-close]')) {
          closeMobilePanel();
          return;
        }

        if (event.target.closest('[data-bundle-checkout]')) {
          handleCheckout();
        }
      });

      root.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && root.classList.contains('is-mobile-open')) {
          closeMobilePanel();
        }
      });

      updateSummary();
    }

    function initAll(scope) {
      var context = scope || document;
      if (context.matches && context.matches('[data-bundle-builder-root]')) {
        initBundleBuilder(context);
      }
      if (context.querySelectorAll) {
        context.querySelectorAll('[data-bundle-builder-root]').forEach(initBundleBuilder);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initAll(document);
      }, { once: true });
    } else {
      initAll(document);
    }

    if (!window[GLOBAL_KEY]) {
      window[GLOBAL_KEY] = true;

      document.addEventListener('shopify:section:load', function (event) {
        initAll(event.target);
      });

      document.addEventListener('click', function (event) {
        var anchor = event.target.closest('a[href="#bundle-step-1"]');
        if (!anchor) return;

        var firstBuilder = document.querySelector('[data-bundle-builder-root]');
        if (!firstBuilder) return;

        var target = firstBuilder.querySelector('[data-bundle-step-section="1"]');
        if (!target) return;

        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  })();
</script>

