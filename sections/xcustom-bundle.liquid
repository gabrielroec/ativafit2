{% comment %}
  XCustom Bundle Builder
  Updated: summary line prices show each product's own compare-at price and current sale price.
  Bundle Savings is calculated from the selected sale-price subtotal, rounded once, then distributed by line.
{% endcomment %}

{%- liquid
  assign bb_id = 'xcustom-bundle-' | append: section.id
  assign step1_name = 'bundle-step-1-' | append: section.id
  assign step2_name = 'bundle-step-2-' | append: section.id
  assign checkout_href = section.settings.checkout_url
  if checkout_href == blank
    assign checkout_href = '/checkout'
  endif

  assign discount_two_items_percent = section.settings.discount_two_items_percent | default: 10
  assign discount_three_plus_items_percent = section.settings.discount_three_plus_items_percent | default: 12

  assign step3_count = 0
  for block in section.blocks
    if block.type == 'step3_option' and block.settings.product != blank
      assign step3_count = step3_count | plus: 1
    endif
  endfor
-%}

<section
  id="{{ bb_id }}"
  class="xcustom-bundle-builder"
  data-bundle-builder-root
  data-bundle-instance="{{ section.id }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-checkout-url="{{ checkout_href | escape }}"
  data-checkout-requirement="{{ section.settings.checkout_requirement }}"
  data-discount-mode="{{ section.settings.discount_mode }}"
  data-discount-code="{{ section.settings.discount_code | strip | escape }}"
  data-discount-two-items-percent="{{ discount_two_items_percent }}"
  data-discount-three-plus-percent="{{ discount_three_plus_items_percent }}"
  data-alert-incomplete="{{ section.settings.checkout_alert | escape }}"
  data-alert-discount-error="{{ section.settings.discount_error_alert | escape }}"
  data-alert-cart-error="{{ section.settings.cart_error_alert | escape }}"
  data-mobile-label="{{ section.settings.mobile_toggle_label | escape }}"
  {{ section.shopify_attributes }}
>
  {%- if section.settings.section_heading != blank or section.settings.section_description != blank -%}
    <header class="xcustom-bundle-builder__section-header">
      {%- if section.settings.section_heading != blank -%}
        <{{ section.settings.section_heading_tag }} class="xcustom-bundle-builder__section-heading">
          {{ section.settings.section_heading }}
        </{{ section.settings.section_heading_tag }}>
      {%- endif -%}

      {%- if section.settings.section_description != blank -%}
        <div class="xcustom-bundle-builder__section-description rte">
          {{ section.settings.section_description }}
        </div>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div class="xcustom-bundle-builder__layout">
    <div class="xcustom-bundle-builder__steps">
      <div
        id="bundle-step-1-{{ section.id }}"
        class="xcustom-bundle-builder__step"
        data-bundle-step-section="1"
      >
        <h2 class="xcustom-bundle-builder__heading">
          <span class="xcustom-bundle-builder__heading-number">{{ section.settings.step1_number | escape }}</span>
          <span class="xcustom-bundle-builder__heading-text">{{ section.settings.step1_title | escape }}</span>
        </h2>

        <fieldset class="xcustom-bundle-builder__fieldset">
          <legend class="visually-hidden">{{ section.settings.step1_legend | escape }}</legend>
          <div class="xcustom-bundle-builder__grid xcustom-bundle-builder__grid--step1">
            {%- assign step1_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'step1_option' -%}
                {%- assign step1_index = step1_index | plus: 1 -%}
                {%- assign product_item = block.settings.product -%}
                <div class="xcustom-bundle-builder__cell" {{ block.shopify_attributes }}>
                  {%- if product_item != blank -%}
                    {%- assign variant_item = product_item.selected_or_first_available_variant -%}
                    {%- assign display_title = block.settings.card_title | strip -%}
                    {%- if display_title == blank -%}
                      {%- assign display_title = product_item.title -%}
                    {%- endif -%}
                    {%- assign input_id = 'bundle-s1-' | append: section.id | append: '-' | append: step1_index -%}
                    {%- assign image_item = variant_item.image | default: product_item.featured_image -%}

                    <label class="xcustom-bundle-card{% unless variant_item.available %} is-sold-out{% endunless %}" for="{{ input_id }}">
                      <input
                        id="{{ input_id }}"
                        class="xcustom-bundle-card__input visually-hidden"
                        type="checkbox"
                        name="{{ step1_name }}[]"
                        value="{{ variant_item.id }}"
                        data-bundle-option-input
                        data-bundle-step="1"
                        data-bundle-price-cents="{{ variant_item.price }}"
                        data-bundle-compare-price-cents="{{ variant_item.compare_at_price | default: 0 }}"
                        data-bundle-line-title="{{ display_title | escape }}"
                        data-bundle-line-category="{{ block.settings.sidebar_category | escape }}"
                        {% unless variant_item.available %}disabled{% endunless %}
                      >

                      <span class="xcustom-bundle-card__surface">
                        <span class="xcustom-bundle-card__media">
                          {%- if image_item -%}
                            {{ image_item | image_url: width: 900 | image_tag:
                              loading: 'lazy',
                              class: 'xcustom-bundle-card__image',
                              widths: '240, 360, 480, 720, 900',
                              sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw',
                              alt: image_item.alt | default: display_title | escape
                            }}
                          {%- else -%}
                            {{ 'product-1' | placeholder_svg_tag: 'xcustom-bundle-card__placeholder' }}
                          {%- endif -%}

                          <span class="xcustom-bundle-card__check" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M3.5 8.2L6.6 11.2L12.6 4.9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                        </span>

                        <span class="xcustom-bundle-card__body">
                          {%- if block.settings.badge_label != blank -%}
                            <span class="xcustom-bundle-card__badge">{{ block.settings.badge_label | escape }}</span>
                          {%- endif -%}
                          <span class="xcustom-bundle-card__title">{{ display_title | escape }}</span>
                          {%- if block.settings.card_description != blank -%}
                            <span class="xcustom-bundle-card__description">{{ block.settings.card_description | escape }}</span>
                          {%- endif -%}
                          <span class="xcustom-bundle-card__price-row">
                            {%- if variant_item.compare_at_price > variant_item.price -%}
                              <span class="xcustom-bundle-card__compare">{{ variant_item.compare_at_price | money }}</span>
                            {%- endif -%}
                            <span class="xcustom-bundle-card__price">{{ variant_item.price | money }}</span>
                          </span>
                          {%- if variant_item.available and block.settings.inventory_text != blank -%}
                            <span class="xcustom-bundle-card__inventory">
                              <span class="xcustom-bundle-card__inventory-dot" aria-hidden="true"></span>
                              <span>{{ block.settings.inventory_text | escape }}</span>
                            </span>
                          {%- endif -%}
                          {%- unless variant_item.available -%}
                            <span class="xcustom-bundle-card__sold-out">{{ section.settings.sold_out_label | escape }}</span>
                          {%- endunless -%}
                        </span>
                      </span>
                    </label>
                  {%- else -%}
                    <div class="xcustom-bundle-builder__placeholder">{{ section.settings.empty_state_text | escape }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </fieldset>
      </div>

      <div class="xcustom-bundle-builder__step" data-bundle-step-section="2">
        <h2 class="xcustom-bundle-builder__heading">
          <span class="xcustom-bundle-builder__heading-number">{{ section.settings.step2_number | escape }}</span>
          <span class="xcustom-bundle-builder__heading-text">{{ section.settings.step2_title | escape }}</span>
        </h2>

        <fieldset class="xcustom-bundle-builder__fieldset">
          <legend class="visually-hidden">{{ section.settings.step2_legend | escape }}</legend>
          <div class="xcustom-bundle-builder__grid xcustom-bundle-builder__grid--step2">
            {%- assign step2_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'step2_option' -%}
                {%- assign step2_index = step2_index | plus: 1 -%}
                {%- assign product_item = block.settings.product -%}
                <div class="xcustom-bundle-builder__cell" {{ block.shopify_attributes }}>
                  {%- if product_item != blank -%}
                    {%- assign variant_item = product_item.selected_or_first_available_variant -%}
                    {%- assign display_title = block.settings.card_title | strip -%}
                    {%- if display_title == blank -%}
                      {%- assign display_title = product_item.title -%}
                    {%- endif -%}
                    {%- assign input_id = 'bundle-s2-' | append: section.id | append: '-' | append: step2_index -%}
                    {%- assign image_item = variant_item.image | default: product_item.featured_image -%}

                    <label class="xcustom-bundle-card xcustom-bundle-card--center{% unless variant_item.available %} is-sold-out{% endunless %}" for="{{ input_id }}">
                      <input
                        id="{{ input_id }}"
                        class="xcustom-bundle-card__input visually-hidden"
                        type="checkbox"
                        name="{{ step2_name }}[]"
                        value="{{ variant_item.id }}"
                        data-bundle-option-input
                        data-bundle-step="2"
                        data-bundle-price-cents="{{ variant_item.price }}"
                        data-bundle-compare-price-cents="{{ variant_item.compare_at_price | default: 0 }}"
                        data-bundle-line-title="{{ display_title | escape }}"
                        data-bundle-line-category="{{ block.settings.sidebar_category | escape }}"
                        {% unless variant_item.available %}disabled{% endunless %}
                      >

                      <span class="xcustom-bundle-card__surface">
                        <span class="xcustom-bundle-card__media">
                          {%- if image_item -%}
                            {{ image_item | image_url: width: 900 | image_tag:
                              loading: 'lazy',
                              class: 'xcustom-bundle-card__image',
                              widths: '240, 360, 480, 720, 900',
                              sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw',
                              alt: image_item.alt | default: display_title | escape
                            }}
                          {%- else -%}
                            {{ 'product-1' | placeholder_svg_tag: 'xcustom-bundle-card__placeholder' }}
                          {%- endif -%}

                          <span class="xcustom-bundle-card__check" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M3.5 8.2L6.6 11.2L12.6 4.9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                        </span>

                        <span class="xcustom-bundle-card__body">
                          {%- if block.settings.badge_label != blank -%}
                            <span class="xcustom-bundle-card__badge">{{ block.settings.badge_label | escape }}</span>
                          {%- endif -%}
                          <span class="xcustom-bundle-card__title">{{ display_title | escape }}</span>
                          {%- if block.settings.card_description != blank -%}
                            <span class="xcustom-bundle-card__description">{{ block.settings.card_description | escape }}</span>
                          {%- endif -%}
                          <span class="xcustom-bundle-card__price-row">
                            {%- if variant_item.compare_at_price > variant_item.price -%}
                              <span class="xcustom-bundle-card__compare">{{ variant_item.compare_at_price | money }}</span>
                            {%- endif -%}
                            <span class="xcustom-bundle-card__price">{{ variant_item.price | money }}</span>
                          </span>
                          {%- if variant_item.available and block.settings.inventory_text != blank -%}
                            <span class="xcustom-bundle-card__inventory">
                              <span class="xcustom-bundle-card__inventory-dot" aria-hidden="true"></span>
                              <span>{{ block.settings.inventory_text | escape }}</span>
                            </span>
                          {%- endif -%}
                          {%- unless variant_item.available -%}
                            <span class="xcustom-bundle-card__sold-out">{{ section.settings.sold_out_label | escape }}</span>
                          {%- endunless -%}
                        </span>
                      </span>
                    </label>
                  {%- else -%}
                    <div class="xcustom-bundle-builder__placeholder">{{ section.settings.empty_state_text | escape }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </fieldset>
      </div>

      <div class="xcustom-bundle-builder__step" data-bundle-step-section="3">
        <h2 class="xcustom-bundle-builder__heading">
          <span class="xcustom-bundle-builder__heading-number">{{ section.settings.step3_number | escape }}</span>
          <span class="xcustom-bundle-builder__heading-text">{{ section.settings.step3_title | escape }}</span>
          <span class="xcustom-bundle-builder__optional">{{ section.settings.optional_label | escape }}</span>
        </h2>

        {%- if step3_count > 0 -%}
          <div class="xcustom-bundle-builder__grid xcustom-bundle-builder__grid--step3">
            {%- for block in section.blocks -%}
              {%- if block.type == 'step3_option' -%}
                {%- assign product_item = block.settings.product -%}
                <div class="xcustom-bundle-builder__cell" {{ block.shopify_attributes }}>
                  {%- if product_item != blank -%}
                    {%- assign variant_item = product_item.selected_or_first_available_variant -%}
                    {%- if variant_item != blank -%}
                      {%- assign display_title = block.settings.card_title | strip -%}
                      {%- if display_title == blank -%}
                        {%- assign display_title = product_item.title -%}
                      {%- endif -%}
                      {%- assign image_item = variant_item.image | default: product_item.featured_image -%}
                      {%- assign save_label = block.settings.save_badge_text | strip -%}
                      {%- if save_label == blank and variant_item.compare_at_price > variant_item.price -%}
                        {%- assign save_money = variant_item.compare_at_price | minus: variant_item.price | money -%}
                        {%- assign save_label = 'SAVE ' | append: save_money -%}
                      {%- endif -%}
                      {%- assign step3_badge = save_label -%}
                      {%- if step3_badge == blank -%}
                        {%- assign step3_badge = block.settings.ribbon_text | strip -%}
                      {%- endif -%}

                      <button
                        type="button"
                        class="xcustom-bundle-card xcustom-bundle-card--center xcustom-bundle-card--step3{% if block.settings.included_default and variant_item.available %} is-included is-active{% endif %}{% unless variant_item.available %} is-sold-out{% endunless %}"
                        data-bundle-recovery-card
                        data-bundle-recovery-toggle
                        data-bundle-step="3"
                        data-bundle-variant-id="{{ variant_item.id }}"
                        data-bundle-price-cents="{{ variant_item.price }}"
                        data-bundle-compare-price-cents="{{ variant_item.compare_at_price | default: 0 }}"
                        data-bundle-line-title="{{ display_title | escape }}"
                        data-bundle-line-category="{{ block.settings.sidebar_category | escape }}"
                        data-bundle-available="{% if variant_item.available %}true{% else %}false{% endif %}"
                        aria-pressed="{% if block.settings.included_default and variant_item.available %}true{% else %}false{% endif %}"
                        {% unless variant_item.available %}disabled{% endunless %}
                      >
                        <span class="xcustom-bundle-card__surface">
                          <span class="xcustom-bundle-card__media">
                            {%- if image_item -%}
                              {{ image_item | image_url: width: 900 | image_tag:
                                loading: 'lazy',
                                class: 'xcustom-bundle-card__image',
                                widths: '240, 360, 480, 720, 900',
                                sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw',
                                alt: image_item.alt | default: display_title | escape
                              }}
                            {%- else -%}
                              {{ 'product-1' | placeholder_svg_tag: 'xcustom-bundle-card__placeholder' }}
                            {%- endif -%}

                            <span class="xcustom-bundle-card__check" aria-hidden="true">
                              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3.5 8.2L6.6 11.2L12.6 4.9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </span>
                          </span>

                          <span class="xcustom-bundle-card__body">
                            {%- if step3_badge != blank -%}
                              <span class="xcustom-bundle-card__badge">{{ step3_badge | escape }}</span>
                            {%- endif -%}
                            <span class="xcustom-bundle-card__title">{{ display_title | escape }}</span>
                            {%- if block.settings.description != blank -%}
                              <span class="xcustom-bundle-card__description">{{ block.settings.description | strip_html }}</span>
                            {%- endif -%}
                            <span class="xcustom-bundle-card__price-row">
                              {%- if variant_item.compare_at_price > variant_item.price -%}
                                <span class="xcustom-bundle-card__compare">{{ variant_item.compare_at_price | money }}</span>
                              {%- endif -%}
                              <span class="xcustom-bundle-card__price">{{ variant_item.price | money }}</span>
                            </span>
                            {%- if variant_item.available and block.settings.inventory_text != blank -%}
                              <span class="xcustom-bundle-card__inventory">
                                <span class="xcustom-bundle-card__inventory-dot" aria-hidden="true"></span>
                                <span>{{ block.settings.inventory_text | escape }}</span>
                              </span>
                            {%- endif -%}
                            {%- unless variant_item.available -%}
                              <span class="xcustom-bundle-card__sold-out">{{ section.settings.sold_out_label | escape }}</span>
                            {%- endunless -%}
                          </span>
                        </span>
                      </button>
                    {%- endif -%}
                  {%- else -%}
                    <div class="xcustom-bundle-builder__placeholder">{{ section.settings.empty_state_text | escape }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="xcustom-bundle-builder__placeholder">{{ section.settings.empty_state_text | escape }}</div>
        {%- endif -%}
      </div>
    </div>

    <aside class="xcustom-bundle-summary" aria-label="{{ section.settings.sidebar_a11y_label | escape }}">
      <button
        type="button"
        class="xcustom-bundle-summary__mobile-toggle"
        data-bundle-mobile-toggle
        aria-expanded="false"
        aria-controls="{{ bb_id }}-summary-panel"
      >
        <span data-bundle-mobile-label>{{ section.settings.mobile_toggle_label | escape }}</span>
      </button>

      <div class="xcustom-bundle-summary__backdrop" data-bundle-mobile-backdrop></div>

      <div id="{{ bb_id }}-summary-panel" class="xcustom-bundle-summary__panel" data-bundle-summary-panel>
        <div class="xcustom-bundle-summary__title-row">
          <h2 class="xcustom-bundle-summary__title">
            <span class="xcustom-bundle-summary__title-bar" aria-hidden="true"></span>
            <span>{{ section.settings.heading | escape }}</span>
          </h2>

          <button
            type="button"
            class="xcustom-bundle-summary__close"
            data-bundle-mobile-close
            aria-label="{{ section.settings.mobile_close_label | escape }}"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M5 5L15 15M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <ul class="xcustom-bundle-summary__lines" data-bundle-summary-lines>
          <li class="xcustom-bundle-summary__line is-empty">
            <div class="xcustom-bundle-summary__line-body">
              <span class="xcustom-bundle-summary__line-title">{{ section.settings.empty_line_label | escape }}</span>
            </div>
            <span class="xcustom-bundle-summary__line-price">—</span>
          </li>
        </ul>

        <div class="xcustom-bundle-summary__discount">
          <p class="xcustom-bundle-summary__discount-label">{{ section.settings.discount_heading | escape }}</p>
          <p class="xcustom-bundle-summary__discount-amount" data-bundle-savings>{{ 0 | money }}</p>
          {%- if section.settings.discount_footer != blank -%}
            <div class="xcustom-bundle-summary__discount-rule"></div>
            <p class="xcustom-bundle-summary__discount-footer">{{ section.settings.discount_footer | escape }}</p>
          {%- endif -%}
        </div>

        <div class="xcustom-bundle-summary__total">
          <span class="xcustom-bundle-summary__total-label">{{ section.settings.total_label | escape }}</span>
          <span class="xcustom-bundle-summary__total-value" data-bundle-total>{{ 0 | money }}</span>
        </div>

        <button
          type="button"
          class="xcustom-bundle-summary__checkout is-incomplete"
          data-bundle-checkout
          aria-disabled="true"
        >
          <span data-bundle-checkout-label>{{ section.settings.checkout_label | escape }}</span>
        </button>

        <div class="xcustom-bundle-summary__message" data-bundle-message role="status" aria-live="polite" hidden></div>

        <div class="xcustom-bundle-summary__trust">
          {%- if section.settings.trust_1_text != blank -%}
            <span>{{ section.settings.trust_1_text | escape }}</span>
          {%- endif -%}
          {%- if section.settings.trust_2_text != blank -%}
            <span>{{ section.settings.trust_2_text | escape }}</span>
          {%- endif -%}
          {%- if section.settings.trust_3_text != blank -%}
            <span>{{ section.settings.trust_3_text | escape }}</span>
          {%- endif -%}
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  #{{ bb_id }} {
    --bundle-accent: {{ section.settings.accent_color }};
    --bundle-bg: {{ section.settings.background_color }};
    --bundle-panel-bg: {{ section.settings.panel_bg }};
    --bundle-panel-border: {{ section.settings.panel_border }};
    --bundle-discount-bg: {{ section.settings.discount_box_bg }};
    --bundle-text: {{ section.settings.step_title_color }};
    --bundle-muted: {{ section.settings.description_color }};
    --bundle-panel-width: {{ section.settings.panel_width }}px;
    --bundle-mobile-bottom: {{ section.settings.mobile_margin_bottom }}px;
    background: var(--bundle-bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #{{ bb_id }} .xcustom-bundle-builder__section-header {
    width: min(100% - 48px, {{ section.settings.content_max_width }}px);
    max-width: {{ section.settings.section_header_max_width }}px;
    margin: 0 auto;
    text-align: {{ section.settings.section_header_alignment }};
  }

  #{{ bb_id }} .xcustom-bundle-builder__section-heading {
    width: 100%;
    margin: 0 !important;
    padding: 0;
    color: {{ section.settings.section_heading_color }} !important;
    font-family: var(--heading-font-family) !important;
    font-size: {{ section.settings.section_heading_size }}px !important;
    font-weight: 900 !important;
    line-height: {{ section.settings.section_heading_line_height | divided_by: 100.0 }} !important;
    letter-spacing: -0.035em !important;
    overflow-wrap: break-word;
  }

  #{{ bb_id }} .xcustom-bundle-builder__section-description {
    width: 100%;
    margin-top: {{ section.settings.section_description_gap }}px;
    color: {{ section.settings.section_description_color }} !important;
  }

  #{{ bb_id }} .xcustom-bundle-builder__section-description,
  #{{ bb_id }} .xcustom-bundle-builder__section-description p,
  #{{ bb_id }} .xcustom-bundle-builder__section-description span,
  #{{ bb_id }} .xcustom-bundle-builder__section-description a {
    color: inherit !important;

  }

  #{{ bb_id }} .xcustom-bundle-builder__section-description > *:first-child {
    margin-top: 0;
  }

  #{{ bb_id }} .xcustom-bundle-builder__section-description > *:last-child {
    margin-bottom: 0;
  }

  #{{ bb_id }} .xcustom-bundle-builder__section-header + .xcustom-bundle-builder__layout {
    margin-top: {{ section.settings.section_content_gap }}px;
  }

  #{{ bb_id }} *,
  #{{ bb_id }} *::before,
  #{{ bb_id }} *::after {
    box-sizing: border-box;
  }

  body.bundle-mobile-open {
    overflow: hidden;
  }

  #{{ bb_id }} .xcustom-bundle-builder__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--bundle-panel-width);
    gap: {{ section.settings.layout_column_gap }}px;
    align-items: start;
    width: min(100% - 48px, {{ section.settings.content_max_width }}px);
