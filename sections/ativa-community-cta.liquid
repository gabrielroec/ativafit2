{%- liquid
  assign cta_id = 'ativa-community-cta-' | append: section.id
  assign cta_brand_orange = '#eb701f'
  assign cta_bg = section.settings.background_color | default: cta_brand_orange
  assign bg_image = section.settings.background_image
  assign use_bg_image = false
  if bg_image != blank
    assign use_bg_image = true
  endif
  assign overlay_opacity = section.settings.overlay_opacity | default: 35 | divided_by: 100.0
  assign show_noise = section.settings.show_noise_overlay | default: true
-%}

<link rel="preload" as="style" href="{{ 'ativa-community-cta.css' | asset_url }}" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'ativa-community-cta.css' | asset_url }}"></noscript>

<section
  id="{{ cta_id }}"
  class="ativa-community-cta{% if use_bg_image %} ativa-community-cta--bg-image{% endif %}"
  data-section-type="ativa-community-cta"
  data-ativa-community-cta
  style="
    --cta-bg: {{ cta_bg }};
    --cta-pad-top: {{ section.settings.padding_top }}px;
    --cta-pad-bottom: {{ section.settings.padding_bottom }}px;
    --cta-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --cta-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --cta-title-mb: {{ section.settings.title_margin_bottom }}px;
    --cta-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --cta-body-size-desktop: {{ section.settings.body_size_desktop }}px;
    --cta-text-mb: {{ section.settings.text_margin_bottom }}px;
    --cta-btn-font-size: {{ section.settings.button_font_size }}px;
    --cta-btn-pad-x: {{ section.settings.button_padding_x }}px;
    --cta-btn-pad-y: {{ section.settings.button_padding_y }}px;
    --cta-btn-radius: {{ section.settings.button_radius }}px;
    {% if use_bg_image %}--ativa-cta-overlay-opacity: {{ overlay_opacity }};{% endif %}
  ">
  {%- if use_bg_image -%}
    <div class="ativa-community-cta__bg" aria-hidden="true">
      {%- comment -%}
        Background CTA — última section antes do footer. Slot 100vw mas a
        section é decorativa: ladder reduzido pra 480/750/1100/1500 (cortado
        o 1920w, oversize pra 99% dos viewports). format:'webp' garante
        compressão moderna mesmo se o admin trocar a imagem por JPG.
      {%- endcomment -%}
      {{
        bg_image
        | image_url: width: 1500, format: 'webp'
        | image_tag:
          class: 'ativa-community-cta__bg-media',
          widths: '480, 750, 1100, 1500',
          sizes: '100vw',
          loading: 'lazy',
          decoding: 'async',
          fetchpriority: 'low',
          alt: ''
      }}
    </div>
    <div class="ativa-community-cta__overlay" aria-hidden="true"></div>
    <div
      class="ativa-community-cta__noise"
      aria-hidden="true"
      {% unless show_noise %}
        hidden
      {% endunless %}></div>
  {%- endif -%}
  <div class="ativa-community-cta__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ativa-community-cta__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="ativa-community-cta__text">{{ section.settings.body | escape | newline_to_br }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      {%- if section.settings.button_link != blank -%}
        <a
          class="ativa-community-cta__button"
          href="{{ section.settings.button_link }}"
          {% if section.settings.button_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}>
          {{ section.settings.button_label | escape }}
        </a>
      {%- else -%}
        <span class="ativa-community-cta__button ativa-community-cta__button--static" role="text">
          {{ section.settings.button_label | escape }}
        </span>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ativa Community CTA",
  "tag": "section",
  "class": "section-ativa-community-cta",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Join the Ativa Community"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Elevate your training with exclusive access to early product launches, member-only discounts, and expert workout guides tailored for your home gym setup."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Sign Up Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "e.g. AtivaPeople page or signup. If empty, the button shows without a link."
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open link in a new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "When set, replaces the background color (image takes priority). Color stays as fallback behind the image and for the button text."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#eb701f",
      "info": "Used when no image is set. With an image, fills any gap and sets the white button’s text color."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Image overlay darkness",
      "default": 35,
      "info": "Only applies when a background image is set (same idea as the home hero)."
    },
    {
      "type": "checkbox",
      "id": "show_noise_overlay",
      "label": "Show subtle noise texture on image",
      "default": true,
      "info": "Matches the home hero texture when using a background image."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 28,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Title — mobile",
      "default": 36
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 36,
      "max": 56,
      "step": 1,
      "unit": "px",
      "label": "Title — desktop",
      "default": 48
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "min": 16,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Body — mobile",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "min": 18,
      "max": 26,
      "step": 1,
      "unit": "px",
      "label": "Body — desktop",
      "default": 20
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Button text",
      "default": 14
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 48,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding (top)",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 48,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding (bottom)",
      "default": 96
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Space below title",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_margin_bottom",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Space below text (before button)",
      "default": 40
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Button — horizontal padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "button_padding_y",
      "min": 12,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Button — vertical padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Button corner radius",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Ativa Community CTA",
      "category": "Call to action"
    }
  ]
}
{% endschema %}
