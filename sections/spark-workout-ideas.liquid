{%- style -%}
  .spark-workout-ideas {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  .spark-workout-ideas__inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 62px 100px 50px;
    border-radius: 12px;
    background: #fff;
    text-align: center;
  }

  .spark-workout-ideas__heading {
    margin: 0 0 28px;
    color: #070707;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-size: 40px;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: 0;
  }

  .spark-workout-ideas__copy {
    max-width: 1060px;
    margin: 0 auto;
    color: #69707a;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-size: 21px;
    line-height: 1.55;
    font-weight: 600;
    letter-spacing: 0;
  }

  .spark-workout-ideas__copy p {
    margin: 0;
  }

  .spark-workout-ideas__copy p + p {
    margin-top: 30px;
  }

  .spark-workout-ideas__divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 50px;
    max-width: 1080px;
    margin: 56px auto 32px;
    color: #0b0b0b;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-size: 28px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0;
  }

  .spark-workout-ideas__divider::before,
  .spark-workout-ideas__divider::after {
    content: "";
    height: 2px;
    background: #ff6b21;
  }

  .spark-workout-ideas__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px 28px;
  }

  .spark-workout-ideas__card {
    min-height: 242px;
    padding: 30px 24px 26px;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    background: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .spark-workout-ideas__icon,
  .spark-workout-ideas__icon-img {
    width: 78px;
    height: 78px;
    margin-bottom: 12px;
    color: #ff6b21;
  }

  .spark-workout-ideas__icon-img {
    object-fit: contain;
  }

  .spark-workout-ideas__title {
    margin: 0 0 8px;
    color: #080808;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-size: 28px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: 0;
  }

  .spark-workout-ideas__text {
    margin: 0;
    color: #69707a;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: 0;
    white-space: pre-line;
  }

  @media (max-width: 1024px) {
    .spark-workout-ideas__inner {
      padding: 48px 28px 38px;
    }

    .spark-workout-ideas__heading {
      font-size: 34px;
    }

    .spark-workout-ideas__copy {
      font-size: 18px;
    }

    .spark-workout-ideas__divider {
      gap: 24px;
      font-size: 24px;
    }

    .spark-workout-ideas__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .spark-workout-ideas {
      padding-left: 14px;
      padding-right: 14px;
    }

    .spark-workout-ideas__inner {
      padding: 36px 16px 24px;
      border-radius: 10px;
    }

    .spark-workout-ideas__heading {
      font-size: 28px;
    }

    .spark-workout-ideas__copy {
      font-size: 16px;
    }

    .spark-workout-ideas__divider {
      display: block;
      margin: 36px auto 24px;
      font-size: 22px;
    }

    .spark-workout-ideas__divider::before,
    .spark-workout-ideas__divider::after {
      display: none;
    }

    .spark-workout-ideas__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .spark-workout-ideas__card {
      min-height: 210px;
    }
  }
{%- endstyle -%}

<section class="spark-workout-ideas" data-section-id="{{ section.id }}" data-section-type="spark-workout-ideas">
  <div class="spark-workout-ideas__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="spark-workout-ideas__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="spark-workout-ideas__copy">
      {%- if section.settings.description_1 != blank -%}
        <p>{{ section.settings.description_1 }}</p>
      {%- endif -%}
      {%- if section.settings.description_2 != blank -%}
        <p>{{ section.settings.description_2 }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.divider_title != blank -%}
      <div class="spark-workout-ideas__divider">{{ section.settings.divider_title }}</div>
    {%- endif -%}

    <div class="spark-workout-ideas__grid">
      {%- for block in section.blocks -%}
        <div class="spark-workout-ideas__card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon_image != blank -%}
            <img
              src="{{ block.settings.icon_image | image_url: width: 180 }}"
              alt=""
              loading="lazy"
              class="spark-workout-ideas__icon-img">
          {%- else -%}
            {%- render 'spark-workout-icon', icon: block.settings.icon_style -%}
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="spark-workout-ideas__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="spark-workout-ideas__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Spark Workout Ideas",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Can You Do With 25 lb Adjustable Dumbbells?"
    },
    {
      "type": "textarea",
      "id": "description_1",
      "label": "Description paragraph 1",
      "default": "A 25 lb adjustable dumbbell set can support more than arm workouts. With 5 weight levels from 5 to 25 lbs, Ativafit Spark gives you enough flexibility for toning, light strength training, HIIT circuits, and everyday full-body home workouts."
    },
    {
      "type": "textarea",
      "id": "description_2",
      "label": "Description paragraph 2",
      "default": "Use lighter settings for shoulder raises, tricep extensions, core exercises, and high-rep toning. Move up in weight for rows, chest presses, squats, lunges, deadlifts, and lower-body strength training."
    },
    {
      "type": "text",
      "id": "divider_title",
      "label": "Divider title",
      "default": "Workout ideas with Spark:"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "workout",
      "name": "Workout card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Uploaded icon",
          "info": "Upload a custom icon. If empty, the fallback line icon is used."
        },
        {
          "type": "select",
          "id": "icon_style",
          "label": "Fallback icon",
          "default": "arms",
          "options": [
            { "value": "arms", "label": "Arms" },
            { "value": "shoulders", "label": "Shoulders" },
            { "value": "back", "label": "Back" },
            { "value": "chest", "label": "Chest" },
            { "value": "legs", "label": "Legs" },
            { "value": "core", "label": "Core" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Arms"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Bicep curls, Tricep extensions"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Spark Workout Ideas",
      "category": "Product",
      "blocks": [
        { "type": "workout", "settings": { "icon_style": "arms", "title": "Arms", "text": "Bicep curls,\nTricep extensions" } },
        { "type": "workout", "settings": { "icon_style": "shoulders", "title": "Shoulders", "text": "Shoulder presses,\nLateral raises" } },
        { "type": "workout", "settings": { "icon_style": "back", "title": "Back", "text": "Rows, Rear delt raises" } },
        { "type": "workout", "settings": { "icon_style": "chest", "title": "Chest", "text": "Floor presses,\nChest presses" } },
        { "type": "workout", "settings": { "icon_style": "legs", "title": "Legs", "text": "Squats, Lunges" } },
        { "type": "workout", "settings": { "icon_style": "core", "title": "Core", "text": "Russian twists,\nSide bends" } }
      ]
    }
  ]
}
{% endschema %}
