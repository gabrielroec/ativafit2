{% comment %}
  Benefits Horizontal – Layout horizontal para homepage/outras páginas.
  Ícones e texto centralizados em cada bloco. Mesmo schema de benefícios do PDP.
{% endcomment %}

{{ 'section-benefits-horizontal.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .benefits-horizontal.section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .benefits-horizontal.section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 1039px) {
    .benefits-horizontal__grid {
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 12px;
    }

    .benefits-horizontal__grid::-webkit-scrollbar {
      display: none;
    }

    .benefits-horizontal__item {
      scroll-snap-align: start;
    }

    .benefits-horizontal__scrollbar {
      position: relative;
      display: block;
      width: calc(100% - 32px);
      height: 4px;
      margin: 8px auto 0;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.12);
      overflow: hidden;
      opacity: 1;
      transition: opacity 0.25s ease;
    }



    .benefits-horizontal__scrollbar-thumb {
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      min-width: 36px;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.38);
      transform: translateX(0);
      transition: transform 0.08s linear;
    }
  }

  @media screen and (min-width: 1040px) {
    .benefits-horizontal__scrollbar {
      display: none;
    }
  }
{%- endstyle -%}

<div class="benefits-horizontal section-{{ section.id }}-padding" data-benefits-horizontal>
  <div class="benefits-horizontal__inner">
    <div class="benefits-horizontal__grid" data-benefits-swipe>
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          {%- assign benefit_title = block.settings.title -%}
          {%- assign benefit_desc = block.settings.description -%}
          {%- if benefit_title != blank -%}
            {%- assign icon_w = block.settings.icon_width | default: 45 -%}
            {%- assign icon_h = block.settings.icon_height | default: 45 -%}
            <div class="benefits-horizontal__item" {{ block.shopify_attributes }}>
              <div class="benefits-horizontal__icon" style="width:{{ icon_w }}px;height:{{ icon_h }}px;">
                {%- if block.settings.svg_icon != blank -%}
                  <span class="benefits-horizontal__icon-svg" style="width:{{ icon_w }}px;height:{{ icon_h }}px;">{{ block.settings.svg_icon }}</span>
                {%- elsif block.settings.icon_image != blank -%}
                  <img
                    src="{{ block.settings.icon_image | image_url: width: 180, format: 'webp' }}"
                    alt="{{ benefit_title | escape }}"
                    width="{{ icon_w }}"
                    height="{{ icon_h }}"
                    loading="lazy">
                {%- else -%}
                  {%- assign title_lower = benefit_title | downcase -%}
                  {%- if title_lower contains 'shop pay' -%}
                    <img
                      src="{{ 'shop-pay-icon.png' | asset_url }}"
                      alt="{{ benefit_title | escape }}"
                      width="{{ icon_w }}"
                      height="{{ icon_h }}"
                      loading="lazy">
                  {%- else -%}
                    <span class="benefits-horizontal__icon-placeholder" style="width:{{ icon_w }}px;height:{{ icon_h }}px;" aria-hidden="true"></span>
                  {%- endif -%}
                {%- endif -%}
              </div>
              <h4 class="benefits-horizontal__title">{{ benefit_title }}</h4>
              {%- if benefit_desc != blank -%}
                <p class="benefits-horizontal__description">
                  {{ benefit_desc }}
                  {%- if block.settings.popup_title != blank and block.settings.popup_content != blank -%}
                    <a href="#"
                       class="benefits-horizontal__learn-more"
                       data-benefit-popup="{{ block.id }}"
                       aria-label="Learn more about {{ benefit_title | escape }}">{{ block.settings.link_text | default: 'Learn more' }}</a>
                  {%- elsif block.settings.show_learn_more and block.settings.link_url != blank -%}
                    <a href="{{ block.settings.link_url }}" class="benefits-horizontal__learn-more">{{ block.settings.link_text | default: 'Learn more' }}</a>
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="benefits-horizontal__scrollbar" aria-hidden="true">
      <span class="benefits-horizontal__scrollbar-thumb"></span>
    </div>
  </div>
</div>



{%- render 'product-benefit-popups', section: section -%}

  <script>
    (function() {
      var section = document.querySelector('[data-benefits-horizontal]');
      if (!section) return;

      var grid = section.querySelector('[data-benefits-swipe]');
      var scrollbar = section.querySelector('.benefits-horizontal__scrollbar');
      var scrollbarThumb = section.querySelector('.benefits-horizontal__scrollbar-thumb');

      if (!grid) return;

      var isDown = false;
      var isDragging = false;
      var startX = 0;
      var scrollLeft = 0;
      var scrollTimer = null;

      function hasHorizontalOverflow() {
        return grid.scrollWidth > grid.clientWidth + 2;
      }

      function updateScrollbar() {
        if (!scrollbar || !scrollbarThumb) return;

        if (window.innerWidth >= 1040 || !hasHorizontalOverflow()) {
          scrollbar.style.display = 'none';
          return;
        }

        scrollbar.style.display = 'block';

        var trackWidth = scrollbar.offsetWidth;
        var visibleRatio = grid.clientWidth / grid.scrollWidth;
        var thumbWidth = Math.max(trackWidth * visibleRatio, 36);

        var maxScroll = grid.scrollWidth - grid.clientWidth;
        var maxThumbMove = trackWidth - thumbWidth;
        var scrollRatio = maxScroll > 0 ? grid.scrollLeft / maxScroll : 0;
        var thumbLeft = maxThumbMove * scrollRatio;

        scrollbarThumb.style.width = thumbWidth + 'px';
        scrollbarThumb.style.transform = 'translate3d(' + thumbLeft + 'px, 0, 0)';
      }

      function showScrollbar() {
        updateScrollbar();

        if (!hasHorizontalOverflow() || window.innerWidth >= 1040) return;

        section.classList.add('is-scrolling');

        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(function() {
          section.classList.remove('is-scrolling');
        }, 900);
      }

      function onMouseMove(e) {
        if (!isDown) return;

        e.preventDefault();

        var x = e.pageX - grid.offsetLeft;
        var walk = (x - startX) * 2;

        if (Math.abs(walk) > 10) {
          isDragging = true;
          grid.classList.add('is-dragging');
        }

        grid.scrollLeft = scrollLeft - walk;
        updateScrollbar();
      }

      function onMouseUp() {
        isDown = false;
        grid.classList.remove('is-down', 'is-dragging');

        document.removeEventListener('mousemove', onMouseMove);
        document.removeEventListener('mouseup', onMouseUp);

        showScrollbar();
      }

      grid.addEventListener('mousedown', function(e) {
        if (e.target.closest('a')) return;

        e.preventDefault();

        isDown = true;
        isDragging = false;

        grid.classList.add('is-down');

        startX = e.pageX - grid.offsetLeft;
        scrollLeft = grid.scrollLeft;

        showScrollbar();

        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      });

      grid.addEventListener('mouseleave', function() {
        if (!isDown) return;
        onMouseUp();
      });

      grid.addEventListener('click', function(e) {
        if (isDragging) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);

      grid.addEventListener('scroll', function() {
        showScrollbar();
      }, { passive: true });

      grid.addEventListener('touchstart', function() {
        showScrollbar();
      }, { passive: true });

      grid.addEventListener('touchmove', function() {
        updateScrollbar();
        showScrollbar();
      }, { passive: true });

      window.addEventListener('resize', function() {
        updateScrollbar();
      });

      window.addEventListener('load', function() {
        updateScrollbar();
      });

      updateScrollbar();

      section.querySelectorAll('[data-benefit-popup]').forEach(function(link) {
        link.addEventListener('click', function(e) {
          e.preventDefault();

          var id = link.getAttribute('data-benefit-popup');
          var popup = document.getElementById('benefit-popup-' + id);

          if (popup) {
            popup.classList.add('is-show');
            document.body.style.overflow = 'hidden';
          }
        });
      });

      document.querySelectorAll('[data-close-benefit]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = btn.getAttribute('data-close-benefit');
          var popup = document.getElementById('benefit-popup-' + id);

          if (popup) {
            popup.classList.remove('is-show');
            document.body.style.overflow = '';
          }
        });
      });

      document.querySelectorAll('.halo-popup').forEach(function(popup) {
        popup.addEventListener('click', function(e) {
          if (e.target === popup) {
            popup.classList.remove('is-show');
            document.body.style.overflow = '';
          }
        });
      });
    })();
  </script>

{% schema %}
{
  "name": "Benefits (horizontal)",
  "tag": "section",
  "class": "section-benefits-horizontal",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Benefit Title",
          "default": "Free Shipping within the U.S."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Benefit Description",
          "default": "Standard shipping in 3–7 days."
        },
        {
          "type": "html",
          "id": "svg_icon",
          "label": "SVG Icon"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image"
        },
        {
          "type": "header",
          "content": "Popup Modal (Optional)"
        },
        {
          "type": "text",
          "id": "popup_title",
          "label": "Popup Title"
        },
        {
          "type": "richtext",
          "id": "popup_content",
          "label": "Popup Content"
        },
        {
          "type": "header",
          "content": "External Link (Alternative to Popup)"
        },
        {
          "type": "checkbox",
          "id": "show_learn_more",
          "label": "Show Learn More Link",
          "default": false
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "header",
          "content": "Icon Size"
        },
        {
          "type": "range",
          "id": "icon_width",
          "label": "Icon Width (px)",
          "min": 20,
          "max": 120,
          "step": 5,
          "default": 45,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "icon_height",
          "label": "Icon Height (px)",
          "min": 20,
          "max": 120,
          "step": 5,
          "default": 45,
          "unit": "px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits (horizontal)",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
