<section
  class="section goal-spark-title"
  data-section-id="{{ section.id }}"
  data-section-type="goal-spark-title"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- liquid
      assign title_raw = product.metafields.custom.goal_section_title.value | default: section.settings.section_title
      assign title_normalized = title_raw | replace: '</hight>', '<high>' | replace: '</high>', '<high>' | replace: '<hight>', '<high>'
      assign title_parts = title_normalized | split: '<high>'

      assign card_items = product.metafields.custom.goal_strength_cards.value
      assign use_metaobject = false
      if card_items != blank and card_items.size > 0
        assign use_metaobject = true
      else
        assign card_items = section.blocks
      endif
    -%}

    {%- if title_raw != blank -%}
      <h2 class="goal-spark-title__heading">
        {%- for part in title_parts -%}
          {%- assign idx_mod = forloop.index0 | modulo: 2 -%}
          {%- if idx_mod == 1 -%}
            <span class="spark-highlight">{{ part }}</span>
          {%- else -%}
            {{ part }}
          {%- endif -%}
        {%- endfor -%}
      </h2>
    {%- endif -%}

    {%- if card_items.size > 0 -%}
      <!-- Desktop/Tablet Grid -->
      <div class="strength-cards-desktop">
        <div class="strength-cards-grid">
          {%- for item in card_items -%}
            {%- liquid
              if use_metaobject
                assign card_image = item.card_image
                assign card_title = item.card_title
                assign card_quote = item.card_quote
                assign shopify_attrs = ''
              else
                assign card_image = item.settings.card_image
                assign card_title = item.settings.card_title
                assign card_quote = item.settings.card_quote
                assign shopify_attrs = item.shopify_attributes
              endif
            -%}
            <div class="strength-card" {{ shopify_attrs }}>
              <div class="strength-card__image">
                {%- if card_image != blank -%}
                  <img
                    src="{{ card_image | image_url: width: 400 }}"
                    alt="{{ card_image.alt | default: card_title }}"
                    width="400"
                    height="450"
                    loading="lazy">
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-image' }}
                {%- endif -%}
              </div>
              <div class="strength-card__content">
                {%- if card_title != blank -%}
                  <h3 class="strength-card__title">{{ card_title | escape }}</h3>
                {%- endif -%}

                {%- if card_quote != blank -%}
                  <p class="strength-card__quote">"{{ card_quote }}"</p>
                  <button type="button" class="strength-card__read-more" data-strength-card-read-more>Read more</button>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <!-- Mobile Slider -->
      <div class="strength-cards-mobile" id="mobile-slider-{{ section.id }}">
        <div class="mobile-slider-container">
          <div class="mobile-slide active" data-slide="0">
            {%- for item in card_items -%}
              {%- liquid
                if use_metaobject
                  assign card_image = item.card_image
                  assign card_title = item.card_title
                  assign card_quote = item.card_quote
                  assign shopify_attrs = ''
                else
                  assign card_image = item.settings.card_image
                  assign card_title = item.settings.card_title
                  assign card_quote = item.settings.card_quote
                  assign shopify_attrs = item.shopify_attributes
                endif
              -%}
              <div
                class="mobile-card{% unless forloop.first %} hidden{% endunless %}"
                data-card="{{ forloop.index0 }}"
                {{ shopify_attrs }}>
                <div class="mobile-card__image">
                  {%- if card_image != blank -%}
                    <img
                      src="{{ card_image | image_url: width: 400 }}"
                      alt="{{ card_image.alt | default: card_title }}"
                      width="400"
                      height="450"
                      loading="lazy">
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-image' }}
                  {%- endif -%}
                </div>
                <div class="mobile-card__content">
                  {%- if card_title != blank -%}
                    <h3 class="mobile-card__title">{{ card_title | escape }}</h3>
                  {%- endif -%}

                  {%- if card_quote != blank -%}
                    <p class="mobile-card__quote">"{{ card_quote }}"</p>
                    <button type="button" class="strength-card__read-more" data-strength-card-read-more>Read more</button>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- if card_items.size > 1 -%}
          <div class="mobile-dots" id="mobile-dots-{{ section.id }}">
            {%- for item in card_items -%}
              <button class="mobile-dot{% if forloop.first %} active{% endif %}" data-slide="{{ forloop.index0 }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .goal-spark-title .container {
    max-width: 1600px;
    width: 100%;
  }

  .goal-spark-title {
    padding: 40px 0;
  }

  .goal-spark-title__heading {
    font-family: 'Barlow'
    , sans-serif !important;
    font-weight: 700 !important;
    font-size: 40px;
    line-height: 42px;
    letter-spacing: 0;
    text-align: center;
    margin: 0 0 60px;
    color: inherit;
  }

  .spark-highlight {
    color: #EB701F;
  }

  .strength-cards-grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 32px;
    width: 100%;
    max-width: none;
    margin: 0;
    justify-content: center;
    padding: 0;
  }

  /* Layout inteligente baseado no número de itens */
  .strength-cards-grid.few-items {
    display: flex !important;
    flex-wrap: nowrap !important;
    justify-content: center !important;
    max-width: 100% !important;
    margin: 0 auto !important;
    gap: 32px !important;
    padding: 0 20px !important;
  }

  .strength-cards-grid.many-items {
    display: flex !important;
    flex-wrap: nowrap !important;
    justify-content: flex-start !important;
    max-width: none !important;
    margin: 0 !important;
    overflow-x: auto !important;
    scroll-snap-type: x mandatory !important;
  }

  /* Scroll profissional e suave */
  .strength-cards-grid.many-items {
    display: flex !important;
    flex-wrap: nowrap !important;
    justify-content: flex-start !important;
    max-width: none !important;
    margin: 0 !important;
    overflow-x: auto !important;
    scroll-snap-type: x mandatory !important;
    scrollbar-width: thin !important;
    scrollbar-color: #EB701F #f0f0f0 !important;
  }

  /* Estilizar scrollbar para webkit */
  .strength-cards-grid.many-items::-webkit-scrollbar {
    height: 8px !important;
  }

  .strength-cards-grid.many-items::-webkit-scrollbar-track {
    background: #f0f0f0 !important;
    border-radius: 4px !important;
  }

  .strength-cards-grid.many-items::-webkit-scrollbar-thumb {
    background: #EB701F !important;
    border-radius: 4px !important;
    transition: background 0.3s ease !important;
  }

  .strength-cards-grid.many-items::-webkit-scrollbar-thumb:hover {
    background: #d65a0f !important;
  }

  /* Scroll snap para cada card */
  .strength-cards-grid.many-items .strength-card {
    min-width: 460px;
    max-width: 500px;
    margin: 0;
    flex-shrink: 0;
    scroll-snap-align: start !important;
  }

  .strength-card {
    background: #ffffff;
    border-radius: 35px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease
    , box-shadow 0.3s ease;
    width: 100%;
    max-width: 500px !important;
    margin: 0;
    flex-shrink: 1;
    flex-grow: 1;
  }

  /* Centralizar quando há 3 itens ou menos - SEM SCROLL */
  .strength-cards-grid.few-items .strength-card {
    width: 100% !important;
    max-width: 500px !important;
    margin: 0 !important;
    flex-shrink: 1 !important;
    flex-grow: 1 !important;
  }

  /* Quando há mais de 3 itens, deixa como scroll horizontal */
  .strength-cards-grid.many-items .strength-card {
    width: 100%;
    max-width: 500px;
    margin: 0;
    flex-shrink: 0;
    scroll-snap-align: start !important;
  }

  .strength-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
  }

  .strength-card__image {
    width: 100%;
    height: 310px;
    overflow: hidden;
    border-radius: 35px;
  }

  .strength-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* Posiciona a imagem no topo e centralizada horizontalmente */
    display: block;
    border-radius: 35px;
  }
  .strength-card__image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 35px;
  }

  .strength-card__content {
    padding: 40px 22px;
  }

  .strength-card__title {
    font-family: 'Barlow'
    , sans-serif !important;
    font-weight: 700 !important;
    font-size: 30px;
    line-height: 31px;
    letter-spacing: 0;
    color: #000000;
    margin: 0 0 16px;
    width: 100%;
    max-width: 380px;
  }

  .strength-card__quote {
    font-family: 'Barlow'
    , sans-serif !important;

    font-style: italic;
    font-size: 18px;
    line-height: 20px;
    letter-spacing: 0;
    color: #EB701F;
    margin: 0;
    width: 100%;
    max-width: 420px;
  }

  .strength-card__quote,
  .mobile-card__quote {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .strength-card__quote.is-expanded,
  .mobile-card__quote.is-expanded {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .strength-card__read-more {
    display: inline-block;
    margin-top: 10px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #EB701F;
    font-family: 'Barlow', sans-serif !important;
    font-size: 15px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0;
    text-decoration: underline;
    cursor: pointer;
  }

  .spark-text {
    font-weight: 700 !important;
    color: #EB701F;
  }

  .strength-card__simple-text {
    font-family: 'Barlow'
    , sans-serif !important;

    font-size: 18px;
    line-height: 24px;
    letter-spacing: 0;
    color: #000000;
    margin: 0;
    width: 100%;
    max-width: 420px;
  }

  .mobile-card__simple-text {
    font-family: 'Barlow'
    , sans-serif !important;

    font-size: 18px;
    line-height: 24px;
    letter-spacing: 0;
    color: #000000;
    margin: 0;
    width: 100%;
    max-width: 420px;
  }

  /* Desktop/Tablet Grid - removido display none, agora usando remoção do DOM */

  /* Mobile Components */.mobile-slider-container {
    position: relative;
    width: 100%;
    overflow: visible;
  }

  .mobile-card {
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 35px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .mobile-card.hidden {
    display: none;
  }

  .mobile-card__image {
    width: 100%;
    height: 400px;
    overflow: visible;
    border-radius: 35px;
    aspect-ratio: 1 / 1;
  }

  .mobile-card__image img,
  .mobile-card__image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 35px;
  }

  .mobile-card__content {
    padding: 34px 17px;
  }

  .mobile-card__title {
    font-family: 'Barlow'
    , sans-serif !important;
    font-weight: 700 !important;
    font-size: 30px;
    line-height: 31px;
    letter-spacing: 0;
    color: #000000;
    margin: 0 0 16px;
    width: 100%;
    max-width: 300px;
  }

  .mobile-card__quote {
    font-family: 'Barlow'
    , sans-serif !important;

    font-style: italic;
    font-size: 18px;
    line-height: 20px;
    letter-spacing: 0;
    color: #EB701F;
    margin: 0;
    width: 100%;
    max-width: 350px;
  }

  /* Mobile Dots */
  .mobile-dots {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }

  .mobile-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    background-color: #E0E0E0;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .mobile-dot.active,
  .mobile-dot:hover {
    background-color: #EB701F;
  }

  /* Responsive Breakpoints - 2 por linha em telas médias */
  @media (max-width: 1199px) and (min-width: 1025px) {
    .strength-cards-grid.few-items {
      justify-content: center !important;
      max-width: 100% !important;
    }

    .strength-cards-grid.many-items {
      justify-content: flex-start !important;
      max-width: none !important;
    }
  }

  /* Mobile breakpoint - a partir de 1024px para baixo */
  @media (max-width: 1024px) {
    .goal-spark-title {
      margin: 0;
    }
    .goal-spark-title__heading {
      font-size: 32px;
      line-height: 36px;
      margin-bottom: 40px;
    }

    .mobile-card.hidden {
      display: none !important;
    }

    .mobile-dots {
      display: flex !important;
    }
  }

  @media (max-width: 768px) {
    .strength-cards-mobile {
      padding: 0 15px;
    }
  }

  @media (max-width: 480px) {
    .strength-cards-mobile {
      padding: 0 10px;
    }

    .mobile-card__content {
      padding: 20px;
    }
  }

  /* Responsive Breakpoints - Ajuste automático sem scroll */
  @media (max-width: 1400px) and (min-width: 1025px) {
    .strength-cards-grid.few-items {
      gap: 15px !important;
    }

    .strength-cards-grid.few-items .strength-card {
      max-width: 450px !important;
    }
  }

  @media (max-width: 1200px) and (min-width: 1025px) {
    .strength-cards-grid.few-items {
      gap: 12px !important;
    }

    .strength-cards-grid.few-items .strength-card {
      max-width: 380px !important;
    }
  }

  @media (max-width: 1100px) and (min-width: 1025px) {
    .strength-cards-grid.few-items {
      gap: 10px !important;
    }

    .strength-cards-grid.few-items .strength-card {
      max-width: 300px !important;
    }
  }

  @media (max-width: 1024px) and (min-width: 1025px) {
    .strength-cards-grid.few-items {
      gap: 8px !important;
    }

    .strength-cards-grid.few-items .strength-card {
      max-width: 260px !important;
    }
  }
</style>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    
      function initializeSection() {
        const section = document.querySelector('[data-section-id="' + sectionId + '"]');
        if (!section) return;

        section.addEventListener('click', (event) => {
          const button = event.target.closest('[data-strength-card-read-more]');
          if (!button || !section.contains(button)) return;

          const quote = button.previousElementSibling;
          if (!quote) return;

          const isExpanded = quote.classList.toggle('is-expanded');
          button.textContent = isExpanded ? 'Read less' : 'Read more';
        });

        function updateReadMoreButtons() {
          section.querySelectorAll('[data-strength-card-read-more]').forEach((button) => {
            const quote = button.previousElementSibling;
            if (!quote) return;

            const wasExpanded = quote.classList.contains('is-expanded');
            if (wasExpanded) quote.classList.remove('is-expanded');

            button.hidden = quote.scrollHeight <= quote.clientHeight + 1;

            if (wasExpanded) quote.classList.add('is-expanded');
          });
        }
      
      // Responsividade Desktop/Mobile - Remoção completa do DOM
      let desktopContainer = section.querySelector('.strength-cards-desktop');
      let mobileContainer = section.querySelector('.strength-cards-mobile');
      
      // Guardar backups apenas uma vez
      const desktopBackup = desktopContainer ? desktopContainer.cloneNode(true) : null;
      const mobileBackup = mobileContainer ? mobileContainer.cloneNode(true) : null;
      
      function handleResize() {
        const isDesktop = window.innerWidth > 1024;
        
        // Buscar elementos novamente (podem ter sido removidos)
        desktopContainer = section.querySelector('.strength-cards-desktop');
        mobileContainer = section.querySelector('.strength-cards-mobile');
        
        if (isDesktop) {
          // Desktop: remover mobile completamente do DOM
          if (mobileContainer && mobileContainer.parentNode) {
            mobileContainer.remove();
            mobileContainer = null;
          }
          
          // Garantir desktop existe
          if (!desktopContainer && desktopBackup) {
            const container = section.querySelector('.container');
            if (container) {
              const heading = container.querySelector('.goal-spark-title__heading');
              const newDesktop = desktopBackup.cloneNode(true);
              if (heading) {
                heading.insertAdjacentElement('afterend', newDesktop);
              } else {
                container.appendChild(newDesktop);
              }
              desktopContainer = newDesktop;
              // Re-inicializar layout desktop após restaurar
              setTimeout(initializeDesktopLayout, 100);
              setTimeout(updateReadMoreButtons, 120);
            }
          } else if (desktopContainer) {
            // Re-inicializar layout desktop se já existe
            initializeDesktopLayout();
          }
        } else {
          // Mobile: remover desktop completamente do DOM
          if (desktopContainer && desktopContainer.parentNode) {
            desktopContainer.remove();
            desktopContainer = null;
          }
          
          // Garantir mobile existe
          if (!mobileContainer && mobileBackup) {
            const container = section.querySelector('.container');
            if (container) {
              const heading = container.querySelector('.goal-spark-title__heading');
              const newMobile = mobileBackup.cloneNode(true);
              // Remover atributo de inicialização se existir
              if (newMobile.dataset.initialized) {
                delete newMobile.dataset.initialized;
              }
              if (heading) {
                heading.insertAdjacentElement('afterend', newMobile);
              } else {
                container.appendChild(newMobile);
              }
              mobileContainer = newMobile;
              // Re-inicializar o slider mobile após restaurar
              setTimeout(initializeMobileSlider, 100);
              setTimeout(updateReadMoreButtons, 120);
            }
          } else if (mobileContainer) {
            // Se mobile já existe mas não está inicializado, inicializar
            if (mobileContainer.dataset.initialized !== 'true') {
              initializeMobileSlider();
            }
          }
        }
      }
      
      // Mobile Slider Functionality
      function initializeMobileSlider() {
        const currentMobileContainer = section.querySelector('.strength-cards-mobile');
        if (!currentMobileContainer) return;
        
        // Evitar múltiplas inicializações
        if (currentMobileContainer.dataset.initialized === 'true') return;
        currentMobileContainer.dataset.initialized = 'true';
        
        const mobileDotsContainer = currentMobileContainer.querySelector('.mobile-dots') || 
                                     document.getElementById('mobile-dots-' + sectionId);
        const mobileCards = currentMobileContainer.querySelectorAll('.mobile-card');
        if (mobileCards.length === 0) return;
        
        let currentSlide = 0;
        
        function showMobileSlide(index) {
          if (index < 0 || index >= mobileCards.length) return;
          
          mobileCards.forEach((card, i) => {
            card.classList.toggle('hidden', i !== index);
          });
          
          if (mobileDotsContainer) {
            const mobileDots = mobileDotsContainer.querySelectorAll('.mobile-dot');
            mobileDots.forEach((dot, i) => {
              dot.classList.toggle('active', i === index);
            });
          }
          
          currentSlide = index;

          requestAnimationFrame(() => {
            updateReadMoreButtons();
          });
        }
        
        // Add click events to dots
        if (mobileDotsContainer) {
          const mobileDots = mobileDotsContainer.querySelectorAll('.mobile-dot');
          mobileDots.forEach((dot, index) => {
            dot.addEventListener('click', () => showMobileSlide(index));
          });
        }
        
        // Touch/swipe support
        let touchStartX = 0;
        let touchMoved = false;
        
        currentMobileContainer.addEventListener('touchstart', (e) => {
          if (window.innerWidth > 1024) return;
          touchStartX = e.touches[0].clientX;
          touchMoved = false;
        }, { passive: true });
        
        currentMobileContainer.addEventListener('touchmove', (e) => {
          if (window.innerWidth > 1024) return;
          const deltaX = Math.abs(e.touches[0].clientX - touchStartX);
          if (deltaX > 15) {
            touchMoved = true;
            e.preventDefault();
          }
        }, { passive: false });
        
        currentMobileContainer.addEventListener('touchend', (e) => {
          if (window.innerWidth > 1024 || !touchMoved) return;
          
          const touchEndX = e.changedTouches[0].clientX;
          const deltaX = touchEndX - touchStartX;
          const threshold = 75;
          
          if (Math.abs(deltaX) > threshold) {
            if (deltaX > 0 && currentSlide > 0) {
              showMobileSlide(currentSlide - 1);
            } else if (deltaX < 0 && currentSlide < mobileCards.length - 1) {
              showMobileSlide(currentSlide + 1);
            }
          }
        }, { passive: true });
        
        showMobileSlide(0);
      }
      
      // Desktop Layout Management
      function initializeDesktopLayout() {
        const currentDesktopContainer = section.querySelector('.strength-cards-desktop');
        if (!currentDesktopContainer) return;
        
        const strengthCardsGrid = currentDesktopContainer.querySelector('.strength-cards-grid');
        if (!strengthCardsGrid) return;
        
        const strengthCards = strengthCardsGrid.querySelectorAll('.strength-card');
        const totalCards = strengthCards.length;
        
        // Função para aplicar layout responsivo
        function applyResponsiveLayout() {
          const windowWidth = window.innerWidth;
          
          if (totalCards <= 3) {
            // 3 itens ou menos: centralizar na mesma linha (SEM SCROLL)
            strengthCardsGrid.classList.add('few-items');
            strengthCardsGrid.classList.remove('many-items');
            strengthCardsGrid.style.overflowX = 'visible';
            
            // Calcular gap dinamicamente baseado na largura disponível
            const containerWidth = windowWidth - 40; // 20px padding de cada lado
            const cardMaxWidth = 500; // Largura máxima do card
            const totalCardsWidth = totalCards * cardMaxWidth;
            const availableSpace = containerWidth - totalCardsWidth;
            
            if (availableSpace > 0) {
              // Se há espaço suficiente, usar gap padrão
              const gap = Math.min(32, availableSpace / (totalCards + 1));
              strengthCardsGrid.style.gap = gap + 'px';
            } else {
              // Se não há espaço suficiente, reduzir gap progressivamente
              let gap = 32;
              if (windowWidth <= 1024) gap = 8;
              else if (windowWidth <= 1100) gap = 10;
              else if (windowWidth <= 1200) gap = 12;
              else if (windowWidth <= 1400) gap = 15;
              else gap = 32;
              strengthCardsGrid.style.gap = gap + 'px';
            }
          } else {
            // Mais de 3 itens: scroll horizontal profissional
            strengthCardsGrid.classList.add('many-items');
            strengthCardsGrid.classList.remove('few-items');
            strengthCardsGrid.style.overflowX = 'auto';
          }
        }
        
        // Aplicar layout inicial
        applyResponsiveLayout();
        
        // Aplicar layout quando a janela for redimensionada
        let resizeTimeout;
        window.addEventListener('resize', function() {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(applyResponsiveLayout, 100);
        });
      }
      
      // Set initial state
      handleResize();
      setTimeout(updateReadMoreButtons, 100);
      
      // Listen for resize
      let resizeTimeout;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          handleResize();
          updateReadMoreButtons();
        }, 100);
      });
      
      // Inicializar slider mobile se estiver visível
      if (window.innerWidth <= 1024) {
        initializeMobileSlider();
      }
    }
    
    // Inicializar quando o DOM estiver pronto
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeSection);
    } else {
      initializeSection();
    }
  })();
</script>

