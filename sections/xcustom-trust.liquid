{% liquid
  assign container_class = 'xcustom-trust--contained'

  if section.settings.full_width
    assign container_class = 'xcustom-trust--full'
  endif
%}

<section
  id="XCustomTrust-{{ section.id }}"
  class="xcustom-trust {{ container_class }}"
>
  <div class="xcustom-trust__inner">
    <div class="xcustom-trust__container">
      <div class="xcustom-trust__list">
        {% for block in section.blocks %}
          {% liquid
            assign trust_icon = block.settings.icon
            assign trust_heading = block.settings.heading | downcase

            if trust_heading contains 'warranty'
              assign trust_icon = 'warranty'
            endif
          %}

          <div
            class="xcustom-trust__item"
            {{ block.shopify_attributes }}
          >
            <div class="xcustom-trust__icon" aria-hidden="true">
              {% case trust_icon %}
                {% when 'shipping' %}
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 6h11v10H3V6Z" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M14 9h3.5L21 12.5V16h-7V9Z" stroke="currentColor" stroke-width="1.8"/>
                    <circle cx="7" cy="18" r="2" stroke="currentColor" stroke-width="1.8"/>
                    <circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="1.8"/>
                  </svg>

                {% when 'saving' %}
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 3v18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M16 7.5c0-1.66-1.79-3-4-3s-4 1.34-4 3 1.79 3 4 3 4 1.34 4 3-1.79 3-4 3-4-1.34-4-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>

                {% when 'warranty' %}
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 3.5 18.5 6v5.2c0 4.1-2.6 7.4-6.5 9.3-3.9-1.9-6.5-5.2-6.5-9.3V6L12 3.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="m8.5 12 2.2 2.2 4.8-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>

                {% when 'return' %}
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M8 7H4V3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M4.5 7A8 8 0 1 1 4 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>

                {% when 'check' %}
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>

                {% when 'arrow' %}
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M6 18 18 6M9 6h9v9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
              {% endcase %}
            </div>

            <div class="xcustom-trust__content">
              {% if block.settings.heading != blank %}
                <div class="xcustom-trust__heading">
                  {{ block.settings.heading | escape }}
                </div>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="xcustom-trust__description">
                  {{ block.settings.description | escape }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  #XCustomTrust-{{ section.id }} {
    --xcustom-trust-bg: {{ section.settings.background_color }};
    --xcustom-trust-heading: {{ section.settings.heading_color }};
    --xcustom-trust-text: {{ section.settings.description_color }};
    --xcustom-trust-accent: {{ section.settings.accent_color }};
    --xcustom-trust-icon-bg: rgba(255, 255, 255, 0.09);
    --xcustom-trust-divider: rgba(255, 255, 255, 0.16);

    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
  }

  #XCustomTrust-{{ section.id }},
  #XCustomTrust-{{ section.id }} *,
  #XCustomTrust-{{ section.id }} *::before,
  #XCustomTrust-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #XCustomTrust-{{ section.id }} .xcustom-trust__inner {
    width: 100%;
    margin: 0 auto;
    background-color: var(--xcustom-trust-bg);
  }

  #XCustomTrust-{{ section.id }} .xcustom-trust__container {
    width: 100%;
    max-width: 1400px;
    margin-right: auto;
    margin-left: auto;
  }

  #XCustomTrust-{{ section.id }}.xcustom-trust--contained {
    padding-right: 16px;
    padding-left: 16px;
  }

  #XCustomTrust-{{ section.id }}.xcustom-trust--contained .xcustom-trust__inner {
    max-width: 1200px;
    margin-right: auto;
    margin-left: auto;
  }

  #XCustomTrust-{{ section.id }} .xcustom-trust__list {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr));
    width: 100%;
    padding: 0 0;
  }

  #XCustomTrust-{{ section.id }} .xcustom-trust__item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.content_alignment }};
    gap: 16px;
    min-width: 0;
    padding: {{ section.settings.item_vertical_padding }}px 24px;
  }

  #XCustomTrust-{{ section.id }} .xcustom-trust__item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 1px;
    height: 100%;
    background-color: var(--xcustom-trust-divider);
  }

  #XCustomTrust-{{ section.id }} .xcustom-trust__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    color: var(--xcustom-trust-accent);
    background-color: var(--xcustom-trust-icon-bg);
  }

  #XCustomTrust-{{ section.id }} .xcustom-trust__icon svg {
    display: block;
    width: 22px;
    height: 22px;
  }

  #XCustomTrust-{{ section.id }} .xcustom-trust__content {
    min-width: 0;
  }

  #XCustomTrust-{{ section.id }} .xcustom-trust__heading {
    margin: 0;
    color: var(--xcustom-trust-heading);
    font-family: inherit;
    font-size: clamp(15px, 1.1vw, 18px);
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: break-word;
  }

  #XCustomTrust-{{ section.id }} .xcustom-trust__description {
    margin-top: 4px;
    color: var(--xcustom-trust-text);
    font-family: inherit;
    font-size: clamp(12px, 0.9vw, 14px);
    font-weight: 400;
    line-height: 1.35;
    overflow-wrap: break-word;
  }

  @media screen and (max-width: 989px) {
    #XCustomTrust-{{ section.id }} .xcustom-trust__item {
      gap: 14px;
      padding-right: 16px;
      padding-left: 16px;
    }

    #XCustomTrust-{{ section.id }} .xcustom-trust__icon {
      width: 44px;
      height: 44px;
    }

    #XCustomTrust-{{ section.id }} .xcustom-trust__icon svg {
      width: 20px;
      height: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    #XCustomTrust-{{ section.id }} .xcustom-trust__list {
      grid-template-columns: 1fr;
    }

    #XCustomTrust-{{ section.id }} .xcustom-trust__item {
      justify-content: flex-start;
      width: 100%;
      padding: {{ section.settings.item_vertical_padding_mobile }}px 16px;
    }

    #XCustomTrust-{{ section.id }} .xcustom-trust__item:not(:last-child)::after {
      top: auto;
      right: 0;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "XCustom Trust",
  "tag": "section",
  "class": "section-xcustom-trust",
  "max_blocks": 3,
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Core layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Desktop item alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "item_vertical_padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Desktop item height",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_vertical_padding_mobile",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Mobile item height",
      "default": 12
    },
    {
      "type": "header",
      "content": "Core colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description",
      "default": "#AFAFAF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icon accent",
      "default": "#EB7122"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "shipping",
              "label": "Shipping"
            },
            {
              "value": "saving",
              "label": "Savings"
            },
            {
              "value": "warranty",
              "label": "Warranty"
            },
            {
              "value": "return",
              "label": "Returns"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "arrow",
              "label": "Arrow"
            }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free U.S. shipping"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "XCustom Trust",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "shipping",
            "heading": "Free U.S. shipping",
            "description": ""
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "saving",
            "heading": "Buy any 2 items — each drops $10",
            "description": ""
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "return",
            "heading": "30-day returns",
            "description": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
