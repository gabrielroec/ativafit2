<section
  data-section-id="{{ section.id }}"
  data-section-type="product-features"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container feature-container">
    {%- liquid
      assign feature_items = product.metafields.custom.product_features.value
      assign use_metaobject = false
      if feature_items != blank and feature_items.size > 0
        assign use_metaobject = true
      else
        assign feature_items = section.blocks
      endif
    -%}

    {%- if feature_items.size > 0 -%}
      {%- for item in feature_items -%}
        {%- liquid
          if use_metaobject
            assign feature_image = item.feature_image
            assign feature_title_raw = item.feature_title
            assign feature_text = item.feature_text
            assign image_position = item.image_position | default: 'left'
            assign shopify_attrs = ''
          else
            assign feature_image = item.settings.feature_image
            assign feature_title_raw = item.settings.feature_title
            assign feature_text = item.settings.feature_text
            assign image_position = item.settings.image_position | default: 'left'
            assign shopify_attrs = item.shopify_attributes
          endif

          assign title_normalized = feature_title_raw | replace: '</hight>', '<high>' | replace: '</high>', '<high>' | replace: '<hight>', '<high>'
          assign title_parts = title_normalized | split: '<high>'
        -%}
        <div
          class="feature-row{% if image_position == 'right' %} reverse{% endif %}"
          {{ shopify_attrs }}>
          <div class="feature-image">
            {%- if feature_image != blank -%}
              <img
                src="{{ feature_image | image_url: width: 600, height: 400 }}"
                alt="{{ feature_image.alt | default: feature_title_raw }}"
                width="600"
                height="400"
                loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-image' }}
            {%- endif -%}
          </div>

          <div class="feature-content">
            {%- if feature_title_raw != blank -%}
              <h3 class="feature-title">
                {%- for part in title_parts -%}
                  {%- assign idx_mod = forloop.index0 | modulo: 2 -%}
                  {%- if idx_mod == 1 -%}
                    <span class="highlight-text">{{ part | newline_to_br }}</span>
                  {%- else -%}
                    {{ part | newline_to_br }}
                  {%- endif -%}
                {%- endfor -%}
              </h3>
            {%- endif -%}

            {%- if feature_text != blank -%}
              <p class="feature-description">{{ feature_text | newline_to_br }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0;
  }

  .feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    margin-bottom: 20px;
    width: 100%;
  }

  .feature-row:last-child {
    margin-bottom: 0;
  }

  .feature-row.reverse {
    direction: rtl;
  }

  .feature-row.reverse .feature-image,
  .feature-row.reverse .feature-content {
    direction: ltr;
  }

  .feature-row.reverse .feature-content {
    padding-left: 80px;
  }

  .feature-image {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: 0 70px 70px 0;
  }

  .feature-row.reverse .feature-image {
    border-radius: 70px 0 0 70px;
  }

  .feature-image img,
  .feature-image svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .feature-content {
    padding: 0;
    width: 100%;
  }

  .feature-container .feature-title {
    font-family: 'Barlow', sans-serif !important;
    font-weight: 700 !important;
    font-size: 32px;
    line-height: 1.1;
    letter-spacing: 0;
    color: #000000;
    margin: 0 0 24px;
    max-width: 480px;
  }

  .highlight-text {
    color: #EB701F;
  }

  .feature-container .feature-description {
    font-family: 'Barlow', sans-serif !important;
    font-size: 20px;
    line-height: 1.24;
    letter-spacing: 0;
    color: #000;
    max-width: 480px;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .container {
      padding: 0 30px;
    }
    .feature-row {
      gap: 50px;
      margin-bottom: 70px;
    }
    .feature-container .feature-title {
      font-size: 26px;
    }
    .feature-container .feature-description {
      font-size: 18px;
    }
  }

  @media (max-width: 768px) {
    .feature-row {
      grid-template-columns: 1fr;
      gap: 30px;
      margin-bottom: 60px;
    }
    .feature-row.reverse {
      direction: ltr;
    }
    .feature-row.reverse .feature-content {
      padding-left: 0 !important;
    }
    .feature-content {
      text-align: center;
      order: 2;
    }
    .feature-image,
    .feature-row.reverse .feature-image {
      order: 1;
      border-radius: 16px;
      aspect-ratio: 4/3;
    }
    .feature-container .feature-title,
    .feature-container .feature-description {
      max-width: 100%;
      text-align: center;
    }
    .feature-container .feature-title {
      margin-bottom: 20px;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 15px;
    }
    .feature-row {
      gap: 30px;
      margin-bottom: 50px;
    }
    .feature-image,
    .feature-row.reverse .feature-image {
      border-radius: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Product Features",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Blocks below are used as fallback. Product metafield custom.product_features (list of product_feature metaobjects) takes priority when filled."
    },
    {
      "type": "header",
      "content": "Spacing Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature (fallback)",
      "settings": [
        {
          "type": "image_picker",
          "id": "feature_image",
          "label": "Feature Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image Position",
          "info": "Choose whether the image appears on the left or right side",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "textarea",
          "id": "feature_title",
          "label": "Feature Title",
          "info": "Wrap highlighted words with <high>...</high>. Line breaks (Enter) are preserved in the output.",
          "default": "One Set,\n<high>Every Movement</high>"
        },
        {
          "type": "textarea",
          "id": "feature_text",
          "label": "Feature Text",
          "default": "One dumbbell, every movement. Save space and unlock your full training potential."
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Product",
      "name": "Product Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "image_position": "left",
            "feature_title": "One Set,\n<high>Every Movement</high>",
            "feature_text": "One dumbbell, every movement. Save space and unlock your full training potential."
          }
        },
        {
          "type": "feature",
          "settings": {
            "image_position": "right",
            "feature_title": "Built to Last:\n<high>Solid Steel</high> Construction",
            "feature_text": "Made with durable steel plates and a secure locking system, LAVA dumbbells are designed for safety and long-term use."
          }
        },
        {
          "type": "feature",
          "settings": {
            "image_position": "left",
            "feature_title": "Quick & Easy Weight Change:\n<high>3-Second</high> Switch",
            "feature_text": "Switch weights in just 3 seconds with a simple handle twist. Perfect for fast-paced workouts."
          }
        }
      ]
    }
  ]
}{% endschema %}
