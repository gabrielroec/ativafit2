{%- liquid
  assign sid = section.id
  assign sc = section.settings
  assign slides_count = 0
  for i in (1..5)
    assign key = 'slide_' | append: i | append: '_enabled'
    if sc[key]
      assign slides_count = slides_count | plus: 1
    endif
  endfor
-%}

{%- comment -%}
  LCP preload moved to layout/theme.liquid <head> for earlier discovery.
  Browser preload scanner finds it ~1.5s sooner on Slow 4G.
{%- endcomment -%}

<script src="{{ 'hero-banner-slider.js' | asset_url }}" defer></script>

{% style %}
  .hero-slider-{{ sid }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: {{ sc.background_color }};
  }

  .hero-slider-{{ sid }} [data-slider-track] {
    display: flex;
    transition: transform 0.4s ease;
  }

  .hero-slider-{{ sid }} [data-slider-slide] {
    flex: 0 0 100%;
    min-width: 0;
    position: relative;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .hero-slider-{{ sid }} .hero-slider__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ sc.mobile_aspect_ratio_width }} / {{ sc.mobile_aspect_ratio_height }};
    overflow: hidden;
  }

  .hero-slider-{{ sid }} .hero-slider__media img,
  .hero-slider-{{ sid }} .hero-slider__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-slider-{{ sid }} .hero-slider__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ sc.overlay_opacity }});
    pointer-events: none;
  }

  .hero-slider-{{ sid }} .hero-slider__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    text-align: center;
    color: {{ sc.text_color }};
    pointer-events: none;
  }

  .hero-slider-{{ sid }} .hero-slider__content--left {
    align-items: flex-start;
    text-align: left;
  }

  .hero-slider-{{ sid }} .hero-slider__content--right {
    align-items: flex-end;
    text-align: right;
  }

  .hero-slider-{{ sid }} .hero-slider__title {
    font-size: {{ sc.title_size | times: 0.65 | round }}px;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .hero-slider-{{ sid }} .hero-slider__subtitle {
    font-size: {{ sc.subtitle_size | times: 0.85 | round }}px;
    margin: 12px 0 0;
    line-height: 1.5;
  }

  .hero-slider-{{ sid }} .hero-slider__btn {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 28px;
    font-size: {{ sc.button_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ sc.button_border_radius }}px;
    background: {{ sc.button_bg_color }};
    color: {{ sc.button_text_color }};
    pointer-events: auto;
    transition: background 0.2s, color 0.2s;
  }

  .hero-slider-{{ sid }} .hero-slider__btn:hover {
    background: {{ sc.button_hover_bg_color }};
    color: {{ sc.button_hover_text_color }};
  }

  .hero-slider-{{ sid }} .hero-slider__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: {{ sc.nav_bg_color }};
    color: {{ sc.nav_icon_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    opacity: 0.85;
  }

  .hero-slider-{{ sid }} .hero-slider__nav:hover {
    opacity: 1;
  }

  .hero-slider-{{ sid }} .hero-slider__nav--prev { left: 16px; }
  .hero-slider-{{ sid }} .hero-slider__nav--next { right: 16px; }

  .hero-slider-{{ sid }} .hero-slider__dots {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .hero-slider-{{ sid }} .hero-slider__dot {
    width: 10px;
    height: 10px;
    border: 0;
    border-radius: 50%;
    background: {{ sc.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.2s;
  }

  .hero-slider-{{ sid }} .hero-slider__dot.active {
    opacity: 1;
  }

  .hero-slider-{{ sid }} .hero-slider__vid-d { display: none; }

  @media (min-width: 750px) {
    .hero-slider-{{ sid }} .hero-slider__media {
      aspect-ratio: {{ sc.desktop_aspect_ratio_width }} / {{ sc.desktop_aspect_ratio_height }};
    }
    .hero-slider-{{ sid }} .hero-slider__title {
      font-size: {{ sc.title_size }}px;
    }
    .hero-slider-{{ sid }} .hero-slider__subtitle {
      font-size: {{ sc.subtitle_size }}px;
    }
    .hero-slider-{{ sid }} .hero-slider__vid-d { display: block; }
    .hero-slider-{{ sid }} .hero-slider__vid-m { display: none; }
  }

  @media (max-width: 749px) {
    .hero-slider-{{ sid }} .hero-slider__nav {
      width: 36px;
      height: 36px;
    }
    .hero-slider-{{ sid }} .hero-slider__nav--prev { left: 8px; }
    .hero-slider-{{ sid }} .hero-slider__nav--next { right: 8px; }
  }
{% endstyle %}

<section
  class="hero-slider-{{ sid }}"
  data-hero-slider
  data-autoplay="{{ sc.enable_autoplay }}"
  data-autoplay-speed="{{ sc.autoplay_speed }}"
  aria-label="Hero banner"
  {{ section.shopify_attributes }}
>
  <div data-slider-track>
    {%- for i in (1..5) -%}
      {%- liquid
        assign ek = 'slide_' | append: i | append: '_enabled'
        unless sc[ek]
          continue
        endunless

        assign dk = 'slide_' | append: i | append: '_desktop_image'
        assign mk = 'slide_' | append: i | append: '_mobile_image'
        assign dvk = 'slide_' | append: i | append: '_desktop_video'
        assign mvk = 'slide_' | append: i | append: '_mobile_video'
        assign tk = 'slide_' | append: i | append: '_title'
        assign sk = 'slide_' | append: i | append: '_subtitle'
        assign ak = 'slide_' | append: i | append: '_text_alignment'
        assign blk = 'slide_' | append: i | append: '_button_label'
        assign buk = 'slide_' | append: i | append: '_button_link'
        assign slk = 'slide_' | append: i | append: '_slide_link'

        assign d_img = sc[dk]
        assign m_img = sc[mk]
        assign d_vid = sc[dvk]
        assign m_vid = sc[mvk]
        assign s_title = sc[tk]
        assign s_subtitle = sc[sk]
        assign s_align = sc[ak]
        assign s_btn_label = sc[blk]
        assign s_btn_link = sc[buk]
        assign s_link = sc[slk]

        assign is_first = false
        if i == 1
          assign is_first = true
        endif

        assign has_video = false
        if d_vid != blank or m_vid != blank
          assign has_video = true
        endif

        assign has_text = false
        if s_title != blank or s_subtitle != blank or s_btn_label != blank
          assign has_text = true
        endif

        assign wrap_link = false
        if s_link != blank and s_btn_label == blank
          assign wrap_link = true
        endif
      -%}

      {%- if wrap_link -%}
        <a href="{{ s_link }}" data-slider-slide aria-label="Banner {{ forloop.index }}">
      {%- else -%}
        <div data-slider-slide>
      {%- endif -%}

        <div class="hero-slider__media">
          {%- if has_video -%}
            {%- if d_vid != blank -%}
              <video class="hero-slider__vid-d" autoplay muted loop playsinline
                {%- if d_img != blank %} poster="{{ d_img | image_url: width: 1920, format: 'webp' }}"{% endif %}>
                <source src="{{ d_vid }}" type="video/mp4">
              </video>
            {%- elsif d_img != blank -%}
              <img class="hero-slider__vid-d"
                src="{{ d_img | image_url: width: 1920, format: 'webp' }}"
                srcset="{{ d_img | image_url: width: 1024, format: 'webp' }} 1024w, {{ d_img | image_url: width: 1366, format: 'webp' }} 1366w, {{ d_img | image_url: width: 1920, format: 'webp' }} 1920w"
                sizes="100vw"
                alt="{{ d_img.alt | escape }}"
                loading="{%- if is_first -%}eager{%- else -%}lazy{%- endif -%}"
                fetchpriority="{%- if is_first -%}high{%- else -%}low{%- endif -%}"
                width="{{ d_img.width }}" height="{{ d_img.height }}">
            {%- endif -%}
            {%- if m_vid != blank -%}
              <video class="hero-slider__vid-m" autoplay muted loop playsinline
                {%- if m_img != blank %} poster="{{ m_img | image_url: width: 720, format: 'webp' }}"{% endif %}>
                <source src="{{ m_vid }}" type="video/mp4">
              </video>
            {%- elsif m_img != blank -%}
              <img class="hero-slider__vid-m"
                src="{{ m_img | image_url: width: 720, format: 'webp' }}"
                srcset="{{ m_img | image_url: width: 320, format: 'webp' }} 320w, {{ m_img | image_url: width: 480, format: 'webp' }} 480w, {{ m_img | image_url: width: 600, format: 'webp' }} 600w, {{ m_img | image_url: width: 720, format: 'webp' }} 720w"
                sizes="100vw"
                alt="{{ m_img.alt | escape }}"
                loading="{%- if is_first -%}eager{%- else -%}lazy{%- endif -%}"
                fetchpriority="{%- if is_first -%}high{%- else -%}low{%- endif -%}"
                width="{{ m_img.width | default: 720 }}" height="{{ m_img.height | default: 720 }}">
            {%- endif -%}
          {%- else -%}
            {%- if d_img != blank and m_img != blank -%}
              <picture>
                <source
                  media="(min-width: 750px)"
                  srcset="{{ d_img | image_url: width: 1024, format: 'webp' }} 1024w, {{ d_img | image_url: width: 1366, format: 'webp' }} 1366w, {{ d_img | image_url: width: 1920, format: 'webp' }} 1920w"
                  sizes="100vw">
                <img
                  src="{{ m_img | image_url: width: 720, format: 'webp' }}"
                  srcset="{{ m_img | image_url: width: 320, format: 'webp' }} 320w, {{ m_img | image_url: width: 480, format: 'webp' }} 480w, {{ m_img | image_url: width: 600, format: 'webp' }} 600w, {{ m_img | image_url: width: 720, format: 'webp' }} 720w"
                  sizes="100vw"
                  alt="{{ m_img.alt | default: d_img.alt | escape }}"
                  loading="{%- if is_first -%}eager{%- else -%}lazy{%- endif -%}"
                  fetchpriority="{%- if is_first -%}high{%- else -%}low{%- endif -%}"
                  decoding="async"
                  width="{{ m_img.width | default: 723 }}"
                  height="{{ m_img.height | default: 721 }}">
              </picture>
            {%- elsif d_img != blank -%}
              <img
                src="{{ d_img | image_url: width: 1920, format: 'webp' }}"
                srcset="{{ d_img | image_url: width: 768, format: 'webp' }} 768w, {{ d_img | image_url: width: 1024, format: 'webp' }} 1024w, {{ d_img | image_url: width: 1366, format: 'webp' }} 1366w, {{ d_img | image_url: width: 1920, format: 'webp' }} 1920w"
                sizes="100vw"
                alt="{{ d_img.alt | escape }}"
                loading="{%- if is_first -%}eager{%- else -%}lazy{%- endif -%}"
                fetchpriority="{%- if is_first -%}high{%- else -%}low{%- endif -%}"
                decoding="async"
                width="{{ d_img.width }}" height="{{ d_img.height }}">
            {%- elsif m_img != blank -%}
              <img
                src="{{ m_img | image_url: width: 720, format: 'webp' }}"
                srcset="{{ m_img | image_url: width: 320, format: 'webp' }} 320w, {{ m_img | image_url: width: 480, format: 'webp' }} 480w, {{ m_img | image_url: width: 600, format: 'webp' }} 600w, {{ m_img | image_url: width: 720, format: 'webp' }} 720w"
                sizes="100vw"
                alt="{{ m_img.alt | escape }}"
                loading="{%- if is_first -%}eager{%- else -%}lazy{%- endif -%}"
                fetchpriority="{%- if is_first -%}high{%- else -%}low{%- endif -%}"
                decoding="async"
                width="{{ m_img.width | default: 723 }}" height="{{ m_img.height | default: 721 }}">
            {%- endif -%}
          {%- endif -%}

          {%- if sc.overlay_opacity > 0 -%}
            <div class="hero-slider__overlay" aria-hidden="true"></div>
          {%- endif -%}
        </div>

        {%- if has_text -%}
          <div class="hero-slider__content{%- if s_align != 'center' %} hero-slider__content--{{ s_align }}{%- endif -%}">
            {%- if s_title != blank -%}
              <h2 class="hero-slider__title">{{ s_title }}</h2>
            {%- endif -%}
            {%- if s_subtitle != blank -%}
              <p class="hero-slider__subtitle">{{ s_subtitle }}</p>
            {%- endif -%}
            {%- if s_btn_label != blank and s_btn_link != blank -%}
              <a href="{{ s_btn_link }}" class="hero-slider__btn">{{ s_btn_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- if wrap_link -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if slides_count > 1 -%}
    {%- if sc.show_arrows -%}
      <button class="hero-slider__nav hero-slider__nav--prev" data-slider-prev aria-label="Previous slide" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="hero-slider__nav hero-slider__nav--next" data-slider-next aria-label="Next slide" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    {%- endif -%}
    {%- if sc.show_dots -%}
      <nav class="hero-slider__dots" aria-label="Slide navigation">
        {%- assign dot_i = 0 -%}
        {%- for i in (1..5) -%}
          {%- assign ek = 'slide_' | append: i | append: '_enabled' -%}
          {%- if sc[ek] -%}
            <button class="hero-slider__dot{%- if dot_i == 0 %} active{%- endif -%}" data-slider-dot="{{ dot_i }}" aria-label="Go to slide {{ dot_i | plus: 1 }}" type="button"></button>
            {%- assign dot_i = dot_i | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
