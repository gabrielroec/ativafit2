{% liquid
  assign desktop_columns = section.settings.columns_desktop | default: 4
assign mobile_columns = section.settings.columns_mobile | default: 2 | plus: 0
  assign desktop_gap_total = section.settings.gap_desktop | times: desktop_columns | minus: section.settings.gap_desktop
  assign mobile_gap_total = section.settings.gap_mobile | times: mobile_columns | minus: section.settings.gap_mobile

  assign content_max_width = section.settings.content_max_width | default: 1280
  assign card_max_width = section.settings.card_max_width | default: 310
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color }};
  }

  #shopify-section-{{ section.id }} .tiktok-reels {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .tiktok-reels > .page-width {
    max-width: {{ content_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__header {
    text-align: center;
    margin-bottom: 36px;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__title {
    font-size: 36px;
    line-height: 1.2;
    margin: 0;
    color: {{ section.settings.title_color }};
  }

  #shopify-section-{{ section.id }} .tiktok-reels__track-wrap {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 12px;
    scrollbar-width: thin;
    scrollbar-color: rgba(17, 17, 17, 0.28) transparent;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__track-wrap::-webkit-scrollbar {
    height: 8px;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__track-wrap::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.06);
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__track-wrap::-webkit-scrollbar-thumb {
    background: rgba(17, 17, 17, 0.28);
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__track-wrap::-webkit-scrollbar-thumb:hover {
    background: rgba(17, 17, 17, 0.42);
  }

  #shopify-section-{{ section.id }} .tiktok-reels__track {
    display: flex;
    gap: {{ section.settings.gap_desktop }}px;
    align-items: flex-start;
    min-width: 100%;
    scroll-snap-type: x proximity;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__item {
    position: relative;
    flex: 0 0 min({{ card_max_width }}px, calc((100% - {{ desktop_gap_total }}px) / {{ desktop_columns }}));
    max-width: min({{ card_max_width }}px, calc((100% - {{ desktop_gap_total }}px) / {{ desktop_columns }}));
    min-width: 0;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__card {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: visible;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__media {
    position: relative;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: {{ section.settings.radius }}px;
    overflow: hidden;
    background: #f3f3f3;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__media video,
  #shopify-section-{{ section.id }} .tiktok-reels__media iframe,
  #shopify-section-{{ section.id }} .tiktok-reels__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    background: #000;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__cover {
    position: absolute;
    inset: 0;
    z-index: 2;
    transition: opacity 0.22s ease;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__cover img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__card.is-playing .tiktok-reels__cover {
    opacity: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__placeholder {
    width: 100%;
    height: 100%;
    background: #efefef;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888;
    font-size: 14px;
    text-align: center;
    padding: 20px;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__control {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 5;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.36);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__control:hover {
    background: rgba(17, 17, 17, 0.5);
  }

  #shopify-section-{{ section.id }} .tiktok-reels__control:active {
    transform: scale(0.96);
  }

  #shopify-section-{{ section.id }} .tiktok-reels__control--expand {
    top: auto;
    right: 14px;
    bottom: 14px;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__icon {
    position: relative;
    width: 16px;
    height: 16px;
    display: block;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__icon--play {
    width: 0;
    height: 0;
    border-left: 12px solid #fff;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    margin-left: 2px;
    display: block;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__icon--pause {
    display: none;
    width: 14px;
    height: 14px;
    position: relative;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__icon--pause::before,
  #shopify-section-{{ section.id }} .tiktok-reels__icon--pause::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    border-radius: 2px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__icon--pause::before {
    left: 1px;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__icon--pause::after {
    right: 1px;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__card.is-playing .tiktok-reels__icon--play {
    display: none;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__card.is-playing .tiktok-reels__icon--pause {
    display: block;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__expand-icon {
    width: 16px;
    height: 16px;
    box-sizing: border-box;
    border: 2px solid #fff;
    border-radius: 2px;
    display: block;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__card:not(.has-video) {
    cursor: default;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__card:not(.has-video) .tiktok-reels__control {
    display: none;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__scroll-ui {
    margin-top: 4px;
    display: flex;
    justify-content: flex-end;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__scroll-hint {
    font-size: 16px;
    line-height: 1.4;
    color: rgba(17, 17, 17, 0.58);
    margin-bottom: 8px;
    text-align: right;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease;
    z-index: 9998;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__overlay.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  #shopify-section-{{ section.id }} .tiktok-reels__item-title {
  margin: 0 0 12px;
  font-size: 18px;
  line-height: 1.25;
  font-weight: 700;
  color: #111;
  text-align: center;
  min-height: 45px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

@media only screen and (max-width: 767px) {
  #shopify-section-{{ section.id }} .tiktok-reels__item-title {
    margin-bottom: 8px;
    font-size: 14px;
    line-height: 1.25;
    min-height: 36px;
  }
}
  #shopify-section-{{ section.id }} .tiktok-reels__card.is-expanded {
    position: fixed;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(420px, calc(100vw - 32px));
    max-width: 420px;
    z-index: 9999;
  }

  #shopify-section-{{ section.id }} .tiktok-reels__card.is-expanded .tiktok-reels__media {
    width: 100%;
    aspect-ratio: 9 / 16;
    max-height: calc(100vh - 40px);
  }

  body.tiktok-reels-lock {
    overflow: hidden;
  }

  @media only screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .tiktok-reels__track {
      justify-content: center;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .tiktok-reels {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .tiktok-reels__header {
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .tiktok-reels__title {
      font-size: 24px;
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .tiktok-reels__track-wrap {
      padding-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .tiktok-reels__track-wrap::-webkit-scrollbar {
      height: 6px;
    }

    #shopify-section-{{ section.id }} .tiktok-reels__track {
      gap: {{ section.settings.gap_mobile }}px;
      justify-content: flex-start;
    }

    #shopify-section-{{ section.id }} .tiktok-reels__item {
      flex: 0 0 calc((100% - {{ mobile_gap_total }}px) / {{ mobile_columns }});
      max-width: calc((100% - {{ mobile_gap_total }}px) / {{ mobile_columns }});
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .tiktok-reels__control {
      top: 10px;
      right: 10px;
      width: 36px;
      height: 36px;
    }

    #shopify-section-{{ section.id }} .tiktok-reels__control--expand {
      right: 10px;
      bottom: 10px;
      top: auto;
    }

    #shopify-section-{{ section.id }} .tiktok-reels__scroll-ui {
      justify-content: flex-start;
    }

    #shopify-section-{{ section.id }} .tiktok-reels__scroll-hint {
      font-size: 14px;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .tiktok-reels__card.is-expanded {
      width: calc(100vw - 24px);
      max-width: none;
    }
  }
{% endstyle %}

<section class="tiktok-reels">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <div class="tiktok-reels__header">
        <h2 class="tiktok-reels__title">{{ section.settings.title }}</h2>
      </div>
    {% endif %}

    <div class="tiktok-reels__track-wrap" data-reel-scroller>
      <div class="tiktok-reels__track">
        {% for block in section.blocks %}
          {% liquid
            assign has_video = false
            if block.settings.shopify_video != blank or block.settings.video_mp4 != blank
              assign has_video = true
            endif

            assign image_loading = 'lazy'
            if forloop.index <= 4
              assign image_loading = 'eager'
            endif
          %}

          <div class="tiktok-reels__item" {{ block.shopify_attributes }}>
  <h3 class="tiktok-reels__item-title">
    {% if block.settings.video_title != blank %}
      {{ block.settings.video_title }}
    {% else %}
      &nbsp;
    {% endif %}
  </h3>

  <div class="tiktok-reels__card{% if has_video %} has-video{% endif %}" data-reel-card>
              <div
                class="tiktok-reels__media"
                {% if block.settings.poster_image != blank %}
                  data-poster="{{ block.settings.poster_image | image_url: width: 900 }}"
                {% endif %}
              >
                {% if block.settings.shopify_video != blank %}
                  {{
                    block.settings.shopify_video
                    | video_tag:
                      autoplay: false,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      preload: 'none',
                      class: 'tiktok-reels__video'
                  }}
                {% elsif block.settings.video_mp4 != blank %}
                  <video
                    class="tiktok-reels__video"
                    muted
                    loop
                    playsinline
                    preload="none"
                    {% if block.settings.poster_image != blank %}
                      poster="{{ block.settings.poster_image | image_url: width: 900 }}"
                    {% endif %}
                  >
                    <source src="{{ block.settings.video_mp4 }}" type="video/mp4">
                  </video>
                {% elsif block.settings.poster_image != blank %}
                  <img
                    src="{{ block.settings.poster_image | image_url: width: 900 }}"
                    alt=""
                    loading="{{ image_loading }}"
                    width="900"
                    height="1600"
                  >
                {% else %}
                  <div class="tiktok-reels__placeholder">Add vertical video</div>
                {% endif %}

                {% if has_video and block.settings.poster_image != blank %}
                  <div class="tiktok-reels__cover">
                    <img
                      src="{{ block.settings.poster_image | image_url: width: 900 }}"
                      alt=""
                      loading="{{ image_loading }}"
                      width="900"
                      height="1600"
                    >
                  </div>
                {% endif %}
              </div>

              {% if has_video %}
                <button
                  type="button"
                  class="tiktok-reels__control"
                  aria-label="Play or pause video"
                  data-reel-toggle
                >
                  <span class="tiktok-reels__icon">
                    <span class="tiktok-reels__icon--play"></span>
                    <span class="tiktok-reels__icon--pause"></span>
                  </span>
                </button>

                <button
                  type="button"
                  class="tiktok-reels__control tiktok-reels__control--expand"
                  aria-label="Expand video"
                  data-reel-expand
                >
                  <span class="tiktok-reels__expand-icon"></span>
                </button>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

  </div>

  <div class="tiktok-reels__overlay" data-reel-overlay></div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    const cards = Array.from(section.querySelectorAll('[data-reel-card]'));
    const overlay = section.querySelector('[data-reel-overlay]');

    if (!cards.length) return;

    const closeAllExpanded = () => {
      cards.forEach((card) => card.classList.remove('is-expanded'));
      if (overlay) overlay.classList.remove('is-active');
      document.body.classList.remove('tiktok-reels-lock');
    };

    const pauseAll = (exceptVideo = null) => {
      cards.forEach((card) => {
        const video = card.querySelector('video');
        if (!video || video === exceptVideo) return;

        video.pause();
        card.classList.remove('is-playing');
      });
    };

    cards.forEach((card) => {
      const video = card.querySelector('video');
      const toggleBtn = card.querySelector('[data-reel-toggle]');
      const expandBtn = card.querySelector('[data-reel-expand]');
      const media = card.querySelector('.tiktok-reels__media');
      const poster = media ? media.dataset.poster : '';

      if (!video) return;

      if (poster) {
        video.setAttribute('poster', poster);
        video.load();
      }

      video.pause();
      card.classList.remove('is-playing');

      const togglePlay = () => {
        if (video.paused) {
          pauseAll(video);

          video.play().then(() => {
            card.classList.add('is-playing');
          }).catch(() => {});
        } else {
          video.pause();
          card.classList.remove('is-playing');
        }
      };

      const toggleExpand = () => {
        const isExpanded = card.classList.contains('is-expanded');

        closeAllExpanded();

        if (!isExpanded) {
          card.classList.add('is-expanded');
          if (overlay) overlay.classList.add('is-active');
          document.body.classList.add('tiktok-reels-lock');
        }
      };

      card.addEventListener('click', (event) => {
        if (event.target.closest('[data-reel-toggle]')) return;
        if (event.target.closest('[data-reel-expand]')) return;

        togglePlay();
      });

      if (toggleBtn) {
        toggleBtn.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          togglePlay();
        });
      }

      if (expandBtn) {
        expandBtn.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          toggleExpand();
        });
      }

      video.addEventListener('pause', () => {
        card.classList.remove('is-playing');
      });

      video.addEventListener('play', () => {
        card.classList.add('is-playing');
      });
    });

    if (overlay) {
      overlay.addEventListener('click', closeAllExpanded);
    }

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAllExpanded();
    });
  })();
</script>

