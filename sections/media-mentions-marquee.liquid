{%- liquid
  assign sid = section.id
  assign duration = section.settings.marquee_seconds | default: 35
  if duration < 8
    assign duration = 8
  endif
-%}

{% style %}
  .mm-{{ sid }} {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .mm-{{ sid }} .mm__title {
    margin: 0 0 14px;
    font-family: "Barlow", "Barlow Fallback", sans-serif;
    font-weight: 900;
    font-size: 30px;
    line-height: 1.3;
    letter-spacing: -1px;
    text-transform: uppercase;
    text-align: center;
    color: {{ section.settings.title_color }};
  }
  .mm-{{ sid }} .mm__viewport {
    width: 100%;
    overflow: hidden;
  }
  {%- if section.settings.edge_fade -%}
  .mm-{{ sid }} .mm__viewport {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }
  {%- endif -%}
  .mm-{{ sid }} .mm__track {
    display: flex;
    width: max-content;
    animation: mm-scroll-{{ sid }} {{ duration }}s linear infinite;
  }
  .mm-{{ sid }} .mm__strip {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: {{ section.settings.logo_gap }}px;
    padding-right: {{ section.settings.logo_gap }}px;
  }
  .mm-{{ sid }} .mm__item {
    flex: 0 0 {{ section.settings.logo_min_width }}px;
    height: {{ section.settings.logo_max_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mm-{{ sid }} .mm__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: grayscale(1);
    opacity: 0.85;
  }
  .mm-{{ sid }} .mm__link {
    display: flex;
    align-items: center;
    line-height: 0;
    text-decoration: none;
  }
  .mm-{{ sid }} .mm__link:hover .mm__img {
    filter: grayscale(0);
    opacity: 1;
  }
  .mm-{{ sid }} .mm__viewport:hover .mm__track {
    animation-play-state: paused;
  }

  @keyframes mm-scroll-{{ sid }} {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-{{ sid }} .mm__viewport {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .mm-{{ sid }} .mm__track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      justify-content: center;
      row-gap: 24px;
    }
    .mm-{{ sid }} .mm__strip {
      flex-wrap: wrap;
      justify-content: center;
      padding-right: 0;
    }
    .mm-{{ sid }} .mm__strip[aria-hidden="true"] {
      display: none;
    }
  }
{% endstyle %}

<section class="mm-{{ sid }}" {{ section.shopify_attributes }}>
  {%- if section.settings.title != blank -%}
    <h2 class="mm__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  <div class="mm__viewport">
    <div class="mm__track">
      {%- for strip_index in (1..2) -%}
        <div class="mm__strip"{% if strip_index == 2 %} aria-hidden="true"{% endif %}>
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'logo' -%}
                {%- liquid
                  assign logo_img = block.settings.logo
                  assign logo_alt = block.settings.alt | default: 'Logo'
                  assign is_svg = false
                  if logo_img.src contains '.svg'
                    assign is_svg = true
                  endif
                -%}
                <div class="mm__item"{% if strip_index == 1 %} {{ block.shopify_attributes }}{% endif %}>
                  {%- if logo_img != blank -%}
                    {%- if block.settings.link != blank and strip_index == 1 -%}
                      <a href="{{ block.settings.link }}" class="mm__link" rel="noopener noreferrer" target="_blank">
                    {%- endif -%}
                    {%- if is_svg -%}
                      <img class="mm__img"
                        src="{{ logo_img | image_url }}"
                        alt="{% if strip_index == 1 %}{{ logo_alt | escape }}{% endif %}"
                        width="{{ section.settings.logo_min_width }}"
                        height="{{ section.settings.logo_max_height }}"
                        loading="lazy"
                        decoding="async"{% if strip_index == 2 %} aria-hidden="true"{% endif %}>
                    {%- else -%}
                      <img class="mm__img"
                        src="{{ logo_img | image_url: width: 240, format: 'webp' }}"
                        srcset="{{ logo_img | image_url: width: 120, format: 'webp' }} 120w, {{ logo_img | image_url: width: 180, format: 'webp' }} 180w, {{ logo_img | image_url: width: 240, format: 'webp' }} 240w"
                        sizes="240px"
                        alt="{% if strip_index == 1 %}{{ logo_alt | escape }}{% endif %}"
                        width="{{ section.settings.logo_min_width }}" height="{{ section.settings.logo_max_height }}"
                        loading="lazy"
                        decoding="async"
                        fetchpriority="low"{% if strip_index == 2 %} aria-hidden="true"{% endif %}>
                    {%- endif -%}
                    {%- if block.settings.link != blank and strip_index == 1 -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Media mentions (marquee)",
  "tag": "section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Media Mentions"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 28
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Space below title",
      "default": 32
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "min": 28,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo display height",
      "default": 56
    },
    {
      "type": "range",
      "id": "logo_min_width",
      "min": 72,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Min width per item",
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Gap between logos",
      "default": 48
    },
    {
      "type": "range",
      "id": "marquee_seconds",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "s",
      "label": "Full pass duration",
      "default": 35,
      "info": "Higher = slower motion. Animation pauses on hover."
    },
    {
      "type": "checkbox",
      "id": "edge_fade",
      "label": "Fade carousel edges",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Image (SVG or PNG recommended)" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Logo" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media mentions (marquee)",
      "category": "Trust & social proof",
      "blocks": [
        { "type": "logo", "settings": { "alt": "Vogue" } },
        { "type": "logo", "settings": { "alt": "GQ" } },
        { "type": "logo", "settings": { "alt": "Men's Health" } },
        { "type": "logo", "settings": { "alt": "Wired" } },
        { "type": "logo", "settings": { "alt": "Forbes" } }
      ]
    }
  ]
}
{% endschema %}
