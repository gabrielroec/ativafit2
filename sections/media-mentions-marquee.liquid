{%- liquid
  assign mm_id = 'media-mentions-' | append: section.id
  assign mm_blocks_count = section.blocks.size
  assign mm_duration = section.settings.marquee_seconds | default: 35
  if mm_duration < 8
    assign mm_duration = 8
  endif
  assign mm_strip_cycles = section.settings.strip_cycles | default: 3
  if mm_strip_cycles < 1
    assign mm_strip_cycles = 1
  endif
  if mm_strip_cycles > 12
    assign mm_strip_cycles = 12
  endif
  assign mm_logo_max_width = section.settings.logo_min_width | times: 28 | divided_by: 10
-%}

<link rel="preload" as="style" href="{{ 'media-mentions-marquee.css' | asset_url }}" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'media-mentions-marquee.css' | asset_url }}"></noscript>
<script src="{{ 'media-mentions-marquee.js' | asset_url }}" defer></script>

<section
  id="{{ mm_id }}"
  class="media-mentions-marquee"
  data-section-type="media-mentions-marquee"
  data-media-mentions-marquee
  style="
    --mm-bg: {{ section.settings.background_color | default: '#fff' }};
    --mm-pad-top: {{ section.settings.padding_top }}px;
    --mm-pad-bottom: {{ section.settings.padding_bottom }}px;
    --mm-logo-gap: {{ section.settings.logo_gap }}px;
    --mm-logo-min-width: {{ section.settings.logo_min_width }}px;
    --mm-logo-max-height: {{ section.settings.logo_max_height }}px;
    --mm-logo-max-width: {{ mm_logo_max_width }}px;
  ">
  <div class="media-mentions-marquee__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="media-mentions-marquee__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div
      class="media-mentions-marquee__viewport{% if section.settings.edge_fade %} media-mentions-marquee__viewport--fade{% endif %}"
      {% unless mm_blocks_count > 0 %}
        data-media-mentions-empty="true"
      {% endunless %}>
      <div
        class="media-mentions-marquee__track"
        data-media-mentions-track
        style="--mm-duration: {{ mm_duration }}s;">
        <div class="media-mentions-marquee__strip" data-media-mentions-strip>
          {%- if mm_blocks_count > 0 -%}
            {%- for mm_rep in (1..mm_strip_cycles) -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'logo' -%}
                  {%- assign mm_logo_alt = block.settings.alt | default: 'Logo' -%}
                  {%- liquid
                    assign mm_logo_img = block.settings.logo
                    assign mm_logo_src_low = mm_logo_img.src | default: '' | downcase
                    assign mm_logo_is_svg = false
                    if mm_logo_src_low contains '.svg'
                      assign mm_logo_is_svg = true
                    endif
                  -%}
                  <div
                    class="media-mentions-marquee__item"
                    {% if mm_rep == 1 %}
                      {{ block.shopify_attributes }}
                    {% endif %}>
                    {%- if mm_logo_img != blank -%}
                      {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}" class="media-mentions-marquee__link" rel="noopener noreferrer" target="_blank">
                      {%- endif -%}
                      {%- comment -%}
                        Logos are below the fold and the marquee animation only
                        starts when the section is in viewport (IntersectionObserver
                        in script below). loading="lazy" + decoding="async" lets
                        browsers skip 30+ logo bytes on initial pageload.
                      {%- endcomment -%}
                      {%- if mm_logo_is_svg -%}
                        <img
                          class="media-mentions-marquee__img"
                          src="{{ mm_logo_img | image_url }}"
                          alt="{{ mm_logo_alt | escape }}"
                          width="{{ mm_logo_img.width | default: 240 }}"
                          height="{{ mm_logo_img.height | default: 80 }}"
                          loading="lazy"
                          decoding="async">
                      {%- else -%}
                        {{
                          mm_logo_img
                          | image_url: width: 320, format: 'webp'
                          | image_tag:
                            loading: 'lazy',
                            decoding: 'async',
                            fetchpriority: 'low',
                            class: 'media-mentions-marquee__img',
                            widths: '120, 180, 240, 320',
                            sizes: '(min-width: 990px) 200px, min(40vw, 240px)',
                            alt: mm_logo_alt
                        }}
                      {%- endif -%}
                      {%- if block.settings.link != blank -%}
                        </a>
                      {%- endif -%}
                    {%- else -%}
                      <div class="media-mentions-marquee__placeholder">
                        <span class="media-mentions-marquee__placeholder-label">
                          {{- block.settings.alt | default: 'Logo' | escape -}}
                        </span>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- else -%}
            {%- for mm_rep in (1..mm_strip_cycles) -%}
              {%- for i in (1..7) -%}
                <div class="media-mentions-marquee__item">
                  <div class="media-mentions-marquee__placeholder">
                    <span class="media-mentions-marquee__placeholder-label">{{ 'Logo' | escape }}</span>
                  </div>
                </div>
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="media-mentions-marquee__strip" aria-hidden="true">
          {%- if mm_blocks_count > 0 -%}
            {%- for mm_rep in (1..mm_strip_cycles) -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'logo' -%}
                  {%- liquid
                    assign mm_logo_img_dup = block.settings.logo
                    assign mm_logo_src_low_dup = mm_logo_img_dup.src | default: '' | downcase
                    assign mm_logo_is_svg_dup = false
                    if mm_logo_src_low_dup contains '.svg'
                      assign mm_logo_is_svg_dup = true
                    endif
                  -%}
                  <div class="media-mentions-marquee__item">
                    {%- if mm_logo_img_dup != blank -%}
                      {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}" class="media-mentions-marquee__link" rel="noopener noreferrer" target="_blank" tabindex="-1">
                      {%- endif -%}
                      {%- if mm_logo_is_svg_dup -%}
                        <img
                          class="media-mentions-marquee__img"
                          src="{{ mm_logo_img_dup | image_url }}"
                          alt=""
                          width="{{ mm_logo_img_dup.width | default: 240 }}"
                          height="{{ mm_logo_img_dup.height | default: 80 }}"
                          loading="lazy"
                          decoding="async"
                          fetchpriority="low"
                          aria-hidden="true">
                      {%- else -%}
                        {{
                          mm_logo_img_dup
                          | image_url: width: 320, format: 'webp'
                          | image_tag:
                            loading: 'lazy',
                            decoding: 'async',
                            fetchpriority: 'low',
                            class: 'media-mentions-marquee__img',
                            widths: '120, 180, 240, 320',
                            sizes: '(min-width: 990px) 200px, min(40vw, 240px)',
                            alt: ''
                        }}
                      {%- endif -%}
                      {%- if block.settings.link != blank -%}
                        </a>
                      {%- endif -%}
                    {%- else -%}
                      <div class="media-mentions-marquee__placeholder">
                        <span class="media-mentions-marquee__placeholder-label">
                          {{- block.settings.alt | default: 'Logo' | escape -}}
                        </span>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- else -%}
            {%- for mm_rep in (1..mm_strip_cycles) -%}
              {%- for i in (1..7) -%}
                <div class="media-mentions-marquee__item">
                  <div class="media-mentions-marquee__placeholder">
                    <span class="media-mentions-marquee__placeholder-label">{{ 'Logo' | escape }}</span>
                  </div>
                </div>
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Media mentions (marquee)",
  "tag": "section",
  "class": "section-media-mentions-marquee",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Media Mentions"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 28
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Space below title",
      "default": 32
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "min": 28,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo display height",
      "default": 56,
      "info": "Fixed row height; logos scale to fit (small files grow to match)."
    },
    {
      "type": "range",
      "id": "logo_min_width",
      "min": 72,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Min width per item",
      "default": 140,
      "info": "Horizontal slot per logo; also caps max logo width (×2.8)."
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Gap between logos",
      "default": 48
    },
    {
      "type": "range",
      "id": "marquee_seconds",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "s",
      "label": "Full pass duration",
      "default": 35,
      "info": "Higher = slower motion. Animation uses the real strip width (seamless loop)."
    },
    {
      "type": "range",
      "id": "strip_cycles",
      "min": 1,
      "max": 8,
      "step": 1,
      "label": "Logo list repeats per strip",
      "default": 3,
      "info": "Increase if you still see empty space — each duplicated strip gets longer."
    },
    {
      "type": "checkbox",
      "id": "edge_fade",
      "label": "Fade carousel edges",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Image (SVG or PNG recommended)"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text / placeholder label",
          "default": "Logo",
          "info": "Used on the image and placeholder box when no file is set."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)",
          "info": "Opens in a new tab."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media mentions (marquee)",
      "category": "Trust & social proof",
      "blocks": [
        { "type": "logo", "settings": { "alt": "Vogue" } },
        { "type": "logo", "settings": { "alt": "GQ" } },
        { "type": "logo", "settings": { "alt": "Men’s Health" } },
        { "type": "logo", "settings": { "alt": "Wired" } },
        { "type": "logo", "settings": { "alt": "Forbes" } },
        { "type": "logo", "settings": { "alt": "Logo" } },
        { "type": "logo", "settings": { "alt": "Logo" } }
      ]
    }
  ]
}
{% endschema %}
