  #XCustomSetup-{{ section.id }} .xcustom-setup__button-message {
    min-height: 18px;
    margin-top: 8px;
    color: {{ section.settings.card_text_color }};
    font-size: 12px;
    line-height: 1.4;
    text-align: center;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__button-message.is-error {
    color: #b42318;
  }

  @keyframes xcustom-setup-spin {
    to {
      transform: rotate(360deg);
    }
  }

  #XCustomSetupLightbox-{{ section.id }}[hidden] {
    display: none;
  }

  #XCustomSetupLightbox-{{ section.id }} {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 32px;
  }

  #XCustomSetupLightbox-{{ section.id }} .xcustom-setup__lightbox-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: rgba(0, 0, 0, 0.82);
    cursor: zoom-out;
  }

  #XCustomSetupLightbox-{{ section.id }} .xcustom-setup__lightbox-dialog {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(1200px, calc(100vw - 64px));
    height: min(850px, calc(100vh - 64px));
  }

  #XCustomSetupLightbox-{{ section.id }} .xcustom-setup__lightbox-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border-radius: 12px;
    object-fit: contain;
  }

  #XCustomSetupLightbox-{{ section.id }} .xcustom-setup__lightbox-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #111111;
    background-color: #ffffff;
    cursor: pointer;
  }

  @media screen and (max-width: 989px) {
    #XCustomSetup-{{ section.id }} .xcustom-setup__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #XCustomSetup-{{ section.id }} .xcustom-setup__container {
      padding:
        {{ section.settings.padding_top_mobile }}px
        {{ section.settings.side_padding_mobile }}px
        {{ section.settings.padding_bottom_mobile }}px;
    }

    #XCustomSetup-{{ section.id }} .xcustom-setup__heading {
      font-size: {{ section.settings.heading_size_mobile }}px !important;
      line-height: {{ section.settings.heading_line_height_mobile | divided_by: 100.0 }} !important;
    }

    #XCustomSetup-{{ section.id }} .xcustom-setup__description,
    #XCustomSetup-{{ section.id }} .xcustom-setup__description p {
      font-size: {{ section.settings.description_size_mobile }}px;
    }

    #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-link {
      font-size: {{ section.settings.prompt_size_mobile }}px;
    }

    #XCustomSetup-{{ section.id }} .xcustom-setup__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: {{ section.settings.card_gap_mobile }}px;
      margin-top: {{ section.settings.cards_top_gap_mobile }}px;
    }

    #XCustomSetup-{{ section.id }} .xcustom-setup__number {
      top: {{ section.settings.number_offset_mobile }}px;
      right: {{ section.settings.number_offset_mobile }}px;
      font-size: {{ section.settings.number_size_mobile }}px;
    }

    #XCustomSetup-{{ section.id }} .xcustom-setup__card-body {
      padding:
        {{ section.settings.card_padding_top_mobile }}px
        {{ section.settings.card_padding_horizontal_mobile }}px
        {{ section.settings.card_padding_bottom_mobile }}px;
    }

    #XCustomSetup-{{ section.id }} .xcustom-setup__card-title {
      font-size: {{ section.settings.card_title_size_mobile }}px !important;
    }

    #XCustomSetup-{{ section.id }} .xcustom-setup__items,
    #XCustomSetup-{{ section.id }} .xcustom-setup__items p,
    #XCustomSetup-{{ section.id }} .xcustom-setup__items li {
      font-size: {{ section.settings.card_text_size_mobile }}px;
    }

    #XCustomSetup-{{ section.id }} .xcustom-setup__price {
      font-size: {{ section.settings.price_size_mobile }}px;
    }

    #XCustomSetup-{{ section.id }} .xcustom-setup__saving {
      font-size: {{ section.settings.saving_size_mobile }}px;
    }

    #XCustomSetup-{{ section.id }} .xcustom-setup__button {
      min-height: {{ section.settings.button_height_mobile }}px;
      font-size: {{ section.settings.button_size_mobile }}px;
    }

    #XCustomSetup-{{ section.id }} .xcustom-setup__zoom-icon {
      right: 12px;
      bottom: 12px;
      width: 38px;
      height: 38px;
      opacity: 1;
      transform: none;
    }

    #XCustomSetupLightbox-{{ section.id }} {
      padding: 16px;
    }

    #XCustomSetupLightbox-{{ section.id }} .xcustom-setup__lightbox-dialog {
      width: calc(100vw - 32px);
      height: calc(100vh - 32px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #XCustomSetup-{{ section.id }} .xcustom-setup__image,
    #XCustomSetup-{{ section.id }} .xcustom-setup__zoom-icon,
    #XCustomSetup-{{ section.id }} .xcustom-setup__button,
    #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-link::after,
    #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-arrow {
      transition: none;
    }
  }

    #XCustomSetup-{{ section.id }} .xcustom-setup__button,
  #XCustomSetup-{{ section.id }} .xcustom-setup__card--featured .xcustom-setup__button,
  #XCustomSetup-{{ section.id }} .xcustom-setup__button:disabled,
  #XCustomSetup-{{ section.id }} .xcustom-setup__button--disabled {
    color: {{ section.settings.button_text_color }};
    background-color: {{ section.settings.button_background }};
    border-color: {{ section.settings.button_background }};
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__button:hover:not(:disabled),
  #XCustomSetup-{{ section.id }} .xcustom-setup__card--featured .xcustom-setup__button:hover:not(:disabled) {
    color: {{ section.settings.button_hover_text_color }};
    background-color: {{ section.settings.button_hover_background }};
    border-color: {{ section.settings.button_hover_background }};
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__button:disabled,
  #XCustomSetup-{{ section.id }} .xcustom-setup__button--disabled {
    opacity: 1;
    cursor: not-allowed;
  }
{% endstyle %}

<script>
  (() => {
    const sectionId = {{ section.id | json }};
    const rootId = `XCustomSetup-${sectionId}`;
    const lightboxId = `XCustomSetupLightbox-${sectionId}`;
    const afterAddAction = {{ section.settings.after_add_action | json }};
    const promptScrollOffset = {{ section.settings.prompt_scroll_offset | default: 204 | json }};

    let previousFocus = null;
    let previousBodyOverflow = '';
    let setupAddInProgress = false;

    function getPromptTargetId(value) {
      return String(value || '').trim().replace(/^#/, '');
    }

    function scrollToPromptTarget(trigger) {
      const targetId = getPromptTargetId(trigger?.dataset?.xcustomPromptScrollTarget);

      if (!targetId) {
        return false;
      }

      const target = document.getElementById(targetId);

      if (!target) {
        return false;
      }

      const offset = Number(promptScrollOffset) || 0;
      const targetTop = target.getBoundingClientRect().top + window.pageYOffset - offset;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      target.style.scrollMarginTop = `${offset}px`;

      window.scrollTo({
        top: Math.max(0, targetTop),
        behavior: prefersReducedMotion ? 'auto' : 'smooth'
      });

      if (window.history && window.history.pushState) {
        window.history.pushState(null, '', `#${targetId}`);
      } else {
        window.location.hash = targetId;
      }

      return true;
    }

    function handlePromptScrollClick(event) {
      const root = document.getElementById(rootId);
      const trigger = event.target.closest('[data-xcustom-prompt-scroll-target]');

      if (!root || !trigger || !root.contains(trigger)) {
        return;
      }

      const handled = scrollToPromptTarget(trigger);

      if (handled) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
      }
    }

    function getRootPath() {
      return window.Shopify?.routes?.root || '/';
    }

    function sleep(milliseconds) {
      return new Promise((resolve) => {
        window.setTimeout(resolve, milliseconds);
      });
    }

    function getDrawerSectionId() {
      const drawerItems = document.getElementById('CartDrawer-Items');

      if (drawerItems?.dataset?.id) {
        return drawerItems.dataset.id;
      }

      return 'cart-drawer';
    }

    function getThemeCartDrawer() {
      if (window.cartDrawer) {
        return window.cartDrawer;
      }

      return document.querySelector('cart-drawer');
    }

    async function waitForThemeCartDrawer(timeout = 2500) {
      const startTime = Date.now();

      while (Date.now() - startTime < timeout) {
        const drawer = getThemeCartDrawer();

        if (drawer && typeof drawer.open === 'function') {
          return drawer;
        }

        await sleep(50);
      }

      return getThemeCartDrawer();
    }

    async function fetchCurrentCart() {
      if (window.AfitCartApi?.invalidate) {
        window.AfitCartApi.invalidate();
      }

      if (window.AfitCartApi?.fetchCart) {
        return window.AfitCartApi.fetchCart({ force: true });
      }

      const response = await fetch(`${getRootPath()}cart.js`, {
        method: 'GET',
        headers: {
          Accept: 'application/json'
        },
        credentials: 'same-origin',
        cache: 'no-store'
      });

      if (!response.ok) {
        throw new Error('Unable to refresh the cart.');
      }

      return response.json();
    }

    function updateVisibleCartCount(itemCount) {
      const count = Number(itemCount) || 0;
      const countElements = document.querySelectorAll(
        '.cart-count, [data-cart-count], .header__cart-count, .cart-count-bubble span[aria-hidden="true"], .cart-count-bubble span:not(.visually-hidden)'
      );

      countElements.forEach((element) => {
        element.textContent = count;
        element.hidden = false;
        element.removeAttribute('hidden');
        element.classList.toggle('hidden', count === 0);
      });

      const drawer = document.querySelector('cart-drawer');

      if (drawer) {
        drawer.classList.toggle('is-empty', count === 0);
      }
    }

    function refreshDrawerFromHtml(html) {
      if (!html) {
        return false;
      }

      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      let didUpdate = false;

      const currentItems = document.getElementById('CartDrawer-Items');
      const newItems = doc.querySelector('#CartDrawer-Items');

      if (currentItems && newItems) {
        currentItems.innerHTML = newItems.innerHTML;
        didUpdate = true;
      }

      const currentRecommendations = document.getElementById('CartDrawer-Recommendations');
      const newRecommendations = doc.querySelector('#CartDrawer-Recommendations');

      if (currentRecommendations && newRecommendations) {
        currentRecommendations.innerHTML = newRecommendations.innerHTML;
        didUpdate = true;
      } else if (currentRecommendations && !newRecommendations) {
        currentRecommendations.remove();
        didUpdate = true;
      }

      const currentFooter = document.querySelector('.cart-drawer__footer');
      const newFooter = doc.querySelector('.cart-drawer__footer');

      if (currentFooter && newFooter) {
        currentFooter.innerHTML = newFooter.innerHTML;
        didUpdate = true;
      }

      return didUpdate;
    }

    async function fetchDrawerSectionHtml() {
      const sectionId = getDrawerSectionId();
      const response = await fetch(
        `${getRootPath()}cart?sections=${encodeURIComponent(sectionId)}`,
        {
          method: 'GET',
          headers: {
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          credentials: 'same-origin',
          cache: 'no-store'
        }
      );

      if (!response.ok) {
        return false;
      }

      const sections = await response.json();
      return refreshDrawerFromHtml(sections?.[sectionId]);
    }

    function showProductAddedNotice() {
      if (!window.CartNotification || typeof window.CartNotification.success !== 'function') {
        return;
      }

      window.CartNotification.success({
        title: 'Product Added!',
        message: 'Join <a href="https://www.ativafit.com/pages/ativapeople-rewards-program" target="_blank" style="color: #eb701f; text-decoration: underline; font-weight: bold;">AtivaPeople</a> & get extra discount.',
        type: 'success'
      });
    }

    function openThemeCart(drawer) {
      const cartDrawer = drawer || getThemeCartDrawer();

      if (cartDrawer && typeof cartDrawer.open === 'function') {
        cartDrawer.classList.remove('is-empty');
        cartDrawer.open();
        return true;
      }

      if (
        window.theme?.miniCart &&
        typeof window.theme.miniCart.open === 'function'
      ) {
        window.theme.miniCart.open();
        return true;
      }

      return false;
    }

    async function syncThemeCart(addData, shouldOpenDrawer) {
      const sectionId = getDrawerSectionId();
      let renderedFromAddResponse = false;

      if (addData?.sections?.[sectionId]) {
        renderedFromAddResponse = refreshDrawerFromHtml(addData.sections[sectionId]);
      }

      /*
       * 加购成功后先弹提示和打开购物车。
       * 后续 drawer 刷新、cart.js、第三方购物车组件即使慢或失败，也不应该把成功加购显示成失败。
       */
      showProductAddedNotice();

      const drawer = await waitForThemeCartDrawer();

      if (shouldOpenDrawer) {
        const opened = openThemeCart(drawer);

        if (!opened) {
          window.location.href = `${getRootPath()}cart`;
          return null;
        }
      }

      let cart = null;

      try {
        cart = await fetchCurrentCart();
        updateVisibleCartCount(cart.item_count);
      } catch (error) {
        console.warn('[XCustom Setup] Cart count refresh failed:', error);
      }

      if (!renderedFromAddResponse) {
        fetchDrawerSectionHtml().catch((error) => {
          console.warn('[XCustom Setup] Drawer section refresh failed:', error);
        });
      }

      /*
       * 多产品批量加入购物车时，主题抽屉和第三方购物车组件有时会慢一拍。
       * 保留延迟刷新，确保抽屉里不是旧内容。
       */
      window.setTimeout(() => {
        fetchDrawerSectionHtml().catch((error) => {
          console.warn('[XCustom Setup] First delayed drawer refresh failed:', error);
        });

        fetchCurrentCart()
          .then((freshCart) => {
            updateVisibleCartCount(freshCart.item_count);
          })
          .catch(() => {});
      }, 350);

      window.setTimeout(() => {
        fetchDrawerSectionHtml().catch((error) => {
          console.warn('[XCustom Setup] Second delayed drawer refresh failed:', error);
        });

        fetchCurrentCart()
          .then((freshCart) => {
            updateVisibleCartCount(freshCart.item_count);
          })
          .catch(() => {});
      }, 900);

      if (cart) {
        document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { cart } }));
        document.dispatchEvent(new CustomEvent('cart:change', { bubbles: true, detail: { cart } }));
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { cart } }));
      }

      return cart;
    }

    function setButtonLoading(button) {
      const textElement = button.querySelector('[data-setup-button-text]');
      const spinner = button.querySelector('[data-setup-spinner]');

      button.classList.add('is-loading');
      button.setAttribute('aria-busy', 'true');
      button.disabled = true;

      if (textElement) {
        textElement.textContent =
          button.dataset.loadingLabel || 'ADDING SETUP...';
      }

      if (spinner) {
        spinner.hidden = false;
      }
    }

    function showButtonSuccess(button) {
      const textElement = button.querySelector('[data-setup-button-text]');
      const spinner = button.querySelector('[data-setup-spinner]');

      button.classList.remove('is-loading');
      button.removeAttribute('aria-busy');
      button.disabled = true;

      if (textElement) {
        textElement.textContent =
          button.dataset.successLabel || 'ADDED TO CART';
      }

      if (spinner) {
        spinner.hidden = true;
      }
    }

    function restoreButton(button) {
      const textElement = button.querySelector('[data-setup-button-text]');
      const spinner = button.querySelector('[data-setup-spinner]');

      button.classList.remove('is-loading');
      button.removeAttribute('aria-busy');
      button.disabled = false;

      if (textElement) {
        textElement.textContent =
          button.dataset.defaultLabel ||
          'ADD COMPLETE SETUP';
      }

      if (spinner) {
        spinner.hidden = true;
      }
    }

    function getSuccessMessage(button, itemCount) {
      const template =
        button.dataset.successMessage ||
        '[count] [item_word] added to cart.';

      return template
        .replace('[count]', String(itemCount))
        .replace(
          '[item_word]',
          itemCount === 1 ? 'item' : 'items'
        );
    }

    function getSetupDiscountData(button) {
      const discountCents = Number(button.dataset.setupDiscountCents) || 0;
      const discountLabel = button.dataset.setupDiscountLabel || '';
      const discountCode = (button.dataset.setupDiscountCode || '').trim();
      const card = button.closest('.xcustom-setup__card');
      const setupTitle = card?.querySelector('.xcustom-setup__card-title')?.textContent?.trim() || '';

      return {
        discountCents,
        discountLabel,
        discountCode,
        setupTitle
      };
    }

    async function applySetupDiscountCode(button) {
      const { discountCents, discountCode } = getSetupDiscountData(button);

      if (!discountCode) {
        if (discountCents > 0) {
          console.warn(
            '[XCustom Setup] A setup discount amount is configured, but no Shopify discount code is set on this setup card. The discount amount will be stored as a line-item property only.'
          );
        }

        return false;
      }

      try {
        const response = await fetch(
          `${getRootPath()}discount/${encodeURIComponent(discountCode)}`,
          {
            method: 'GET',
            credentials: 'same-origin',
            cache: 'no-store'
          }
        );

        if (!response.ok) {
          console.warn('[XCustom Setup] Discount code could not be applied:', discountCode);
          return false;
        }

        return true;
      } catch (error) {
        console.warn('[XCustom Setup] Discount code request failed:', error);
        return false;
      }
    }

    function buildSetupLineProperties(button) {
      const { discountCents, discountLabel, discountCode, setupTitle } = getSetupDiscountData(button);
      const properties = {
        '_Setup Section': String(sectionId)
      };

      if (setupTitle) {
        properties['_Setup Card'] = setupTitle;
      }

      if (discountCents > 0) {
        properties['_Setup Discount'] = discountLabel || String(discountCents / 100);
      }

      if (discountCode) {
        properties['_Setup Discount Code'] = discountCode;
      }

      return properties;
    }

    function setOtherSetupButtonsDisabled(activeButton, disabled) {
      const root = document.getElementById(rootId);

      if (!root) {
        return;
      }

      root.querySelectorAll('[data-setup-add]').forEach((button) => {
        if (button === activeButton) {
          return;
        }

        if (disabled) {
          button.dataset.xcustomPreviousDisabled = button.disabled ? 'true' : 'false';
          button.disabled = true;
          button.setAttribute('aria-disabled', 'true');
          button.classList.add('is-temporarily-disabled');
          return;
        }

        if (button.dataset.xcustomPreviousDisabled !== 'true') {
          button.disabled = false;
          button.removeAttribute('aria-disabled');
        }

        delete button.dataset.xcustomPreviousDisabled;
        button.classList.remove('is-temporarily-disabled');
      });
    }

    async function addSetupToCart(button) {
      if (
        button.disabled ||
        button.classList.contains('is-loading')
      ) {
        return;
      }

      const footer = button.closest('.xcustom-setup__card-footer');
      const message = footer?.querySelector('[data-setup-message]');

      if (setupAddInProgress) {
        if (message) {
          message.textContent = 'Please wait for the current setup to finish adding.';
          message.classList.remove('is-error');
        }
        return;
      }

      const variantIds = (button.dataset.variantIds || '')
        .split(',')
        .map((value) => Number(value.trim()))
        .filter((value) => {
          return Number.isInteger(value) && value > 0;
        });

      if (!variantIds.length) {
        return;
      }

      if (message) {
        message.textContent = '';
        message.classList.remove('is-error');
      }

      setupAddInProgress = true;
      setOtherSetupButtonsDisabled(button, true);
      setButtonLoading(button);

      const setupLineProperties = buildSetupLineProperties(button);

      try {
        const drawerSectionId = getDrawerSectionId();
        const response = await fetch(`${getRootPath()}cart/add.js`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          credentials: 'same-origin',
          cache: 'no-store',
          body: JSON.stringify({
            items: variantIds.map((variantId) => ({
              id: variantId,
              quantity: 1,
              properties: { ...setupLineProperties }
            })),
            sections: drawerSectionId,
            sections_url: window.location.pathname
          })
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(
            result.description ||
            result.message ||
            button.dataset.errorLabel ||
            'Unable to add this setup.'
          );
        }

        await applySetupDiscountCode(button);

        showButtonSuccess(button);

        if (message) {
          message.textContent = getSuccessMessage(
            button,
            variantIds.length
          );
        }

        if (afterAddAction === 'cart') {
          setupAddInProgress = false;
          setOtherSetupButtonsDisabled(button, false);
          window.location.href = `${getRootPath()}cart`;
          return;
        }

        /*
         * 这里不再依赖 after_add_action = drawer 才打开购物车。
         * 该模块是批量加购场景，用户当前需要与 Shop Look 一样弹提示并打开购物车。
         */
        try {
          await syncThemeCart(result, true);
        } catch (syncError) {
          console.warn('[XCustom Setup] Cart drawer sync failed after successful add:', syncError);
          showProductAddedNotice();
          openThemeCart(await waitForThemeCartDrawer());
        }

        setupAddInProgress = false;
        setOtherSetupButtonsDisabled(button, false);

        window.setTimeout(() => {
          restoreButton(button);

          if (message) {
            message.textContent = '';
          }
        }, 2200);
      } catch (error) {
        setupAddInProgress = false;
        setOtherSetupButtonsDisabled(button, false);
        restoreButton(button);

        const errorMessage =
          error.message ||
          button.dataset.errorLabel ||
          'Unable to add this setup.';

        if (message) {
          message.textContent = errorMessage;
          message.classList.add('is-error');
        }

        console.error(
          '[XCustom Setup] Add to cart failed:',
          error
        );
      }
    }

    function openLightbox(trigger) {
      const lightbox = document.getElementById(lightboxId);
      const image = lightbox?.querySelector('[data-setup-lightbox-image]');

      if (!lightbox || !image) {
        return;
      }

      previousFocus = trigger;
      previousBodyOverflow = document.body.style.overflow;

      image.src = trigger.dataset.zoomSrc || '';
      image.alt = trigger.dataset.zoomAlt || '';

      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';

      lightbox
        .querySelector('.xcustom-setup__lightbox-close')
        ?.focus();
    }

    function closeLightbox() {
      const lightbox = document.getElementById(lightboxId);
      const image = lightbox?.querySelector('[data-setup-lightbox-image]');

      if (!lightbox || lightbox.hidden) {
        return;
      }

      lightbox.hidden = true;
      document.body.style.overflow = previousBodyOverflow;

      if (image) {
        image.src = '';
        image.alt = '';
      }

      previousFocus?.focus();
      previousFocus = null;
    }

    function trapLightboxFocus(event) {
      const lightbox = document.getElementById(lightboxId);

      if (
        !lightbox ||
        lightbox.hidden ||
        event.key !== 'Tab'
      ) {
        return;
      }

      const focusableElements = Array.from(
        lightbox.querySelectorAll(
          'button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])'
        )
      );

      if (!focusableElements.length) {
        return;
      }

      const firstElement = focusableElements[0];
      const lastElement =
        focusableElements[focusableElements.length - 1];

      if (
        event.shiftKey &&
        document.activeElement === firstElement
      ) {
        event.preventDefault();
        lastElement.focus();
      } else if (
        !event.shiftKey &&
        document.activeElement === lastElement
      ) {
        event.preventDefault();
        firstElement.focus();
      }
    }

    function initXCustomSetup() {
      const root = document.getElementById(rootId);
      const lightbox = document.getElementById(lightboxId);

      if (
        !root ||
        root.dataset.xcustomSetupInitialized === 'true'
      ) {
        return;
      }

      root.dataset.xcustomSetupInitialized = 'true';

      document.addEventListener('click', handlePromptScrollClick, true);

      root.addEventListener('click', (event) => {
        const addButton = event.target.closest('[data-setup-add]');

        if (addButton) {
          event.preventDefault();
          addSetupToCart(addButton);
          return;
        }

        const zoomButton = event.target.closest('[data-setup-zoom]');

        if (zoomButton) {
          openLightbox(zoomButton);
        }
      });

      lightbox?.addEventListener('click', (event) => {
        if (event.target.closest('[data-setup-lightbox-close]')) {
          closeLightbox();
        }
      });

      lightbox?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeLightbox();
          return;
        }

        trapLightboxFocus(event);
      });
    }

    initXCustomSetup();

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener(
        'shopify:section:load',
        (event) => {
          if (
            event.detail.sectionId === String(sectionId)
          ) {
            initXCustomSetup();
          }
        }
      );
    }
  })();
</script>

