{% liquid
  assign width_class = 'xcustom-setup--contained'

  if section.settings.full_width
    assign width_class = 'xcustom-setup--full'
  endif

  assign prompt_target = section.settings.prompt_link | strip | remove: '#'
%}

<section
  id="XCustomSetup-{{ section.id }}"
  class="xcustom-setup {{ width_class }}"
>
  <div class="xcustom-setup__inner">
    <div class="xcustom-setup__container">
      {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank or section.settings.prompt_text != blank %}
        <div class="xcustom-setup__header">
          {% if section.settings.eyebrow != blank %}
            <div class="xcustom-setup__eyebrow">
              {{ section.settings.eyebrow | escape }}
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <{{ section.settings.heading_tag }} class="xcustom-setup__heading">
              {{ section.settings.heading }}
            </{{ section.settings.heading_tag }}>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="xcustom-setup__description rte">
              {{ section.settings.description }}
            </div>
          {% endif %}

          {% if section.settings.prompt_text != blank %}
            <div class="xcustom-setup__prompt">
              {% if prompt_target != blank %}
                <a
                  class="xcustom-setup__prompt-link"
                  href="#{{ prompt_target | escape }}"
                  data-xcustom-prompt-scroll-target="{{ prompt_target | escape }}"
                >
                  <span class="xcustom-setup__prompt-text">{{ section.settings.prompt_text | escape }}</span>
                  <span class="xcustom-setup__prompt-arrow" aria-hidden="true">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 14 14"
                      fill="none"
                      focusable="false"
                    >
                      <path
                        d="M7 2.25v8.5M3.75 7.5 7 10.75 10.25 7.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      ></path>
                    </svg>
                  </span>
                </a>
              {% else %}
                <span class="xcustom-setup__prompt-link xcustom-setup__prompt-link--disabled" aria-disabled="true">
                  <span class="xcustom-setup__prompt-text">{{ section.settings.prompt_text | escape }}</span>
                  <span class="xcustom-setup__prompt-arrow" aria-hidden="true">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 14 14"
                      fill="none"
                      focusable="false"
                    >
                      <path
                        d="M7 2.25v8.5M3.75 7.5 7 10.75 10.25 7.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      ></path>
                    </svg>
                  </span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="xcustom-setup__grid">
          {% for block in section.blocks %}
            {% liquid
              assign card_alt = block.settings.image.alt

              if card_alt == blank
                assign card_alt = block.settings.title
              endif

              assign card_number = block.settings.number

              if card_number == blank
                if forloop.index < 10
                  assign card_number = forloop.index | prepend: '0'
                else
                  assign card_number = forloop.index
                endif
              endif

              assign setup_variant_ids = ''
              assign setup_product_count = 0
              assign setup_available_count = 0
              assign setup_discount_amount = block.settings.discount_amount | default: 0
              assign setup_discount_cents = setup_discount_amount | times: 100 | round
              assign setup_discount_display = setup_discount_cents | money
              assign setup_discount_code = block.settings.discount_code | strip

              for setup_product in block.settings.products
                assign setup_product_count = setup_product_count | plus: 1
                assign setup_variant = setup_product.selected_or_first_available_variant

                if setup_variant != blank and setup_variant.available
                  if setup_variant_ids != blank
                    assign setup_variant_ids = setup_variant_ids | append: ','
                  endif

                  assign setup_variant_ids = setup_variant_ids | append: setup_variant.id
                  assign setup_available_count = setup_available_count | plus: 1
                endif
              endfor

              assign setup_can_add = false

              if setup_product_count > 0 and setup_available_count == setup_product_count
                assign setup_can_add = true
              endif
            %}

            <article
              class="xcustom-setup__card{% if block.settings.featured %} xcustom-setup__card--featured{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="xcustom-setup__media">
                {% if block.settings.image != blank %}
                  <button
                    type="button"
                    class="xcustom-setup__image-button"
                    data-setup-zoom
                    data-zoom-src="{{ block.settings.image | image_url: width: 2400 }}"
                    data-zoom-alt="{{ card_alt | escape }}"
                    aria-label="Enlarge image for {{ card_alt | escape }}"
                  >
                    <img
                      class="xcustom-setup__image"
                      src="{{ block.settings.image | image_url: width: 1200 }}"
                      srcset="
                        {{ block.settings.image | image_url: width: 400 }} 400w,
                        {{ block.settings.image | image_url: width: 600 }} 600w,
                        {{ block.settings.image | image_url: width: 800 }} 800w,
                        {{ block.settings.image | image_url: width: 1000 }} 1000w,
                        {{ block.settings.image | image_url: width: 1200 }} 1200w
                      "
                      sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      loading="lazy"
                      alt="{{ card_alt | escape }}"
                      style="object-position: {{ block.settings.image.presentation.focal_point }};"
                    >

                    <span class="xcustom-setup__zoom-icon" aria-hidden="true">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                      >
                        <circle
                          cx="11"
                          cy="11"
                          r="7"
                          stroke="currentColor"
                          stroke-width="2"
                        ></circle>

                        <path
                          d="m16 16 5 5"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                        ></path>

                        <path
                          d="M11 8v6M8 11h6"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                        ></path>
                      </svg>
                    </span>
                  </button>
                {% else %}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'xcustom-setup__placeholder' }}
                {% endif %}

                {% if section.settings.show_numbers %}
                  <span class="xcustom-setup__number" aria-hidden="true">
                    {{ card_number | escape }}
                  </span>
                {% endif %}
              </div>

              <div class="xcustom-setup__card-body">
                <div class="xcustom-setup__card-content">
                  {% if block.settings.badge != blank %}
                    <div class="xcustom-setup__badge">
                      {{ block.settings.badge | escape }}
                    </div>
                  {% endif %}

                  {% if block.settings.title != blank %}
                    <h3 class="xcustom-setup__card-title">
                      {{ block.settings.title | escape }}
                    </h3>
                  {% endif %}

                  {% if block.settings.items != blank %}
                    <div class="xcustom-setup__items rte">
                      {{ block.settings.items }}
                    </div>
                  {% endif %}
                </div>

                <div class="xcustom-setup__card-footer">
                  <div class="xcustom-setup__pricing">
                    <div class="xcustom-setup__price-group">
                      {% if block.settings.compare_price != blank %}
                        <div class="xcustom-setup__compare-price">
                          {{ block.settings.compare_price | escape }}
                        </div>
                      {% endif %}

                      {% if block.settings.price != blank %}
                        <div class="xcustom-setup__price">
                          {{ block.settings.price | escape }}
                        </div>
                      {% endif %}
                    </div>

                    {% if block.settings.saving != blank %}
                      <div class="xcustom-setup__saving">
                        {{ block.settings.saving | escape }}
                      </div>
                    {% elsif setup_discount_cents > 0 %}
                      <div class="xcustom-setup__saving">
                        Save {{ setup_discount_display }}
                      </div>
                    {% endif %}
                  </div>

                  {% if block.settings.button_label != blank %}
                    <button
                      type="button"
                      class="xcustom-setup__button{% unless setup_can_add %} xcustom-setup__button--disabled{% endunless %}"
                      data-setup-add
                      data-variant-ids="{{ setup_variant_ids }}"
                      data-default-label="{{ block.settings.button_label | escape }}"
                      data-loading-label="{{ section.settings.adding_label | escape }}"
                      data-success-label="{{ section.settings.added_label | escape }}"
                      data-error-label="{{ section.settings.error_label | escape }}"
                      data-success-message="{{ section.settings.success_message | escape }}"
                      data-setup-discount-cents="{{ setup_discount_cents }}"
                      data-setup-discount-label="{{ setup_discount_display | escape }}"
                      data-setup-discount-code="{{ setup_discount_code | escape }}"
                      {% unless setup_can_add %}
                        disabled
                        aria-disabled="true"
                      {% endunless %}
                    >
                      <span data-setup-button-text>
                        {% if setup_product_count == 0 %}
                          {{ section.settings.select_products_label | escape }}
                        {% elsif setup_can_add %}
                          {{ block.settings.button_label | escape }}
                        {% else %}
                          {{ section.settings.unavailable_label | escape }}
                        {% endif %}
                      </span>

                      <span
                        class="xcustom-setup__button-spinner"
                        data-setup-spinner
                        hidden
                        aria-hidden="true"
                      ></span>
                    </button>

                    <div
                      class="xcustom-setup__button-message"
                      data-setup-message
                      role="status"
                      aria-live="polite"
                    ></div>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<div
  id="XCustomSetupLightbox-{{ section.id }}"
  class="xcustom-setup__lightbox"
  data-setup-lightbox
  hidden
>
  <button
    type="button"
    class="xcustom-setup__lightbox-backdrop"
    data-setup-lightbox-close
    aria-label="Close enlarged image"
  ></button>

  <div
    class="xcustom-setup__lightbox-dialog"
    role="dialog"
    aria-modal="true"
    aria-label="Enlarged setup image"
  >
    <button
      type="button"
      class="xcustom-setup__lightbox-close"
      data-setup-lightbox-close
      aria-label="Close enlarged image"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M5 5l14 14M19 5 5 19"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>

    <img
      class="xcustom-setup__lightbox-image"
      data-setup-lightbox-image
      src=""
      alt=""
    >
  </div>
</div>

{% style %}

  #shopify-section-{{ section.id }} {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  #XCustomSetup-{{ section.id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
  }

  #XCustomSetup-{{ section.id }},
  #XCustomSetup-{{ section.id }} *,
  #XCustomSetup-{{ section.id }} *::before,
  #XCustomSetup-{{ section.id }} *::after,
  #XCustomSetupLightbox-{{ section.id }},
  #XCustomSetupLightbox-{{ section.id }} *,
  #XCustomSetupLightbox-{{ section.id }} *::before,
  #XCustomSetupLightbox-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__inner {
    width: 100%;
    margin: 0 auto;
    background-color: {{ section.settings.background_color }};
  }

  #XCustomSetup-{{ section.id }}.xcustom-setup--full .xcustom-setup__inner {
    max-width: none;
  }

  #XCustomSetup-{{ section.id }}.xcustom-setup--contained .xcustom-setup__inner {
    max-width: {{ section.settings.content_max_width }}px;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__container {
    width: 100%;
    max-width: {{ section.settings.content_max_width }}px;
    margin-right: auto;
    margin-left: auto;
    padding:
      {{ section.settings.padding_top }}px
      {{ section.settings.side_padding }}px
      {{ section.settings.padding_bottom }}px;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__header {
    width: 100%;
    max-width: {{ section.settings.header_max_width }}px;
    margin-right: auto;
    margin-left: auto;
    text-align: {{ section.settings.header_alignment }};
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_gap }}px;
    color: {{ section.settings.accent_color }};
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing | divided_by: 100.0 }}em;
    text-transform: uppercase;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__heading {
    width: 100%;
    margin: 0;
    padding: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px !important;
    font-weight: 700;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }} !important;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
  }


  #XCustomSetup-{{ section.id }} .xcustom-setup__description {
    width: 100%;
    margin-top: {{ section.settings.description_gap }}px;
    color: {{ section.settings.text_color }};
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__description,
  #XCustomSetup-{{ section.id }} .xcustom-setup__description p,
  #XCustomSetup-{{ section.id }} .xcustom-setup__description span,
  #XCustomSetup-{{ section.id }} .xcustom-setup__description a {
    color: inherit;
    font-size: {{ section.settings.description_size }}px;
    line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__description > *:first-child {
    margin-top: 0;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__description > *:last-child {
    margin-bottom: 0;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__prompt {
    width: 100%;
    margin-top: {{ section.settings.prompt_gap }}px;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: {{ section.settings.accent_color }};
    font-size: {{ section.settings.prompt_size }}px;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -5px;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.22s ease;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-link:hover::after,
  #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-link:focus-visible::after {
    transform: scaleX(1);
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-link:focus-visible {
    outline: 2px solid {{ section.settings.accent_color }};
    outline-offset: 7px;
    border-radius: 999px;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-link--disabled {
    opacity: 0.55;
    cursor: not-allowed;
    pointer-events: none;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    transform: translateY(1px);
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-arrow svg {
    display: block;
    width: 14px;
    height: 14px;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-link:hover .xcustom-setup__prompt-arrow,
  #XCustomSetup-{{ section.id }} .xcustom-setup__prompt-link:focus-visible .xcustom-setup__prompt-arrow {
    color: #ffffff;
    background-color: {{ section.settings.accent_color }};
    transform: translateY(1px);
  }


  #XCustomSetup-{{ section.id }} .xcustom-setup__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: {{ section.settings.card_gap }}px;
    width: 100%;
    margin-top: {{ section.settings.cards_top_gap }}px;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    background-color: {{ section.settings.card_background }};
  }

  {% if section.settings.enable_card_shadow %}
    #XCustomSetup-{{ section.id }} .xcustom-setup__card {
      box-shadow: 0 14px 35px rgba(0, 0, 0, 0.06);
    }
  {% endif %}

  #XCustomSetup-{{ section.id }} .xcustom-setup__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    background-color: #eeeeee;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__image-button {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    color: #111111;
    background: transparent;
    cursor: zoom-in;
    appearance: none;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__image-button:focus-visible {
    outline: 3px solid {{ section.settings.accent_color }};
    outline-offset: -3px;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__zoom-icon {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: #111111;
    background-color: rgba(255, 255, 255, 0.94);
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__image-button:hover .xcustom-setup__zoom-icon,
  #XCustomSetup-{{ section.id }} .xcustom-setup__image-button:focus-visible .xcustom-setup__zoom-icon {
    opacity: 1;
    transform: translateY(0);
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__image,
  #XCustomSetup-{{ section.id }} .xcustom-setup__placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__image {
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__card:hover .xcustom-setup__image {
    transform: scale(1.015);
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__number {
    position: absolute;
    top: {{ section.settings.number_offset }}px;
    right: {{ section.settings.number_offset }}px;
    z-index: 1;
    color: {{ section.settings.number_color }};
    font-size: {{ section.settings.number_size }}px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    pointer-events: none;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__card-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
    padding:
      {{ section.settings.card_padding_top }}px
      {{ section.settings.card_padding_horizontal }}px
      {{ section.settings.card_padding_bottom }}px;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__badge {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    min-height: 26px;
    padding: 5px 12px;
    border-radius: 999px;
    color: {{ section.settings.badge_text_color }};
    background-color: {{ section.settings.badge_background }};
    font-size: {{ section.settings.badge_size }}px;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
    margin-bottom:10px;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__card-title {
    width: 100%;
    margin: {{ section.settings.title_top_gap }}px 0 0;
    color: {{ section.settings.card_heading_color }};
    font-size: {{ section.settings.card_title_size }}px !important;
    font-weight: 700;
    line-height: 1.2 !important;
    letter-spacing: -0.025em;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__items {
    width: 100%;
    margin-top: {{ section.settings.items_top_gap }}px;
    color: {{ section.settings.card_text_color }};
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__items,
  #XCustomSetup-{{ section.id }} .xcustom-setup__items p,
  #XCustomSetup-{{ section.id }} .xcustom-setup__items li {
    color: inherit;
    font-size: {{ section.settings.card_text_size }}px;
    line-height: 1.45;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__items ul {
    margin: 0;
    padding-left: 1.25em;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__items > *:first-child {
    margin-top: 0;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__items > *:last-child {
    margin-bottom: 0;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__card-footer {
    width: 100%;
    margin-top: auto;
    padding-top: {{ section.settings.price_top_gap }}px;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__pricing {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__compare-price {
    color: {{ section.settings.compare_price_color }};
    font-size: {{ section.settings.compare_price_size }}px;
    line-height: 1.2;
    text-decoration: line-through;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__price {
    margin-top: 4px;
    color: {{ section.settings.price_color }};
    font-size: {{ section.settings.price_size }}px;
    font-weight: 700;
    line-height: 1.1;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__saving {
    flex: 0 0 auto;
    padding-bottom: 2px;
    color: {{ section.settings.accent_color }};
    font-size: {{ section.settings.saving_size }}px;
    font-weight: 700;
    line-height: 1.2;
    text-align: right;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: {{ section.settings.button_height }}px;
    margin-top: {{ section.settings.button_top_gap }}px;
    padding: 10px 18px;
    border: 1px solid {{ section.settings.button_background }};
    border-radius: {{ section.settings.button_radius }}px;
    color: {{ section.settings.button_text_color }};
    background-color: {{ section.settings.button_background }};
    font-size: {{ section.settings.button_size }}px;
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    cursor: pointer;
    appearance: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }



  #XCustomSetup-{{ section.id }} .xcustom-setup__button:hover:not(:disabled) {
    color: {{ section.settings.button_hover_text_color }};
    background-color: {{ section.settings.button_hover_background }};
    border-color: {{ section.settings.button_hover_background }};
  }



  #XCustomSetup-{{ section.id }} .xcustom-setup__button--disabled,
  #XCustomSetup-{{ section.id }} .xcustom-setup__button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__button-spinner {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: xcustom-setup-spin 0.7s linear infinite;
  }

  #XCustomSetup-{{ section.id }} .xcustom-setup__button-spinner[hidden] {
    display: none;
