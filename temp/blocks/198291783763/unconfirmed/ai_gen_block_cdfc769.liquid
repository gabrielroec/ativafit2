              <div class="ai-promo-code-description-{{ ai_gen_id }}">{{ block.settings.tier1_description }}</div>
            </div>
            <button class="ai-promo-copy-button-{{ ai_gen_id }}" data-code="{{ block.settings.tier1_code }}">
