                    <div class="ai-promo-product-badge-{{ ai_gen_id }}">{{ discount }}% OFF</div>
                  {% endif %}
                </div>
                <div class="ai-promo-product-info-{{ ai_gen_id }}">
                  <h4 class="ai-promo-product-title-{{ ai_gen_id }}">{{ product.title }}</h4>
                  <div class="ai-promo-product-price-{{ ai_gen_id }}">
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-promo-product-compare-price-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    {{ product.price | money }}
                  </div>
                </div>
              </a>
            {% endif %}

            {% if block.settings.product_7 != blank %}
              {% assign product = block.settings.product_7 %}
              <a href="{{ product.url }}" class="ai-promo-product-card-{{ ai_gen_id }}">
                <div class="ai-promo-product-image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 400 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-promo-product-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="400"
                      height="400"
                    >
                  {% endif %}
                  {% if product.compare_at_price > product.price %}
                    {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                    <div class="ai-promo-product-badge-{{ ai_gen_id }}">{{ discount }}% OFF</div>
                  {% endif %}
                </div>
                <div class="ai-promo-product-info-{{ ai_gen_id }}">
                  <h4 class="ai-promo-product-title-{{ ai_gen_id }}">{{ product.title }}</h4>
                  <div class="ai-promo-product-price-{{ ai_gen_id }}">
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-promo-product-compare-price-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    {{ product.price | money }}
                  </div>
                </div>
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</promo-section-{{ ai_gen_id }}>

<script>
  (function() {
    class PromoSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupCopyButtons();
      }

      setupCopyButtons() {
        const buttons = this.querySelectorAll('.ai-promo-copy-button-{{ ai_gen_id }}');
        
        buttons.forEach(button => {
          button.addEventListener('click', () => {
            const code = button.getAttribute('data-code');
            
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(code).then(() => {
                this.showCopiedState(button);
              }).catch(() => {
                this.fallbackCopy(code, button);
              });
            } else {
              this.fallbackCopy(code, button);
            }
          });
        });
      }

      fallbackCopy(text, button) {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        
        try {
          document.execCommand('copy');
          this.showCopiedState(button);
        } catch (err) {
          console.error('Failed to copy:', err);
        }
        
        document.body.removeChild(textArea);
      }

      showCopiedState(button) {
        const originalText = button.textContent;
        button.textContent = 'Copied!';
        button.classList.add('copied');
        
        setTimeout(() => {
          button.textContent = originalText;
          button.classList.remove('copied');
        }, 2000);
      }
    }

    customElements.define('promo-section-{{ ai_gen_id }}', PromoSection{{ ai_gen_id }});
  })();
</script>

