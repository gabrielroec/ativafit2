    {% if block.settings.show_products %}
      <div class="ai-promo-products-section-{{ ai_gen_id }}">
        {% if block.settings.products_title != blank %}
          <h3 class="ai-promo-products-title-{{ ai_gen_id }}">{{ block.settings.products_title }}</h3>
        {% endif %}

