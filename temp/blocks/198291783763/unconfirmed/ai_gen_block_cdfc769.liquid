              <button class="ai-promo-copy-button-{{ ai_gen_id }}" data-code="{{ block.settings.tier1_code }}">
                Copy Code
              </button>
            </div>
          {% endif %}

          {% if block.settings.tier2_enabled %}
            <div class="ai-promo-code-card-{{ ai_gen_id }}">
