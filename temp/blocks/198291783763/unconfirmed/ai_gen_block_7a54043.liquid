            <div class="ai-ticket-dashed-line-{{ ai_gen_id }}"></div>
            
            <div class="ai-ticket-top-section-{{ ai_gen_id }}">
              <div class="ai-ticket-label-{{ ai_gen_id }}">{{ block.settings.tier2_label }}</div>
              <div class="ai-ticket-code-value-{{ ai_gen_id }}">{{ block.settings.tier2_code }}</div>
              <div class="ai-ticket-description-{{ ai_gen_id }}">{{ block.settings.tier2_description }}</div>
            </div>
            
            <div class="ai-ticket-bottom-section-{{ ai_gen_id }}">
              <button class="ai-ticket-copy-button-{{ ai_gen_id }}" data-code="{{ block.settings.tier2_code }}">
                Copy Code
              </button>
            </div>
          </div>
        {% endif %}

        {% if block.settings.tier3_enabled %}
          <div class="ai-ticket-card-{{ ai_gen_id }}">
            <div class="ai-ticket-notch-left-{{ ai_gen_id }}"></div>
            <div class="ai-ticket-notch-right-{{ ai_gen_id }}"></div>
            <div class="ai-ticket-dashed-line-{{ ai_gen_id }}"></div>
            
            <div class="ai-ticket-top-section-{{ ai_gen_id }}">
              <div class="ai-ticket-label-{{ ai_gen_id }}">{{ block.settings.tier3_label }}</div>
