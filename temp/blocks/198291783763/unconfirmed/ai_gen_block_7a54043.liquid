              <button class="ai-ticket-copy-button-{{ ai_gen_id }}" data-code="{{ block.settings.tier3_code }}">
                Copy Code
              </button>
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-ticket-codes-mobile-{{ ai_gen_id }}">
        <div class="ai-ticket-codes-mobile-track-{{ ai_gen_id }}">
          {% if block.settings.tier1_enabled %}
