<script>
  (function() {
    class TicketPromoSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupCopyButtons();
        this.setupCarouselProgress();
      }

      setupCopyButtons() {
        const buttons = this.querySelectorAll('.ai-ticket-copy-button-{{ ai_gen_id }}');
        
        buttons.forEach(button => {
          button.addEventListener('click', () => {
            const code = button.getAttribute('data-code');
            
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(code).then(() => {
                this.showCopiedState(button);
              }).catch(() => {
                this.fallbackCopy(code, button);
              });
            } else {
              this.fallbackCopy(code, button);
            }
          });
        });
      }

      fallbackCopy(text, button) {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        
        try {
          document.execCommand('copy');
          this.showCopiedState(button);
        } catch (err) {
          console.error('Failed to copy:', err);
        }
        
        document.body.removeChild(textArea);
      }

      showCopiedState(button) {
        const originalText = button.textContent;
        button.textContent = 'Copied!';
        button.classList.add('copied');
        
        setTimeout(() => {
          button.textContent = originalText;
          button.classList.remove('copied');
        }, 2000);
      }

      setupCarouselProgress() {
        const track = this.querySelector('[data-carousel-track]');
        const progressFill = this.querySelector('[data-progress-fill]');
        
        if (!track || !progressFill) return;

        const updateProgress = () => {
          const scrollLeft = track.scrollLeft;
          const scrollWidth = track.scrollWidth - track.clientWidth;
          const scrollPercentage = scrollWidth > 0 ? (scrollLeft / scrollWidth) * 100 : 0;
          progressFill.style.width = scrollPercentage + '%';
        };

        track.addEventListener('scroll', updateProgress);
        updateProgress();
      }
    }

    customElements.define('ticket-promo-section-{{ ai_gen_id }}', TicketPromoSection{{ ai_gen_id }});
  })();
</script>

