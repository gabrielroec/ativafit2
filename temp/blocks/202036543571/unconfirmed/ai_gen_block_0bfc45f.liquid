{% doc %}
  @prompt
    Create a section. The section should display feature icons in a clean horizontal layout with a white background. Each block contains an icon, a heading, and a short description. Place the icon at the top left of the text block, aligned with the headline. Use the Barlow font throughout. Add subtle vertical dividers between items. Make the layout fully responsive (4 columns on desktop, stacked or swipeable on mobile). In the Theme Editor, allow users to adjust icon size, heading font size, description font size, colors, spacing, and padding, and edit the icon, title, and description for each block. Keep the code clean, lightweight, and reusable.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-icon-{{ ai_gen_id }} {
    display: block;
    position: relative;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.background_color }};
    width: 100%;
  }

  .ai-feature-icon-content-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.icon_text_gap }}px;
    align-items: flex-start;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-feature-icon-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-icon-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-feature-icon-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-icon-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-feature-icon-text-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-feature-icon-heading-{{ ai_gen_id }} {
    font-family: 'Barlow', sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
    line-height: 1.3;
  }

  .ai-feature-icon-description-{{ ai_gen_id }} {
    font-family: 'Barlow', sans-serif;
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  {% if block.settings.show_divider %}
    .ai-feature-icon-{{ ai_gen_id }}::after {
      content: '';
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 1px;
      height: {{ block.settings.divider_height }}%;
      background-color: {{ block.settings.divider_color }};
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-feature-icon-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-feature-icon-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }

    .ai-feature-icon-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-feature-icon-{{ ai_gen_id }}::after {
      display: none;
    }
  }
{% endstyle %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600&display=swap" rel="stylesheet">

<feature-icon-{{ ai_gen_id }} class="ai-feature-icon-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-icon-content-{{ ai_gen_id }}">
    <div class="ai-feature-icon-icon-{{ ai_gen_id }}">
      {% if block.settings.icon %}
        <img
          src="{{ block.settings.icon | image_url: width: 200 }}"
          alt="{{ block.settings.icon.alt | escape }}"
          loading="lazy"
          width="200"
          height="200"
        >
      {% else %}
        <div class="ai-feature-icon-icon-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
    <div class="ai-feature-icon-text-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h3 class="ai-feature-icon-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
      {% endif %}
      {% if block.settings.description != blank %}
        <p class="ai-feature-icon-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
      {% endif %}
    </div>
  </div>
</feature-icon-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureIcon{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('feature-icon-{{ ai_gen_id }}', FeatureIcon{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Feature icon",
  "tag": null,
  "class": "feature-icon-block",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feature title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Brief description of this feature"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Icon to text gap",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading bottom margin",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Padding",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#e8e8e8"
    },
    {
      "type": "range",
      "id": "divider_height",
      "label": "Divider height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Feature icon"
    }
  ]
}
{% endschema %}
