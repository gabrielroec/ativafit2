{% doc %}
  @prompt
    Create a section. The section should display feature icons in a clean horizontal layout with a white background. Each block contains an icon, a heading, and a short description. Use the Barlow font throughout. Add subtle vertical dividers between items. Make the layout fully responsive (4 columns on desktop, stacked or swipeable on mobile). In the Theme Editor, allow users to adjust icon size, heading font size, description font size, colors, spacing, padding, and edit the icon, title, and description for each block. Keep the code clean, lightweight, and reusable.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-icons-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-feature-icons-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-feature-icons-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: 0;
  }

  .ai-feature-icons-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: {{ block.settings.item_padding }}px;
    position: relative;
  }

  .ai-feature-icons-item-{{ ai_gen_id }}:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: {{ block.settings.divider_height }}%;
    background-color: {{ block.settings.divider_color }};
  }

  .ai-feature-icons-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    flex-shrink: 0;
  }

  .ai-feature-icons-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-feature-icons-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-feature-icons-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-feature-icons-heading-{{ ai_gen_id }} {
    font-family: 'Barlow', sans-serif;
    font-size: {{ block.settings.heading_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.3;
  }

  .ai-feature-icons-description-{{ ai_gen_id }} {
    font-family: 'Barlow', sans-serif;
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-feature-icons-grid-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'stack' %}
        grid-template-columns: 1fr;
      {% elsif block.settings.mobile_layout == 'two-column' %}
        grid-template-columns: repeat(2, 1fr);
      {% else %}
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        gap: 0;
      {% endif %}
    }

    {% if block.settings.mobile_layout == 'swipe' %}
      .ai-feature-icons-item-{{ ai_gen_id }} {
        min-width: 80%;
        scroll-snap-align: center;
      }
    {% endif %}

    {% if block.settings.mobile_layout == 'stack' %}
      .ai-feature-icons-item-{{ ai_gen_id }}:not(:last-child)::after {
        display: none;
      }
    {% endif %}

    {% if block.settings.mobile_layout == 'two-column' %}
      .ai-feature-icons-item-{{ ai_gen_id }}:nth-child(odd)::after {
        display: block;
      }
      .ai-feature-icons-item-{{ ai_gen_id }}:nth-child(even)::after {
        display: none;
      }
    {% endif %}

    .ai-feature-icons-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px {{ block.settings.section_padding_horizontal | times: 0.6 }}px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-feature-icons-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-feature-icons-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.9 }}px;
    }

    .ai-feature-icons-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<feature-icons-{{ ai_gen_id }} class="ai-feature-icons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-icons-container-{{ ai_gen_id }}">
    <div class="ai-feature-icons-grid-{{ ai_gen_id }}">
      <div class="ai-feature-icons-item-{{ ai_gen_id }}">
        <div class="ai-feature-icons-icon-{{ ai_gen_id }}">
          {% if block.settings.icon_1 %}
            <img
              src="{{ block.settings.icon_1 | image_url: width: 200 }}"
              alt="{{ block.settings.icon_1.alt | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-feature-icons-icon-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        {% if block.settings.heading_1 != blank %}
          <h3 class="ai-feature-icons-heading-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h3>
        {% endif %}
        {% if block.settings.description_1 != blank %}
          <p class="ai-feature-icons-description-{{ ai_gen_id }}">{{ block.settings.description_1 }}</p>
        {% endif %}
      </div>

      <div class="ai-feature-icons-item-{{ ai_gen_id }}">
        <div class="ai-feature-icons-icon-{{ ai_gen_id }}">
          {% if block.settings.icon_2 %}
            <img
              src="{{ block.settings.icon_2 | image_url: width: 200 }}"
              alt="{{ block.settings.icon_2.alt | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-feature-icons-icon-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        {% if block.settings.heading_2 != blank %}
          <h3 class="ai-feature-icons-heading-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h3>
        {% endif %}
        {% if block.settings.description_2 != blank %}
          <p class="ai-feature-icons-description-{{ ai_gen_id }}">{{ block.settings.description_2 }}</p>
        {% endif %}
      </div>

      <div class="ai-feature-icons-item-{{ ai_gen_id }}">
        <div class="ai-feature-icons-icon-{{ ai_gen_id }}">
          {% if block.settings.icon_3 %}
            <img
              src="{{ block.settings.icon_3 | image_url: width: 200 }}"
              alt="{{ block.settings.icon_3.alt | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-feature-icons-icon-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        {% if block.settings.heading_3 != blank %}
          <h3 class="ai-feature-icons-heading-{{ ai_gen_id }}">{{ block.settings.heading_3 }}</h3>
        {% endif %}
        {% if block.settings.description_3 != blank %}
          <p class="ai-feature-icons-description-{{ ai_gen_id }}">{{ block.settings.description_3 }}</p>
        {% endif %}
      </div>

      <div class="ai-feature-icons-item-{{ ai_gen_id }}">
        <div class="ai-feature-icons-icon-{{ ai_gen_id }}">
          {% if block.settings.icon_4 %}
            <img
              src="{{ block.settings.icon_4 | image_url: width: 200 }}"
              alt="{{ block.settings.icon_4.alt | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-feature-icons-icon-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        {% if block.settings.heading_4 != blank %}
          <h3 class="ai-feature-icons-heading-{{ ai_gen_id }}">{{ block.settings.heading_4 }}</h3>
        {% endif %}
        {% if block.settings.description_4 != blank %}
          <p class="ai-feature-icons-description-{{ ai_gen_id }}">{{ block.settings.description_4 }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</feature-icons-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureIcons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupSwipeIndicator();
      }

      setupSwipeIndicator() {
        const grid = this.querySelector('.ai-feature-icons-grid-{{ ai_gen_id }}');
        if (!grid) return;

        const isMobile = window.matchMedia('(max-width: 749px)').matches;
        const isSwipeLayout = '{{ block.settings.mobile_layout }}' === 'swipe';

        if (isMobile && isSwipeLayout) {
          grid.addEventListener('scroll', () => {
            const scrollLeft = grid.scrollLeft;
            const scrollWidth = grid.scrollWidth;
            const clientWidth = grid.clientWidth;
          });
        }
      }
    }

    customElements.define('feature-icons-{{ ai_gen_id }}', FeatureIcons{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Feature icons",
  "tag": null,
  "class": "feature-icons-block",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "stack",
          "label": "Stack"
        },
        {
          "value": "two-column",
          "label": "Two columns"
        },
        {
          "value": "swipe",
