    "product_features": {
      "type": "product-features",
      "blocks": {
        "feature_space_saving": {
          "type": "feature",
          "settings": {
            "feature_image": "shopify://shop_images/Riding_Ativafit_F8_exercise_bike.webp",
            "image_position": "left",
            "feature_title": "Compact Folding Design\n<high> for Small Home Spaces</high>",
            "feature_text": "The Sprint F8 is a compact foldable exercise bike designed for real home spaces, including apartments, bedrooms, home offices, and shared living rooms. Its folding frame helps you ride when you want to move, then store the bike away when your workout is done.\n\nWhy it matters: If you want an exercise bike for home cardio but do not have space for bulky gym equipment, the Sprint F8 gives you a practical way to keep your workout routine accessible without taking over your room."
          }
        },
        "feature_glide_tech": {
          "type": "feature",
          "settings": {
            "feature_image": "shopify://shop_images/8_ef944928-6f9e-43e8-8312-6d1b8cea5656.jpg",
            "image_position": "right",
            "feature_title": "<high>8-Level Magnetic Resistance</high>\n for Simple Daily Cardio",
            "feature_text": "This folding magnetic exercise bike features 8 levels of resistance, making it easy to start light and adjust your ride as your routine improves. Beginners can use lower resistance for comfortable seated rides, while everyday users can increase the level for a more challenging home cardio session.\n\nWhy it matters: You get a simple, beginner-friendly way to build consistency without complicated controls, connected apps, or loud workout equipment."
          }
        },
        "feature_xzh8yR": {
          "type": "feature",
          "settings": {
            "feature_image": "shopify://shop_images/F8FoldableExerciseBikew.HealthMonitor-Ativafit_5.png",
            "image_position": "left",
            "feature_title": "<high>Digital Monitor </high>for Easy Workout Trackinge",
            "feature_text": "The Sprint F8 includes a front digital monitor that helps you follow key workout data, including time, speed, distance, calories, and pulse for general workout tracking. This gives you a quick view of your ride without needing a subscription, large touchscreen, or separate fitness app.\n\nWhy it matters: You can monitor the basics of your indoor cycling routine and stay focused on steady progress during daily rides."
          }
        },
        "feature_ggmWHm": {
          "type": "feature",
          "settings": {
            "feature_image": "shopify://shop_images/10ac1ebc5fa307e8e452b325d0068751.png",
            "image_position": "right",
            "feature_title": "<high>Adjustable, Easy-to-Use Upright Bike</high> for Everyday Movement",
            "feature_text": "As a foldable upright exercise bike, the Sprint F8 is designed for simple seated cardio. The adjustable seat helps different users find a more comfortable riding position, while the upright frame supports an easy, familiar cycling posture for light-to-moderate workouts.\n\nWhy it matters: The easier your exercise bike is to adjust, ride, move, and store, the more likely it is to become part of your everyday routine."
          }
        }
      },
