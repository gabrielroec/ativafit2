    "faq_accordion": {
      "type": "faq-accordion",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "Q: Is the Sprint F8 a foldable upright exercise bike?",
            "answer": "A:Yes. The Sprint F8 is a foldable upright exercise bike designed for simple home cardio, small spaces, and seated indoor cycling. Its folding frame and transport wheels make it easier to store after your workout."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Q: Who is the Sprint F8 best suited for?",
            "answer": "A: The Sprint F8 is best suited for beginners, small-space users, and people who want light-to-moderate cardio at home. It is a practical choice for apartments, bedrooms, home offices, and shared living spaces."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "Q: How many resistance levels does the Sprint F8 have?",
            "answer": "A: The Sprint F8 has 8 levels of magnetic resistance. You can start with a lighter setting for easy rides and increase the resistance as your home cardio routine becomes more consistent."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Q: Is the Sprint F8 good for small apartments?",
            "answer": "A: Yes. The Sprint F8 is a compact foldable exercise bike made for small home spaces. After riding, you can fold the frame and use the built-in transport wheels to move it into a storage area."
          }
        },
        "faq_item_QpBaMX": {
          "type": "faq_item",
