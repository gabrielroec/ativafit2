    "faq_accordion": {
      "type": "faq-accordion",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "How do the 27.5 lbs adjustable dumbbells work?",
            "answer": "Our  27.5 lb adjustable dumbbells let you change weights in seconds using a smooth-glide adjustment system. Simply slide the dial to select from 5.5, 11, 16.5, 22, or 27.5 lbs (2.5, 5, 7.5, 10, 12.5 kg),, no need for multiple dumbbells cluttering your space."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Are these adjustable dumbbells suitable for beginners?",
            "answer": "Yes! With 5 weight levels starting at just 5.5 lbs (2.5 kg), these Ativafit adjustable dumbbells are perfect for beginners, intermediate lifters, and anyone looking to progress at their own pace. The light weight range makes it ideal for learning proper form."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "What's the size of the 27.5 lbs adjustable dumbbells?",
            "answer": "Each dumbbell measures just 13.39\" D × 7.87\" W × 5.91\" H — about the size of a shoebox — making them ideal for small spaces, apartments, or home gyms."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Do the dumbbells come as a pair or single?",
            "answer": "They are sold as a pair, so you get 27.5 lbs per dumbbell, allowing you to perform balanced, full-body workouts right out of the box."
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "What exercises can I do with 27.5 lbs adjustable dumbbells?",
            "answer": "You can target your arms, shoulders, back, chest, and legs with the complete weight range from 5.5 to 27.5 lbs (2.5-12.5 kg). Popular exercises include bicep curls, shoulder presses, chest presses, lunges, squats, and rows. The 5.5 lb increments let you progress gradually as you build strength."
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "question": "Do the dumbbells come with a warranty?",
            "answer": "Yes. We offer a standard one-year warranty, plus an extra year when you sign up for our Ativa People program."
          }
        }
      },
      "block_order": [
        "faq_1",
        "faq_2",
