    "faq_accordion": {
      "type": "faq-accordion",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "Are 25 lb adjustable dumbbells enough for beginners?",
            "answer": "Yes. A 25 lb adjustable dumbbell set is a practical starting point for beginners, women, and home workout users. The Ativafit Spark adjusts from 5 to 25 lbs, so you can start light and gradually increase resistance as you build strength."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Are Ativafit Spark adjustable dumbbells good for women?",
            "answer": "Yes. Spark is designed for toning, light strength training, Pilates support, HIIT circuits, and everyday home workouts. The compact design and 5–25 lb weight range make it a good choice for women who want adjustable dumbbells without bulky gym equipment."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "Do the Ativafit Spark dumbbells come as a pair?",
            "answer": "Yes. The Ativafit Spark 25 lb adjustable dumbbell set includes 2 adjustable dumbbells, 2 trays, and 1 workout guide. Each dumbbell adjusts from 5 to 25 lbs."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "How fast can I change the weight?",
            "answer": "You can switch weights in seconds while the dumbbell is securely placed on the tray. The quick adjustment system helps you move smoothly between exercises without stopping to change plates manually."
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "What exercises can I do with 25 lb adjustable dumbbells?",
            "answer": "You can use Spark for bicep curls, tricep extensions, shoulder presses, rows, chest presses, squats, lunges, Romanian deadlifts, Russian twists, and other full-body home workouts."
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "question": "Are these compact adjustable dumbbells good for small spaces?",
            "answer": "Yes. Spark replaces 5 pairs of traditional dumbbells, helping you save space in bedrooms, apartments, small home gyms, and workout corners. The included trays also help keep your setup organized."
          }
        },
        "faq_item_4gaAei": {
          "type": "faq_item",
          "settings": {
            "question": "What weight levels are included?",
            "answer": "Each dumbbell adjusts across 5 weight levels: 5, 10, 15, 20, and 25 lbs. This makes it easy to move between lighter toning exercises and more challenging strength training movements."
          }
        },
        "faq_item_gicqyf": {
          "type": "faq_item",
          "settings": {
            "question": "What is the difference between 25 lb, 50 lb, 66 lb, and 88 lb Ativafit adjustable dumbbells?",
            "answer": "The Spark 25 lb set is best for women, beginners, toning, and light strength training. The 50 lb model is better for general full-body strength training, while the 66 lb and 88 lb models are designed for heavier lifting and progressive strength training."
          }
        }
      },
