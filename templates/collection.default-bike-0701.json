    "faq_accordion_bike": {
      "type": "faq-accordion",
      "blocks": {
        "faq_item_FnUALR": {
          "type": "faq_item",
          "settings": {
            "question": "What is the best foldable exercise bike for small spaces?",
            "answer": "The F8 is the most compact Ativafit folding exercise bike for apartments and small rooms. The F8 Pro is a compact upgrade with more resistance levels, while the R8 is the comfort-focused option with back support and semi-recumbent riding."
          }
        },
        "faq_item_XMBiae": {
          "type": "faq_item",
          "settings": {
            "question": "Is a folding exercise bike good for home workouts?",
            "answer": "Yes. A folding exercise bike for home is a practical choice for low-impact cardio, daily movement, and small-space routines. Ativafit bikes use adjustable magnetic resistance so you can keep rides light, steady, or more challenging based on your fitness level."
          }
        },
        "faq_item_WVYipU": {
          "type": "faq_item",
          "settings": {
            "question": "What is the difference between a foldable exercise bike and a folding stationary bike?",
            "answer": "Most shoppers use these terms for the same product category: a stationary exercise bike that folds for storage. Ativafit offers foldable stationary bike options for users who want quiet home cardio without keeping a full-size machine out all day."
          }
        },
        "faq_item_77PGzK": {
          "type": "faq_item",
          "settings": {
            "question": "Which Ativafit foldable exercise bike is best for seniors?",
            "answer": "The R8 is the comfort-focused Ativafit stationary bike. It offers upright and semi-recumbent riding positions, a supportive backrest, and resistance bands. It can be a good fit for many riders who prefer a lower-impact ride, but anyone with medical concerns should ask a qualified professional before starting a new routine."
          }
        },
        "faq_item_mmxVTU": {
          "type": "faq_item",
          "settings": {
            "question": "Can a fold up exercise bike fit in an apartment?",
            "answer": "Yes. A fold up exercise bike can work well in an apartment when you choose by folded footprint, moving ease, and storage location. Choose the F8 for the smallest footprint, or choose the R8 if comfort and back support matter more than the smallest size."
          }
        },
        "faq_item_warranty_0701": {
          "type": "faq_item",
          "settings": {
            "question": "Do Ativafit folding exercise bikes come with a warranty?",
            "answer": "Yes. Ativafit folding exercise bikes include a standard one-year warranty. Free U.S. shipping and 30-day returns may also apply based on the current store policy and shipping destination."
          }
        }
      },
