    "faq_accordion": {
      "type": "faq-accordion",
      "blocks": {
        "faq_item_4c6qHP": {
          "type": "faq_item",
          "settings": {
            "question": "Are 50 lb adjustable dumbbells enough for home strength training?",
            "answer": "Yes. A 50 lb adjustable dumbbell set is enough for many home strength training routines, including curls, rows, chest presses, shoulder presses, squats, lunges, and Romanian deadlifts. The Ativafit Martian adjusts from 5 to 50 lbs, so you can start light and increase weight as you progress."
          }
        },
        "faq_item_cYCLcB": {
          "type": "faq_item",
          "settings": {
            "question": "Do the Ativafit Martian dumbbells come as a pair?",
            "answer": "Yes. The Ativafit Martian 50 lb adjustable dumbbell set comes as an adjustable dumbbell pair. It is designed to replace multiple fixed dumbbells while giving you a cleaner, more space-saving home gym setup."
          }
        },
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "What weight range does each dumbbell offer?",
            "answer": "Each Martian dumbbell adjusts from 5 to 50 lbs. This 5–50 lb adjustable weight range gives you enough flexibility for warm-ups, isolation exercises, full-body workouts, and progressive strength training at home."
          }
        },
        "faq_item_4aFNEM": {
          "type": "faq_item",
          "settings": {
            "question": "How fast can I change the weight?",
            "answer": "You can change weights in seconds with the quick dial adjustment system. These quick adjustable dumbbells help you move smoothly between exercises without changing plates or grabbing another pair of fixed weights."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Are these adjustable dumbbells good for a home gym?",
            "answer": "Yes. Martian is a strong choice for home gym users because it combines a 50 lb weight range, compact storage, quick adjustment, and full-body training flexibility. It is especially useful if you want strength training equipment without a full rack of fixed dumbbells."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "Are the Ativafit adjustable dumbbells durable enough for daily strength training?",
            "answer": "Absolutely. The Martian is built for the \"Daily Lifter.\" It features a 10-point safety locking system and reinforced steel plates, ensuring that your ativafit adjustable dumbbells remain secure and stable through years of repeat use. The ergonomic rubber grip also ensures comfort during those intense, everyday sessions."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "What exercises can I do with 50 lb adjustable dumbbells?",
            "answer": "You can use 50 lb adjustable dumbbells for bicep curls, hammer curls, tricep extensions, shoulder presses, chest presses, dumbbell rows, squats, lunges, Romanian deadlifts, core work, and full-body strength circuits."
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "question": "How much space can I save with this adjustable dumbbell set?",
            "answer": "The Ativafit Martian 50 lb adjustable dumbbell set replaces 10 pairs of fixed weights, helping you save space in apartments, garage gyms, spare rooms, and compact workout areas. It gives you a wide training range without needing a full dumbbell rack."
          }
        },
        "faq_item_PLdMQT": {
          "type": "faq_item",
          "settings": {
            "question": "Are adjustable dumbbells better than fixed dumbbells?",
            "answer": "Adjustable dumbbells are better for users who want to save space and train with multiple weight levels at home. Fixed dumbbells can be convenient in large gyms, but an adjustable dumbbell set is usually more practical for home gyms, small spaces, and full-body workouts."
          }
        },
        "faq_item_ReXNry": {
          "type": "faq_item",
          "settings": {
            "question": "Does Martian have a safety locking system?",
            "answer": "Yes. Martian is designed with a safety locking system that helps keep weight changes controlled when the dumbbell is properly docked. A safety indicator button gives a clear signal when the selected weight is locked and ready to lift."
          }
        }
      },
