    "product_features": {
      "type": "product-features",
      "blocks": {
        "feature_glide_tech": {
          "type": "feature",
          "settings": {
            "feature_image": "shopify://shop_images/3_d28427db-527e-4e3b-adde-169867c216e6.webp",
            "image_position": "left",
            "feature_title": "<high>Stable Upright Ride </high>\nfor Daily Use",
            "feature_text": "As a foldable upright exercise bike, the Rush F8 Pro supports steady seated cardio with an upright frame, adjustable seat, and quiet magnetic resistance. It is built for daily home workouts, not studio-style standing sprints.\n\nWhy it matters: The Rush F8 Pro is not a studio-style spin bike for standing sprints. It is a space-saving stationary bike for users who want a stable, simple, and repeatable home cardio routine."
          }
        },
        "feature_space_saving": {
          "type": "feature",
          "settings": {
            "feature_image": "shopify://shop_images/1_51576cdc-0c38-4c55-bbbd-372a455a65c4.webp",
            "image_position": "right",
            "feature_title": "<high>16-Level Magnetic Resistance </high>\nfor Better Ride Control",
            "feature_text": "The Rush F8 Pro gives you 16 levels of magnetic resistance, so you can start light, ride steadily, or increase the challenge as your routine improves. The manual resistance knob keeps every adjustment simple and easy to control.\n\nWhy it matters: If you are deciding between the Sprint F8 and Rush F8 Pro, the Rush F8 Pro gives you finer resistance adjustment, making it a better fit for users who want more room to progress."
          }
        },
        "feature_FjjXD6": {
          "type": "feature",
          "settings": {
            "feature_image": "shopify://shop_images/2_1806d35e-398a-4814-9bbd-041d7872a177.webp",
            "image_position": "left",
            "feature_title": "<high>Compact Folding Frame</high>\nfor Small-Space Workouts",
            "feature_text": "This compact folding stationary exercise bike is designed for apartments, bedrooms, home offices, and shared living spaces. After your ride, fold the frame and use the transport wheels to move it away more easily.\n\nWhy it matters: You do not need a dedicated home gym to build a cardio routine. The Rush F8 Pro gives you a practical exercise bike for home workouts while keeping your space flexible."
          }
        },
        "feature_KbhVFU": {
          "type": "feature",
          "settings": {
            "image_position": "right",
            "feature_title": "<high>Digital Monitor and Phone Holder</high>\nfor Easier Routine Building",
            "feature_text": "The digital monitor helps you track time, speed, distance, and heart rate for general workout tracking. The built-in phone holder keeps your device nearby for music, videos, or simple workout guidance.\n\nWhy it matters: Simple tracking and phone access can make daily rides easier to repeat, especially if you like to multitask during steady seated cardio."
          }
        }
      },
