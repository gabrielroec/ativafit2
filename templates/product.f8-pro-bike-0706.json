    "faq_accordion": {
      "type": "faq-accordion",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "1. Is the Rush F8 Pro a folding magnetic upright exercise bike?",
            "answer": "Yes. The Rush F8 Pro is a folding magnetic upright exercise bike designed for seated home cardio, small-space storage, and adjustable daily workouts. It uses magnetic resistance and an upright riding position for simple indoor cycling at home."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "2. Who is the Rush F8 Pro best suited for?",
            "answer": "The Rush F8 Pro is best suited for beginners, small-space users, daily cardio riders, and people who want more resistance control than a basic foldable exercise bike. It is a practical choice for apartments, bedrooms, home offices, and shared living spaces."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "3. How many resistance levels does the Rush F8 Pro have?",
            "answer": "The Rush F8 Pro has 16 levels of magnetic resistance. This gives users finer control than an 8-level bike, making it easier to adjust each ride for warmups, steady cardio, or more challenging home workouts."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "4. Is the Rush F8 Pro good for small spaces?",
            "answer": "Yes. The Rush F8 Pro is a compact folding stationary exercise bike made for small home spaces. Its foldable frame and transport wheels make it easier to move and store after use, especially in apartments, bedrooms, and multi-use rooms."
          }
        },
        "faq_5": {
          "type": "faq_item",
