        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "What is the maximum weight capacity?",
            "answer": "The Ativafit R8 Foldable Exercise Bike supports up to 250 lbs, ensuring stability for a wide range of users."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use this bike for upper body exercises?",
            "answer": "Yes! The Ativafit bike R8 is designed for maximum efficiency. It features dual-action handles and integrated resistance bands, allowing you to engage your upper body while cycling. This total-body engagement is one of the key stationary bike benefits, helping you burn more calories and making it the ideal stationary bike exercise for weight loss.\""
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "How do I store the bike?",
            "answer": "The bike easily folds up, making it perfect for storage in tight spaces."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Does the bike track my exercise performance?",
            "answer": "Absolutely. Every Ativafit bike R8 includes a digital performance tracker. You can easily monitor your time, distance, and calories burned at a glance. This allows you to fine-tune your stationary bike exercises to lose weight and ensure you’re hitting the right intensity for peak stationary bike benefits."
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "Is there a backrest on this bike?",
            "answer": "Yes, the bike features a backrest, providing extra comfort during upper body exercises or when you need a rest."
          }
        }
      },
