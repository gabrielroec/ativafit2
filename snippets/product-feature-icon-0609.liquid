{%- liquid
  assign icon_name = icon | default: 'shipping'
-%}

{%- case icon_name -%}
  {%- when 'dumbbell' -%}
    <svg aria-hidden="true" viewBox="0 0 48 48"><path d="M12 18v12M18 12v24M30 12v24M36 18v12M6 24h36" fill="none" stroke="currentColor" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'home' -%}
    <svg aria-hidden="true" viewBox="0 0 48 48"><path d="M8 24 24 10l16 14v18H13V24m11 18V30h8v12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'beginner' -%}
    <svg aria-hidden="true" viewBox="0 0 48 48"><path d="M24 10a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0 10v9m0-5-8 6m8-6 8 6m-8-1-5 11m5-11 5 11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'change' -%}
    <svg aria-hidden="true" viewBox="0 0 48 48"><path d="M15 15h18m-5-5 5 5-5 5M33 33H15m5 5-5-5 5-5M18 23h12v2H18z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'secure' -%}
    <svg aria-hidden="true" viewBox="0 0 48 48"><path d="M14 21v-6a10 10 0 0 1 20 0v6m-25 0h30v21H9V21Zm10 10 4 4 8-9" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- else -%}
    <svg aria-hidden="true" viewBox="0 0 48 48"><path d="M4 14h26v20H4V14Zm26 7h7l7 8v5H30V21ZM10 34a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm27 0a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM14 20H7m7 6H7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcase -%}
