    </svg>
  {%- when 'back' -%}
    <svg class="spark-workout-ideas__icon" aria-hidden="true" viewBox="0 0 96 96">
      <path d="M48 18v56M28 27c-8 8-12 17-12 29M68 27c8 8 12 17 12 29M43 35c-8 5-14 13-18 24M53 35c8 5 14 13 18 24M39 52c-8 2-15 7-21 15M57 52c8 2 15 7 21 15" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
