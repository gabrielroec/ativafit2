{% comment %}
  Product buy box for product-mian-section-0609.
  Keeps the existing product gallery and cart JS, but renders the right column
  as a compact PDP buy box.
{% endcomment %}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign ativapeople_display_cents = 0
  assign ap_mf_fixed = false
  assign ap_flex_text = ''
  assign ap_flex_price_token = ''
  assign product_form_id = 'product-form-' | append: section.id
  assign payment_options_block = section.blocks | where: 'type', 'payment_options' | first
  assign reviews_block = section.blocks | where: 'type', 'reviews' | first
  assign trust_blocks = section.blocks | where: 'type', 'trust_item'
  assign variant_option_index = 0
  assign variant_option_name = ''
  assign requested_variant_option_name = section.settings.variant_option_name | strip | downcase

  if requested_variant_option_name != blank
    for option in product.options_with_values
      assign option_name_downcase = option.name | strip | downcase
      if option_name_downcase == requested_variant_option_name
        assign variant_option_index = forloop.index0
        assign variant_option_name = option.name
        break
      endif
    endfor
  endif

  if variant_option_name == blank
    for option in product.options_with_values
      assign option_name_downcase = option.name | downcase
      if option_name_downcase contains 'color' or option_name_downcase contains 'colour'
        assign variant_option_index = forloop.index0
        assign variant_option_name = option.name
        break
      endif
    endfor
  endif

  if variant_option_name == blank
    for option in product.options_with_values
      assign variant_option_index = forloop.index0
      assign variant_option_name = option.name
      break
    endfor
  endif

  assign selected_option_value = selected_variant.options[variant_option_index] | default: selected_variant.title

  assign mf_v_num = selected_variant.metafields.custom.price_discount_ativapeople
  assign mf_p_num = product.metafields.custom.price_discount_ativapeople
  assign mf_v_txt = selected_variant.metafields.custom.price_text_discount_ativapeople
  assign mf_p_txt = product.metafields.custom.price_text_discount_ativapeople
  assign mf_use = blank
  assign member_price_source_text = ''
  if mf_v_txt != blank and mf_v_txt.value != blank
    assign mf_use = mf_v_txt
  elsif mf_p_txt != blank and mf_p_txt.value != blank
    assign mf_use = mf_p_txt
  elsif mf_v_num != blank and mf_v_num.value != blank
    assign mf_use = mf_v_num
  elsif mf_p_num != blank and mf_p_num.value != blank
    assign mf_use = mf_p_num
  endif
  if mf_use != blank and mf_use.value != blank
    if mf_use.value.amount != blank
      assign member_price_source_text = mf_use.value.amount | append: '' | strip
    else
      assign member_price_source_text = mf_use.value | append: '' | strip
    endif
  elsif section.settings.member_price_text != blank
    assign member_price_source_text = section.settings.member_price_text | append: '' | strip
  endif
  if member_price_source_text == blank and product.handle == '25-lbs-adjustable-weight-dumbbell'
    assign member_price_source_text = 'Member Price $165.99 + 2-Year Warranty'
  endif
  if member_price_source_text != blank
    assign ap_mf_fixed = true
    assign _raw = member_price_source_text
    if _raw contains '$'
      assign ap_flex_text = _raw
      assign _words = _raw | split: ' '
      for _w in _words
        if _w contains '$' and ap_flex_price_token == ''
          assign ap_flex_price_token = _w
        endif
      endfor
      if ap_flex_price_token != ''
        assign _raw = ap_flex_price_token | replace: '$', ''
      endif
    endif
    assign _raw = _raw | replace: ' ', '' | replace: ' ', '' | replace: "'", ''
    if _raw contains ','
      assign _pa = _raw | split: ','
      if _pa.size == 2
        assign _L = _pa[0] | strip
        assign _R = _pa[1] | strip
        assign _rL = _R | size
        if _rL == 1 or _rL == 2
          assign _L = _L | replace: '.', ''
          assign _raw = _L | append: '.' | append: _R
        elsif _rL == 3
          if _L contains '.'
            assign _L = _L | replace: '.', ''
            assign _raw = _L | append: '.' | append: _R
          else
            assign _raw = _L | append: _R
          endif
        else
          assign _L = _L | replace: '.', ''
          assign _raw = _L | append: '.' | append: _R
        endif
      else
        assign _raw = _raw | replace: '.', '' | replace: ',', '.'
      endif
    endif
    assign _u = _raw | plus: 0.0
    assign ativapeople_display_cents = _u | times: 100 | round
  endif
  if ativapeople_display_cents < 0
    assign ativapeople_display_cents = 0
  endif
  assign should_render_member_price_line = false
  if ap_mf_fixed
    if ativapeople_display_cents > 0 or ap_flex_text != ''
      assign should_render_member_price_line = true
    endif
  endif

  assign discount_percent = 0
  if selected_variant.compare_at_price > selected_variant.price and selected_variant.compare_at_price > 0
    assign discount_cents = selected_variant.compare_at_price | minus: selected_variant.price
    assign discount_percent = discount_cents | times: 100 | divided_by: selected_variant.compare_at_price
  endif
  assign should_show_waitlist = false
  if section.settings.show_waitlist_button
    if section.settings.waitlist_variant_ids == blank
      assign should_show_waitlist = true
    else
      assign selected_variant_id_string = selected_variant.id | append: ''
      assign selected_variant_title = selected_variant.title | strip | downcase
      assign variant_list = section.settings.waitlist_variant_ids | split: ','
      for variant_item in variant_list
        assign variant_item_trimmed = variant_item | strip
        assign variant_item_lower = variant_item_trimmed | downcase
        if variant_item_trimmed == selected_variant_id_string or variant_item_lower == selected_variant_title
          assign should_show_waitlist = true
          break
        endif
      endfor
    endif
  endif
-%}

<div class="product-buybox-0609">
  {%- if reviews_block and reviews_block.settings.enabled -%}
    <a href="#judgeme_product_reviews" class="product-review-0609">
      <span class="product-review-0609__stars" aria-hidden="true">★★★★★</span>
      <span class="product-review-0609__text">{{ reviews_block.settings.review_text | default: '4.95 (215 reviews)' }}</span>
    </a>
  {%- endif -%}

  <h1 class="product-title-0609">
    {%- if section.settings.product_title != blank -%}
      {{ section.settings.product_title }}
    {%- else -%}
      {{ product.title }}
    {%- endif -%}
  </h1>

  {%- if section.settings.product_subtitle != blank -%}
    <p class="product-subtitle-0609">{{ section.settings.product_subtitle }}</p>
  {%- endif -%}

  <div class="product-price-row-0609">
    <span class="product-price_new product-price-0609">{{ selected_variant.price | money }}</span>
    {%- if selected_variant.compare_at_price > selected_variant.price -%}
      <span class="product-price-original_new product-compare-0609">{{ selected_variant.compare_at_price | money }}</span>
      <span class="product-save-badge-0609">{{ section.settings.discount_badge_prefix | default: 'Save' }} {{ discount_percent }}%</span>
    {%- else -%}
      <span class="product-price-original_new product-compare-0609" style="display: none;"></span>
      <span class="product-save-badge-0609" style="display: none;"></span>
    {%- endif -%}
  </div>

  {%- if should_render_member_price_line -%}
    <p class="product-info-member-line_new product-info-member-line-0609">
      {%- if ap_flex_text != '' and ap_flex_price_token != '' -%}
        {%- assign _flex_price_html = '<span class="product-info-member-line__price">' | append: ap_flex_price_token | append: '</span>' -%}
        <span class="product-info-member-line__muted">{{ ap_flex_text | replace: ap_flex_price_token, _flex_price_html }}</span>
      {%- elsif ap_flex_text != '' -%}
        <span class="product-info-member-line__muted">{{ ap_flex_text }}</span>
      {%- else -%}
        <span class="product-info-member-line__muted">Member price </span>
        <span class="product-info-member-line__price">{{ ativapeople_display_cents | money }}</span>
      {%- endif -%}
      <span class="product-info-member-line__muted" aria-hidden="true"> · </span>
      <a href="/pages/membership" class="product-info-member-line__link">Join AtivaPeople</a>
    </p>
  {%- endif -%}

  {%- form 'product', product, id: product_form_id, class: 'product-form_new product-form-0609' -%}
    <input
      type="hidden"
      name="id"
      value="{{ selected_variant.id }}"
      id="product-variant-id-{{ section.id }}">

    {%- if payment_options_block and payment_options_block.settings.show_payment_terms -%}
      <div class="payment-options-form payment-options-0609">
        {{ form | payment_terms }}
      </div>
    {%- endif -%}

    {%- if product.variants.size > 1 and section.settings.show_variant_selector -%}
      <div class="variant-selector-wrapper-0609">
        <label class="variant-label-0609">
          {{ section.settings.variant_label | default: variant_option_name | default: 'Select option' | upcase }}:
          <span data-selected-option-0609>{{ selected_option_value }}</span>
        </label>

        <select
          id="variant-selector_new"
          class="variant-selector-native-0609"
          aria-label="{{ section.settings.variant_label | default: 'Select option' }}"
          onchange="updateVariant()">
          {%- for variant in product.variants -%}
            <option
              value="{{ variant.id }}"
              {% if variant == selected_variant %}selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}>
              {{ variant.title }}{% unless variant.available %} - Sold Out{% endunless %}
            </option>
          {%- endfor -%}
        </select>

        <div class="variant-swatches-0609" role="radiogroup" aria-label="{{ section.settings.variant_label | default: variant_option_name | default: 'Select option' }}">
          {%- for variant in product.variants -%}
            {%- liquid
              assign swatch_label = variant.options[variant_option_index] | default: variant.title
              assign swatch_image = variant.image | default: product.featured_image
            -%}
            <button
              type="button"
              class="variant-swatch-0609{% if variant == selected_variant %} is-active{% endif %}"
              data-variant-id-0609="{{ variant.id }}"
              data-variant-label-0609="{{ swatch_label | escape }}"
              aria-label="{{ swatch_label | escape }}"
              aria-checked="{% if variant == selected_variant %}true{% else %}false{% endif %}"
              role="radio"
              {% unless variant.available %}disabled{% endunless %}>
              {%- if swatch_image -%}
                <span style="background-image: url({{ swatch_image | image_url: width: 96, format: 'webp' }});"></span>
              {%- else -%}
                <span class="variant-swatch-placeholder-0609"></span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_quantity_selector -%}
      <div class="quantity-wrapper-0609">
        <label for="quantity_new" class="quantity-label-0609">{{ section.settings.quantity_label | default: 'Qty' | upcase }}:</label>
        <div class="quantity-selector-0609">
          <button type="button" class="quantity-btn-0609" data-qty-minus-0609 aria-label="Decrease quantity">−</button>
          <input
            type="number"
            id="quantity_new"
            name="quantity"
            value="1"
            min="1"
            class="quantity-input-0609"
            aria-label="Quantity">
          <button type="button" class="quantity-btn-0609" data-qty-plus-0609 aria-label="Increase quantity">+</button>
        </div>
      </div>
    {%- endif -%}

    {%- if selected_variant.available or should_show_waitlist -%}
      {%- if section.settings.show_waitlist_button -%}
        <button
          type="button"
          class="add-to-cart-btn_new add-to-cart-btn-0609 waitlist-btn_new klaviyo_waitlist_trigger"
          data-klaviyo-form-id="{{ section.settings.klaviyo_form_id | escape }}"
          data-variant-id="{{ selected_variant.id }}"
          style="{% unless should_show_waitlist %}display: none;{% endunless %}">
          {{ section.settings.waitlist_button_text | default: 'Notify Me When Available' }}
        </button>
      {%- endif -%}

      <div class="product-actions-row-0609">
        <button
          type="submit"
          name="add"
          class="add-to-cart-btn_new add-to-cart-btn-0609"
          data-variant-id="{{ selected_variant.id }}"
          style="{% if section.settings.show_waitlist_button and should_show_waitlist or selected_variant.available == false %}display: none;{% endif %}">
          <span>{{ section.settings.add_to_cart_text | default: 'Add To Cart' }}</span>
        </button>

        {%- if section.settings.show_buy_it_now and should_show_waitlist == false and selected_variant.available -%}
          <button type="button" class="buy-it-now-btn_new buy-it-now-btn-0609" data-buy-it-now-0609>
            <span>{{ section.settings.buy_it_now_text | default: 'Buy It Now' }}</span>
          </button>
        {%- endif -%}
      </div>

      {%- if payment_options_block and payment_options_block.settings.show_dynamic_checkout and selected_variant.available -%}
        <div
          id="dynamic-checkout-{{ section.id }}"
          class="dynamic-checkout-0609{% if section.settings.remove_shop_pay_button %} hide-shop-pay_new{% endif %}">
          {{ form | payment_button }}
        </div>
      {%- endif -%}
    {%- else -%}
      <button type="button" class="add-to-cart-btn_new add-to-cart-btn-0609" disabled>Sold Out</button>
    {%- endif -%}
  {%- endform -%}

  {% render 'product-pairs-well-with'
    , section: section %}

  {%- if section.settings.show_trust_items and trust_blocks.size > 0 -%}
    <div class="product-trust-row-0609" aria-label="Purchase benefits">
      {%- for block in trust_blocks -%}
        {%- if block.settings.enabled -%}
          <div class="product-trust-item-0609" {{ block.shopify_attributes }}>
            {%- if block.settings.icon_image != blank -%}
              <img
                src="{{ block.settings.icon_image | image_url: width: 96 }}"
                alt=""
                width="48"
                height="48"
                loading="lazy">
            {%- else -%}
              {%- case block.settings.icon_style -%}
                {%- when 'return' -%}
                  <svg aria-hidden="true" viewBox="0 0 48 48">
                    <path d="M13 17a14 14 0 1 1-1.5 15M13 17H6m7 0v7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'lock' -%}
                  <svg aria-hidden="true" viewBox="0 0 48 48">
                    <path d="M14 21v-6a10 10 0 0 1 20 0v6m-25 0h30v21H9V21Zm10 10 4 4 8-9" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'shipping' -%}
                  <svg aria-hidden="true" viewBox="0 0 48 48">
                    <path d="M5 14h25v20H5V14Zm25 7h7l6 7v6H30V21ZM12 38a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm25 0a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM9 20h11m-11 6h8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'support' -%}
                  <svg aria-hidden="true" viewBox="0 0 48 48">
                    <path d="M10 27v-4a14 14 0 0 1 28 0v4M10 27h6v10h-6V27Zm22 0h6v10h-6V27Zm0 10c0 4-3 6-8 6h-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'shop_pay' -%}
                  <svg aria-hidden="true" viewBox="0 0 48 48">
                    <rect x="7" y="12" width="34" height="24" rx="5" fill="none" stroke="currentColor" stroke-width="3"/>
                    <path d="M15 21h6c2 0 3 1 3 2.5S23 26 21 26h-6v-5Zm0 5v6m13-11h7m-7 5h5m-5 5h7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- else -%}
                  <svg aria-hidden="true" viewBox="0 0 48 48">
                    <path d="M24 5 8 11v12c0 10.2 6.8 17.5 16 20 9.2-2.5 16-9.8 16-20V11L24 5Zm-7 20 5 5 10-12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
              {%- endcase -%}
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
