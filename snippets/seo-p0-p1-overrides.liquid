{%- comment -%}
  SEO overrides approved for the 2026-07-17 US GSC P0/P1 rollout.
  Structural-action URLs (301, merge, unpublish, delete) are intentionally excluded.
{%- endcomment -%}
{%- liquid
  assign seo_override_key = request.page_type | append: ':'
  case request.page_type
    when 'article'
      assign seo_article_handle = article.handle | split: '/' | last
      assign seo_override_key = seo_override_key | append: seo_article_handle
    when 'product'
      assign seo_override_key = seo_override_key | append: product.handle
    when 'collection'
      assign seo_override_key = seo_override_key | append: collection.handle
  endcase
-%}
